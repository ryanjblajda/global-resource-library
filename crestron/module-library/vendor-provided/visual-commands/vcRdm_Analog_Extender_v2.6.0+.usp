#INCLUDEPATH "C:\Visual Commands\Visual Commands\VC-RDM\Crestron - Simpl#\Current\bin\Release"
#CATEGORY "46" "Visual Commands" // Custom
#USER_SIMPLSHARP_LIBRARY "VCRDMLib"

#DEFINE_CONSTANT MAXPARAMS 50
#DEFINE_CONSTANT MAXLENGTH 100

ANALOG_INPUT _Skip_, _Skip_, Parameter_Analog_To_RDM[MAXPARAMS];

ANALOG_OUTPUT _Skip_, _Skip_, Parameter_Analog_From_RDM[MAXPARAMS];

INTEGER_PARAMETER Slot;
STRING_PARAMETER ID$[30];
STRING_PARAMETER Analog_Attribute_Settings$[MAXPARAMS][100];

DeviceStatusClass Device; 
integer i, init_done;  
string attrNameAnalog[MAXPARAMS][MAXLENGTH];


#BEGIN_PARAMETER_PROPERTIES Slot
	propDefaultUnit = unitDecimal;
   	propBounds = 1d ,50d;
   	propDefaultValue = 1d;
	propShortDescription = "Slot must match existing Room Slot";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES ID$
	propDefaultValue = "ID";
	propShortDescription = "ID must match existing device ID";    
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Analog_Attribute_Settings$
	propDefaultValue = "Name|Control|Range|EnforceRange";
	propShortDescription = "Name|Control|Range|EnforceRange";    
#END_PARAMETER_PROPERTIES

#ANALOG_SERIAL_EXPAND InputsWithOutputs


function InitialzieAttributes()
{
 	for(i = 1 to MAXPARAMS)
	{ 
		if(len(Analog_Attribute_Settings$[i]) > 2 && Analog_Attribute_Settings$[i] != "Name|Control|Range|EnforceRange")
		{
			attrNameAnalog[i] = Device.AddAnalogAttribute(Analog_Attribute_Settings$[i], itoa(Parameter_Analog_To_RDM[i]));		
		} 
	}
}


CHANGE Parameter_Analog_To_RDM
{
 	if(init_done)
 	{
 		Device.SetAnalogAttribute(attrNameAnalog[getlastmodifiedarrayindex()], Parameter_Analog_To_RDM[getlastmodifiedarrayindex()]);		
 	}
}

EventHandler RDMEventFired(DeviceStatusClass o, RDMEventArgs e)
{
	integer k;
	
	for(k = 1 to MAXPARAMS)
	{
	 	if(e.Type = 2 && attrNameAnalog[k] = e.Key)
	 	{
	 	 	Parameter_Analog_From_RDM[k] = atoi(e.Value);
	 	 	break;
	 	}
	}
}


EventHandler RdmInitDeviceExtendersEventHandler(RDMEventArgs args)
{
  	if(init_done = 0 && MainClass.Initialized)
  	{
	  	//Get Device	  	
	  	if(MainClass.SetDevice(Device, ID$, Slot) = 1)
	  	{	  	
	  		init_done = 1;
	  		InitialzieAttributes();
	 		RegisterEvent(Device, RDMEvent, RDMEventFired);
	 	}
	 	else
	 	{
	 	 	GenerateUserWarning("vcRDM: Could not find device with id %s to extend its analog signals!", ID$);
	 	}
	}

}


function main()
{
 	init_done = 0;
 	waitforinitializationcomplete();
 	delay(500);
	RegisterEvent(MainClass, RdmInitDeviceExtendersEvent, RdmInitDeviceExtendersEventHandler); 	
}
