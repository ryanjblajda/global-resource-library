/*******************************************************************************************
  Event Handlers
  (Uncomment and declare additional event handlers as needed)
*******************************************************************************************/
CHANGE Input_Value_High, Input_Value_Low
{
	LONG_INTEGER valueDescaled;

	valueDescaled = Input_Value_High << 16 | Input_Value_Low;

	Output_Value = (valueDescaled / 10000); 
}                 

