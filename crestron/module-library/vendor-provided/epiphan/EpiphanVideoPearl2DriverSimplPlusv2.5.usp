Push CurrentEventPause
{
	Driver.PauseEvent();
}

Push CurrentEventResume
{
	Driver.ResumeEvent();
}

Push CurrentEventStop
{
	Driver.StopEvent();
}

Push CurrentEventExtend
{
	Driver.ExtendEvent();
}

Change PreviewLayoutOnChannel
{
    Driver.GetLayoutPreview(GetLastModifiedArrayIndex() - 1, PreviewLayoutOnChannel[GetLastModifiedArrayIndex()] - 1);
}

Change RecordingPrefix
{
    Driver.SetRecPrefixAll(RecordingPrefix);
}

CALLBACK FUNCTION SimplChannelRecordingStateUpdate(integer channelIndex, integer state)
{
 	ChannelIsRecording[channelIndex + 1] = state;
}

CALLBACK FUNCTION SimplChannelListUpdate(integer entryCount)
{
	integer i;
	for (i = 1 to entryCount)
	{
 		ChannelName[i] = Driver.Channels[i - 1].Name;
		ChannelIsAvaialble[i] = 1;  
		//ChannelPreviewUrl[i] = Driver.Channels[i - 1].PreviewUrl;  	
	}
	for (i = entryCount + 1 to MAXCHANNELS)
	{
 		ChannelName[i] = "";
		ChannelIsAvaialble[i] = 0; 
		ChannelPreviewUrl[i] = "";
	}

	ChannelCount = entryCount;
}

CALLBACK FUNCTION SimplPublishingStreamTypeUpdate(integer channelIndex, integer publisherIndex, integer type)
{
	switch (publisherIndex)
	{
		case (0): 
		{
			ChannelPublisher1StreamingType[channelIndex + 1] = type;
		}
		case (1): 
		{
			ChannelPublisher2StreamingType[channelIndex + 1] = type;
		}
		case (2): 
		{
			ChannelPublisher3StreamingType[channelIndex + 1] = type;
		}
		case (3): 
		{
			ChannelPublisher4StreamingType[channelIndex + 1] = type;
		}
		case (4): 
		{
			ChannelPublisher5StreamingType[channelIndex + 1] = type;
		}
	}
}

