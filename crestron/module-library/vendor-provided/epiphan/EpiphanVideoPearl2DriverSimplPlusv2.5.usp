Push SetSettingsRTSPStream
{
	if (SelectChannel = 0 || SelectStream = 0)
	{
		ErrorMessage = "Error: Selected Channel or Stream cannot be 0";
	}
	else
	{
		Driver.SettingsRTSPStream(SelectChannel-1, SelectStream-1, RTSPSingleTouch, RTSPURL, RTSPTransport, RTSPUsername, RTSPPassword);
	}
}

Push SetSettingsRTMPStream
{
	if (SelectChannel = 0 || SelectStream = 0)
	{
		ErrorMessage = "Error: Selected Channel or Stream cannot be 0";
	}
	else
	{
		Driver.SettingsRTMPStream(SelectChannel-1, SelectStream-1, RTMPSingleTouch, RTMPURL, RTMPStreamName, RTMPUsername, RTMPPassword);
	}
}

