{
	switch (publisherIndex)
	{
		case (0): 
		{
			ChannelPublisher1StreamingName[channelIndex + 1] = publisherName;
		}
		case (1): 
		{
			ChannelPublisher2StreamingName[channelIndex + 1] = publisherName;
		}
		case (2): 
