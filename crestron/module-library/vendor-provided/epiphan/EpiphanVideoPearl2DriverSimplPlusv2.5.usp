{
	switch (publisherIndex)
	{
		case (0): 
		{
			ChannelPublisher1StreamingState[channelIndex + 1] = state;
		}
		case (1): 
		{
			ChannelPublisher2StreamingState[channelIndex + 1] = state;
		}
		case (2): 
		{
			ChannelPublisher3StreamingState[channelIndex + 1] = state;
		}
		case (3): 
		{
			ChannelPublisher4StreamingState[channelIndex + 1] = state;
		}
		case (4): 
		{
			ChannelPublisher5StreamingState[channelIndex + 1] = state;
		}
	}
}

