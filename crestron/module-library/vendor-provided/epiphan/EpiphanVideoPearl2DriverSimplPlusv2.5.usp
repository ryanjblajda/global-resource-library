}

CALLBACK FUNCTION SimplAllPublishingStateUpdate(integer channelIndex, integer state)
{
	ChannelAllStreamsActive[channelIndex + 1] = state;
}

CALLBACK FUNCTION SimplPublishingListUpdate(integer channelIndex, integer publisherCount)
{
	ChannelPublisher1IsAvailable[channelIndex + 1] = publisherCount > 0;
	ChannelPublisher2IsAvailable[channelIndex + 1] = publisherCount > 1;
	ChannelPublisher3IsAvailable[channelIndex + 1] = publisherCount > 2;
	ChannelPublisher4IsAvailable[channelIndex + 1] = publisherCount > 3;
	ChannelPublisher5IsAvailable[channelIndex + 1] = publisherCount > 4;

	ChannelPublisher1StreamingName[channelIndex + 1] = Driver.Channels[channelIndex].PublisherArray[0].Name;
	ChannelPublisher2StreamingName[channelIndex + 1] = Driver.Channels[channelIndex].PublisherArray[1].Name;
	ChannelPublisher3StreamingName[channelIndex + 1] = Driver.Channels[channelIndex].PublisherArray[2].Name;
	ChannelPublisher4StreamingName[channelIndex + 1] = Driver.Channels[channelIndex].PublisherArray[3].Name;
	ChannelPublisher5StreamingName[channelIndex + 1] = Driver.Channels[channelIndex].PublisherArray[4].Name;

    ChannelPublisher1StreamingType[channelIndex + 1] = Driver.Channels[channelIndex].PublisherArray[0].SimplStreamingType;
    ChannelPublisher2StreamingType[channelIndex + 1] = Driver.Channels[channelIndex].PublisherArray[1].SimplStreamingType;
    ChannelPublisher3StreamingType[channelIndex + 1] = Driver.Channels[channelIndex].PublisherArray[2].SimplStreamingType;
    ChannelPublisher4StreamingType[channelIndex + 1] = Driver.Channels[channelIndex].PublisherArray[3].SimplStreamingType;
    ChannelPublisher5StreamingType[channelIndex + 1] = Driver.Channels[channelIndex].PublisherArray[4].SimplStreamingType;

	ChannelPublisher1StreamingState[channelIndex + 1] = Driver.Channels[channelIndex].PublisherArray[0].SimplStreamingState;
	ChannelPublisher2StreamingState[channelIndex + 1] = Driver.Channels[channelIndex].PublisherArray[1].SimplStreamingState;
	ChannelPublisher3StreamingState[channelIndex + 1] = Driver.Channels[channelIndex].PublisherArray[2].SimplStreamingState;
	ChannelPublisher4StreamingState[channelIndex + 1] = Driver.Channels[channelIndex].PublisherArray[3].SimplStreamingState;
	ChannelPublisher5StreamingState[channelIndex + 1] = Driver.Channels[channelIndex].PublisherArray[4].SimplStreamingState;

	ChannelPublisherCount[channelIndex + 1] = publisherCount;
}

CALLBACK FUNCTION SimplChannelNameUpdate(integer channelIndex, string channelNameS)
{
	ChannelName[channelIndex + 1] = channelNameS;
}

CALLBACK FUNCTION SimplLayoutListUpdate(integer channelIndex, integer layoutCount)
{
	ChannelLayout1IsAvailable[channelIndex + 1] = layoutCount > 0;
	ChannelLayout2IsAvailable[channelIndex + 1] = layoutCount > 1;
	ChannelLayout3IsAvailable[channelIndex + 1] = layoutCount > 2;
	ChannelLayout4IsAvailable[channelIndex + 1] = layoutCount > 3;
	ChannelLayout5IsAvailable[channelIndex + 1] = layoutCount > 4;
	ChannelLayout6IsAvailable[channelIndex + 1] = layoutCount > 5;
	ChannelLayout7IsAvailable[channelIndex + 1] = layoutCount > 6;
	ChannelLayout8IsAvailable[channelIndex + 1] = layoutCount > 7;
	ChannelLayout9IsAvailable[channelIndex + 1] = layoutCount > 8;
	ChannelLayout10IsAvailable[channelIndex + 1] = layoutCount > 9;
		
	if (layoutCount > 0)
	{
    	ChannelLayout1Name[channelIndex + 1] = Driver.Channels[channelIndex].LayoutArray[0].Name;
		ChannelLayout1IsActive[channelIndex + 1] = Driver.Channels[channelIndex].LayoutArray[0].SimplIsActive;
	}

	if (layoutCount > 1)
	{
    	ChannelLayout2Name[channelIndex + 1] = Driver.Channels[channelIndex].LayoutArray[1].Name;
		ChannelLayout2IsActive[channelIndex + 1] = Driver.Channels[channelIndex].LayoutArray[1].SimplIsActive;
	}

	if (layoutCount > 2)
	{
    	ChannelLayout3Name[channelIndex + 1] = Driver.Channels[channelIndex].LayoutArray[2].Name;
		ChannelLayout3IsActive[channelIndex + 1] = Driver.Channels[channelIndex].LayoutArray[2].SimplIsActive;
	}

	if (layoutCount > 3)
	{
    	ChannelLayout4Name[channelIndex + 1] = Driver.Channels[channelIndex].LayoutArray[3].Name;
		ChannelLayout4IsActive[channelIndex + 1] = Driver.Channels[channelIndex].LayoutArray[3].SimplIsActive;
	}

	if (layoutCount > 4)
	{
    	ChannelLayout5Name[channelIndex + 1] = Driver.Channels[channelIndex].LayoutArray[4].Name;
		ChannelLayout5IsActive[channelIndex + 1] = Driver.Channels[channelIndex].LayoutArray[4].SimplIsActive;
	}

	if (layoutCount > 5)
	{
    	ChannelLayout6Name[channelIndex + 1] = Driver.Channels[channelIndex].LayoutArray[5].Name;
		ChannelLayout6IsActive[channelIndex + 1] = Driver.Channels[channelIndex].LayoutArray[5].SimplIsActive;
	}

	if (layoutCount > 6)
	{
    	ChannelLayout7Name[channelIndex + 1] = Driver.Channels[channelIndex].LayoutArray[6].Name;
		ChannelLayout7IsActive[channelIndex + 1] = Driver.Channels[channelIndex].LayoutArray[6].SimplIsActive;
	}

	if (layoutCount > 7)
	{
    	ChannelLayout8Name[channelIndex + 1] = Driver.Channels[channelIndex].LayoutArray[7].Name;
		ChannelLayout8IsActive[channelIndex + 1] = Driver.Channels[channelIndex].LayoutArray[7].SimplIsActive;
	}

	if (layoutCount > 8)
	{
    	ChannelLayout9Name[channelIndex + 1] = Driver.Channels[channelIndex].LayoutArray[8].Name;
		ChannelLayout9IsActive[channelIndex + 1] = Driver.Channels[channelIndex].LayoutArray[8].SimplIsActive;
	}

	if (layoutCount > 9)
	{
    	ChannelLayout10Name[channelIndex + 1] = Driver.Channels[channelIndex].LayoutArray[9].Name;
		ChannelLayout10IsActive[channelIndex + 1] = Driver.Channels[channelIndex].LayoutArray[9].SimplIsActive;
	}

	ChannelLayoutCount[channelIndex + 1] = layoutCount;
}

CALLBACK FUNCTION SimplLayoutNameUpdate(integer channelIndex, integer layoutIndex, string layoutName)
{
	switch (layoutIndex)
	{
		case (0): 
		{
			ChannelLayout1Name[channelIndex + 1] = layoutName;
		}
		case (1): 
		{
			ChannelLayout2Name[channelIndex + 1] = layoutName;
		}
		case (2): 
		{
			ChannelLayout3Name[channelIndex + 1] = layoutName;
		}
		case (3): 
		{
			ChannelLayout4Name[channelIndex + 1] = layoutName;
		}
		case (4): 
		{
			ChannelLayout5Name[channelIndex + 1] = layoutName;
		}
		case (5): 
		{
			ChannelLayout6Name[channelIndex + 1] = layoutName;
		}
		case (6): 
		{
			ChannelLayout7Name[channelIndex + 1] = layoutName;
		}
		case (7): 
		{
			ChannelLayout8Name[channelIndex + 1] = layoutName;
		}
		case (8): 
		{
			ChannelLayout9Name[channelIndex + 1] = layoutName;
		}
		case (9): 
		{
			ChannelLayout10Name[channelIndex + 1] = layoutName;
		}
	}
}

CALLBACK FUNCTION SimplLayoutActivityUpdate(integer channelIndex, integer layoutIndex, integer isActive)
{
	switch (layoutIndex)
	{
		case (0): 
		{
			ChannelLayout1IsActive[channelIndex + 1] = isActive;
		}
		case (1): 
		{
			ChannelLayout2IsActive[channelIndex + 1] = isActive;
		}
		case (2): 
		{
			ChannelLayout3IsActive[channelIndex + 1] = isActive;
		}
		case (3): 
		{
			ChannelLayout4IsActive[channelIndex + 1] = isActive;
		}
		case (4): 
		{
			ChannelLayout5IsActive[channelIndex + 1] = isActive;
		}
		case (5): 
		{
			ChannelLayout6IsActive[channelIndex + 1] = isActive;
		}
		case (6): 
		{
			ChannelLayout7IsActive[channelIndex + 1] = isActive;
		}
		case (7): 
		{
			ChannelLayout8IsActive[channelIndex + 1] = isActive;
		}
		case (8): 
		{
			ChannelLayout9IsActive[channelIndex + 1] = isActive;
		}
		case (9): 
		{
			ChannelLayout10IsActive[channelIndex + 1] = isActive;
		}
	}
}

CALLBACK FUNCTION SimplAudioSourceListUpdate(integer entryCount)
{
	integer i;
	for (i = 1 to entryCount)
	{
 		AudioInputIsAvailable[i] = 1;
		AudioInputHasSignal[i] = Driver.AudioSources[i - 1].SimplHasSignal;
		AudioInputName[i] = Driver.AudioSources[i - 1].Name;
	}
	for (i = entryCount + 1 to MAXINPUTS)
	{
 		AudioInputIsAvailable[i] = 0; 
		AudioInputHasSignal[i] = 0;
		AudioInputName[i] = ""; 
	}

	AudioInputCount = entryCount;
}

CALLBACK FUNCTION SimplAudioSourceActivityUpdate(integer index, integer state)
{
	AudioInputHasSignal[index + 1] = state;
}

CALLBACK FUNCTION SimplAudioSourceNameUpdate(integer index, string nameS)
{
	AudioInputName[index + 1] = nameS;
}

CALLBACK FUNCTION SimplVideoSourceListUpdate(integer entryCount)
{
	integer i;
	for (i = 1 to entryCount)
	{
 		VideoInputIsAvailable[i] = 1;
		VideoInputHasSignal[i] = Driver.VideoSources[i - 1].SimplHasSignal;
		VideoInputName[i] = Driver.VideoSources[i - 1].Name;
		VideoInputResolution[i] = Driver.VideoSources[i - 1].Resolution;
	}
	for (i = entryCount + 1 to MAXINPUTS)
	{
 		VideoInputIsAvailable[i] = 0; 
		VideoInputHasSignal[i] = 0;
		VideoInputName[i] = "";
		VideoInputResolution[i] = ""; 
	}

	VideoInputCount = entryCount;
}

CALLBACK FUNCTION SimplVideoSourceActivityUpdate(integer index, integer state)
{
	VideoInputHasSignal[index + 1] = state;
}

CALLBACK FUNCTION SimplVideoSourceNameUpdate(integer index, string nameS)
{
	VideoInputName[index + 1] = nameS;
}

CALLBACK FUNCTION SimplVideoSourceTimingUpdate(integer index, string timing)
{
	VideoInputResolution[index + 1] = timing;
}

CALLBACK FUNCTION SimplDisplayListUpdate(integer entryCount)
{
	integer i;
	for (i = 1 to entryCount)
	{
		VideoOutputIsAvailable[i] = 1;
		VideoOutputHasSignal[i] = Driver.Displays[i - 1].SimplIsActive;
		VideoOutputName[i] = Driver.Displays[i - 1].Name;
		VideoOutputResolution[i] = Driver.Displays[i - 1].Resolution;
		VideoOutputResolutionAndRate[i] = Driver.Displays[i - 1].ResolutionAndRefreshRate;
	}
	for (i = entryCount + 1 to MAXOUTPUTS)
	{
		VideoOutputIsAvailable[i] = 0;
		VideoOutputHasSignal[i] = 0;
		VideoOutputName[i] = "";
		VideoOutputResolution[i] = "";
		VideoOutputResolutionAndRate[i] = ""; 
	}

	VideoOutputCount = entryCount;
}

CALLBACK FUNCTION SimplDisplayActivityUpdate(integer index, integer state)
{
	VideoOutputHasSignal[index + 1] = state;
}

CALLBACK FUNCTION SimplDisplayNameUpdate(integer index, string nameS)
{
	VideoOutputName[index + 1] = nameS;
}

CALLBACK FUNCTION SimplDisplayTimingUpdate(integer index, string reso, string resoAndRate)
{
	VideoOutputResolution[index + 1] = reso;
	VideoOutputResolutionAndRate[index + 1] = resoAndRate;
}

CALLBACK FUNCTION SimplTotalSpaceUpdate(integer spaceAnalog, string spaceSerial)
{
	TotalSpaceAnanlog = spaceAnalog;
	TotalSpaceSerial = spaceSerial;
}

CALLBACK FUNCTION SimplUsedSpaceUpdate(integer spaceAnalog, string spaceSerial)
{
	UsedSpaceSerial = spaceSerial;
	UsedSpaceAnalog = spaceAnalog;
}

CALLBACK FUNCTION SimplFreeSpaceUpdate(integer spaceAnalog, string spaceSerial)
{
	FreeSpaceSerial = spaceSerial;
	FreeSpaceAnalog = spaceAnalog;
}

THREADSAFE PUSH StartCommunication
{
	while (_initilizationComplete = 0)
	{
         Delay(50);
	}
	Driver.StartCommunication(DeviceAddress, DevicePort, DeviceUsername, DevicePassword);
}

THREADSAFE PUSH StopCommunication
{
	if (_initilizationComplete)
	{
 		Driver.StopCommunication();
	}
}

CALLBACK FUNCTION SimplCommunicationStateUpdate(integer isCommunicatingB)
{
	IsCommunicating = isCommunicatingB;
}

CALLBACK FUNCTION SimplErrorMessageUpdate(string message)
{
	ErrorMessage = message;
}

CALLBACK FUNCTION SimplUpcomingEventNameUpdate(string eventName)
{
	UpcomingEventName = eventName;
}

CALLBACK FUNCTION SimplCurrentEventNameUpdate(string eventName)
{
	CurrentEventName = eventName;
}

CALLBACK FUNCTION SimplUpcomingEventCountdownUpdate(string countdown)
{
	UpcomingEventCountdown = countdown;
}

CALLBACK FUNCTION SimplCurrentEventStatusUpdate(string status)
{
	CurrentEventStatus = status;
}

CALLBACK FUNCTION SimplChannelPreviewImageUpdate(integer index, string value)
{
	ChannelPreviewUrl[index] = value;
}

CALLBACK FUNCTION SimplChannelLayoutPreviewImageUpdate(integer index, string value)
{
	ChannelLayoutPreviewUrl[index] = value;
}

PUSH LoggingEnabled
{
	Driver.EnableLogging(1);
}

RELEASE LoggingEnabled
{
	Driver.EnableLogging(0);
}

PUSH VerboseLoggingEnabled
{
	Driver.EnableVerboseLogging(1);
}

RELEASE VerboseLoggingEnabled
{
	Driver.EnableVerboseLogging(0);
}

FUNCTION RegisterDelegates()
{
 	RegisterDelegate(Driver, SimplRecorderListUpdated, SimplRecorderListUpdate);
 	RegisterDelegate(Driver, SimplRecorderStateUpdated, SimplRecorderStateUpdate);
 	RegisterDelegate(Driver, SimplRecorderNameUpdated, SimplRecorderNameUpdate);

 	RegisterDelegate(Driver, SimplChannelRecordingStateUpdated, SimplChannelRecordingStateUpdate);
 	RegisterDelegate(Driver, SimplChannelListUpdated, SimplChannelListUpdate);
 	RegisterDelegate(Driver, SimplPublishingStreamTypeUpdated, SimplPublishingStreamTypeUpdate);
 	RegisterDelegate(Driver, SimplPublishingStreamStateUpdated, SimplPublishingStreamStateUpdate);
 	RegisterDelegate(Driver, SimplPublishingNameUpdated, SimplPublishingNameUpdate);
 	RegisterDelegate(Driver, SimplPublishingListUpdated, SimplPublishingListUpdate);
 	RegisterDelegate(Driver, SimplChannelNameUpdated, SimplChannelNameUpdate);
 	RegisterDelegate(Driver, SimplLayoutListUpdated, SimplLayoutListUpdate);
 	RegisterDelegate(Driver, SimplLayoutNameUpdated, SimplLayoutNameUpdate);
 	RegisterDelegate(Driver, SimplLayoutActivityUpdated, SimplLayoutActivityUpdate);
	RegisterDelegate(Driver, SimplAllPublishingStateUpdated, SimplAllPublishingStateUpdate);

 	RegisterDelegate(Driver, SimplAudioSourceListUpdated, SimplAudioSourceListUpdate);
 	RegisterDelegate(Driver, SimplAudioSourceActivityUpdated, SimplAudioSourceActivityUpdate);
 	RegisterDelegate(Driver, SimplAudioSourceNameUpdated, SimplAudioSourceNameUpdate);

 	RegisterDelegate(Driver, SimplVideoSourceListUpdated, SimplVideoSourceListUpdate);
 	RegisterDelegate(Driver, SimplVideoSourceActivityUpdated, SimplVideoSourceActivityUpdate);
 	RegisterDelegate(Driver, SimplVideoSourceNameUpdated, SimplVideoSourceNameUpdate);
 	RegisterDelegate(Driver, SimplVideoSourceTimingUpdated, SimplVideoSourceTimingUpdate);

 	RegisterDelegate(Driver, SimplDisplayListUpdated, SimplDisplayListUpdate);
 	RegisterDelegate(Driver, SimplDisplayActivityUpdated, SimplDisplayActivityUpdate);
 	RegisterDelegate(Driver, SimplDisplayNameUpdated, SimplDisplayNameUpdate);
 	RegisterDelegate(Driver, SimplDisplayTimingUpdated, SimplDisplayTimingUpdate);

 	RegisterDelegate(Driver, SimplTotalSpaceUpdated, SimplTotalSpaceUpdate);
 	RegisterDelegate(Driver, SimplUsedSpaceUpdated, SimplUsedSpaceUpdate);
    RegisterDelegate(Driver, SimplFreeSpaceUpdated, SimplFreeSpaceUpdate);

	RegisterDelegate(Driver, SimplCommunicationStateUpdated, SimplCommunicationStateUpdate);
	RegisterDelegate(Driver, SimplErrorMessageUpdated, SimplErrorMessageUpdate);

	RegisterDelegate(Driver, SimplUpcomingEventNameUpdated, SimplUpcomingEventNameUpdate);
	RegisterDelegate(Driver, SimplCurrentEventNameUpdated, SimplCurrentEventNameUpdate);
	RegisterDelegate(Driver, SimplUpcomingEventCountdownUpdated, SimplUpcomingEventCountdownUpdate);
	RegisterDelegate(Driver, SimplCurrentEventStatusUpdated, SimplCurrentEventStatusUpdate);

	RegisterDelegate(Driver, SimplChannelPreviewImageUpdated, SimplChannelPreviewImageUpdate);
	RegisterDelegate(Driver, SimplChannelLayoutPreviewImageUpdated, SimplChannelLayoutPreviewImageUpdate);
}

FUNCTION Main()
{
	WaitForInitializationComplete();
	RegisterDelegates();
	Driver.SimplPearl2DriverConfig(DeviceConnectionType);
    _initilizationComplete = 1;
}
