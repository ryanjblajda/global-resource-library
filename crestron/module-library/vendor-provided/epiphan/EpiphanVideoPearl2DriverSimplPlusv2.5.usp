integer _initilizationComplete;
  
PUSH StartRecordingOnRecorder
{
	Driver.StartRecordingOnRecorder(GetLastModifiedArrayIndex() - 1);
}

PUSH StopRecordingOnRecorder
{
	Driver.StopRecordingOnRecorder(GetLastModifiedArrayIndex() - 1);	
}

CALLBACK FUNCTION SimplRecorderListUpdate(integer entryCount)
{
	integer i;

	for (i = 1 to entryCount)
	{
    	RecorderIsAvailable[i] = 1;
		RecorderName[i] = Driver.Recorders[i - 1].Name;		
	}

	for (i = entryCount + 1 to MAXRECORDERS)
	{
 		RecorderIsAvailable[i] = 0;
		RecorderName[i] = "";
		RecorderIsRecording[i] = 0;
	}

	RecorderCount = entryCount;
}

CALLBACK FUNCTION SimplRecorderStateUpdate(integer recorderIndex, integer recorderState)
{
	RecorderIsRecording[recorderIndex + 1] = recorderState;	
}

CALLBACK FUNCTION SimplRecorderNameUpdate(integer recorderIndex, string recorderNameS)
{
	RecorderName[recorderIndex + 1] = recorderNameS;
}

