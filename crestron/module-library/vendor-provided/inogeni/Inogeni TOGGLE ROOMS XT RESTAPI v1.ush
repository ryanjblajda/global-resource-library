[BEGIN]
  ObjTp=Hd
  Cmn1=FILENAME: Inogeni TOGGLE ROOMS / XT\\MANUFACTURER: Inogeni\\MODEL:
  Cmn2=||1TOGGLE ROOMS / XT\\\\CATEGORY: Video/USB Selector\\VERSION: 2\\
  Cmn3=\\SUMMARY: Provides RS232, Telnet Or REST API control for device||1
  Cmn4=commands\\\\TOGGLE ROOMS Telnet server auto close connection when||1
  Cmn5=it does not receive communication for 10 sec.\\It is normal to see||1
  Cmn6=Telnet connection going down when Polling is disabled.\\\\\\SETUP||1
  Cmn7=OF CRESTRON HARDWARE:\\BAUD RATE - 9600\\PARITY - NONE\\DATA BITS||1
  Cmn8=- 8\\STOP BITS - 1\\\\VENDOR FIRMWARE: v1.21\\\\*********************************
  Cmn9=*********************************\\PARAMETERS:\\\\NAME||:
  Cmn10=||4TYPE DESCRIPTION\\\\Control            P   Select RS232, Telnet||1
  Cmn11=Or REST API control.\\                   \\\\************************************
  Cmn12=******************************\\INPUT DESCRIPTIONS:\\\\NAME||5
  Cmn13=||=TYPE DESCRIPTION  \\\\\\Module_Enable         D||4
  Cmn14=Enable module and start communication with the device.\\Reboot||2
  Cmn15=||>D    Reboot the device\\FactoryDefault        D||3
  Cmn16=||1Erase the current configuration onboard and return to default values.
  Cmn17=\\Version               D    Pulse to get Firmware version\\Status||1
  Cmn18=||?D    Pulse to get current device status\\USBC4K60EN||1
  Cmn19=||;D    Pulse to Toggle USB-C support 4K60, no effect when||1
  Cmn20=using 4K60 and up Fixed EDID\\DisplayScaler         D    Pulse to||1
  Cmn21=Toggle down scaling of Display output, all inputs scale to 1080p\\
  Cmn22=ShareScaler           D    Pulse to Toggle down scaling of Share||1
  Cmn23=output, all inputs scale to 1080p\\DisplayCECPowerOn     D    Pulse||1
  Cmn24=to send CEC Power ON command.\\DisplayCECPowerOff    D    Pulse||1
  Cmn25=to send CEC Power OFF command.\\CECPassthrough         D    Pulse||1
  Cmn26=to Toggle, CEC passthrough allow CEC controls from the selected||1
  Cmn27=HDMI input to the Display.\\AutoHDMIcecPower      D    Pulse to||1
  Cmn28=Toggle, Auto Power ON / Off based on HDMI video presence. (Disable||1
  Cmn29=CECpassthrough if not working as expected.)\\\\POLL||=
  Cmn30=||5D    Set high/1 to enable polling. Returns the current view||1
  Cmn31=of the device, firmware version and inputs resolutions.\\debug||2
  Cmn32=||?D    Set high/1 to enable debug print\\ \\HostMeeting||1
  Cmn33=||:A    Change value to change Host Meeting (Video and USB||1
  Cmn34=to same Host)\\HostMeetingPriority   A    Change value to set a||1
  Cmn35=preferred Host, default 3 (last connected)\\DisplaySource||7
  Cmn36=||2A    Change value to set Display out source.\\ShareSource||5
  Cmn37=||6A    Change value to set Share out source.\\USB_Host||6
  Cmn38=||8A    Change value to set USB Host source\\\\OperationMode||1
  Cmn39=||8A    Change value to set Operation Mode, default 0 (BYOD||1
  Cmn40=with content sharing)\\\\//Only valid in Custom Mode (Operation||1
  Cmn41=Mode 2)\\USBSwitchMode         A    Change value to set desired||1
  Cmn42=Mode\\USBPriority           A    Change value to set desired Priority\\
  Cmn43=DisplaySwitchMode     A    Change value to set desired Mode\\DisplayPriority||1
  Cmn44=||6A    Change value to set desired Priority\\ShareSwitchMode||1
  Cmn45=||6A    Change value to set desired Mode\\SharePriority||6
  Cmn46=||3A    Change value to set desired Priority\\\\USBDevicePower_RoomPC||1
  Cmn47=A    Change value to control USB Ports Power in RoomPC Host\\USBDevicePower_LUSBc
  Cmn48=||2A    Change value to control USB Ports Power in Laptop USB-C Host\\
  Cmn49=USBDevicePower_LHdmi  A    Change value to control USB Ports Power||1
  Cmn50=in Laptop HDMI Host\\USBDevicePower_Nohost A    Change value to||1
  Cmn51=control USB Ports Power in No Host\\\\Rx$                   S||3
  Cmn52=||1Serial data string to be routed from a COM port.\\\\\\**************************
  Cmn53=****************************************\\OUTPUT DESCRIPTIONS:\\
  Cmn54=\\NAME                  TYPE DESCRIPTION\\\\TelnetConnected_fb||2
  Cmn55=||2D    High when Telnet is connected only with IP control.\\USBC4K60EN_fb||1
  Cmn56=||8D    HIGH when USB-C support 4K60\\CECPassthrough_fb||4
  Cmn57=||2D    HIGH when CEC Passthrough is enabled \\AutoHDMIcecPower_fb||1
  Cmn58=||2D    HIGH when Auto CEC controls is enabled.\\DisplayScaler_fb||1
  Cmn59=||5D    HIGH when Display out is scaled to 1080p\\ShareScaler_fb||1
  Cmn60=||7D    HIGH when Share out is scaled to 1080p\\\\TelnetSocketStatus_fb||1
  Cmn61=A    Current value of Crestron TCP client\\DisplaySource_fb||5
  Cmn62=||1A    Current value of Display out source\\ShareSource_fb||7
  Cmn63=||1A    Current value of Share out source\\USB_Host_fb           A||1
  Cmn64=||3Current value of USB Host source\\HostMeetingPriority_fb A||3
  Cmn65=Current value of Host Meeting Priority\\\\OperationMode_fb||6
  Cmn66=A   Current value of Operation Mode\\\\USBSwitchMode_fb      A||2
  Cmn67=||1Current value of USB switching mode\\USBPriority_fb        A||3
  Cmn68=Current value of USB Host Priority\\DisplaySwitchMode_fb  A   Current||1
  Cmn69=value of Display out switch mode\\DisplayPriority_fb    A   Current||1
  Cmn70=value of Display out Priority\\ShareSwitchMode_fb    A   Current||1
  Cmn71=value of Share out switch mode\\SharePriority_fb      A   Current||1
  Cmn72=value of Share out Priority\\\\USBDevicePower_RoomPC_fb A    Current||1
  Cmn73=value of USB Ports Power in RoomPC Host\\USBDevicePower_LUSBc_fb||1
  Cmn74=||1A    Current value of USB Ports Power in Laptop USB-C Host\\USBDevicePower_LHdmi
  Cmn75=_fb  A    Current value of USB Ports Power in Laptop HDMI Host\\
  Cmn76=USBDevicePower_Nohost_fb A    Current value of USB Ports Power in||1
  Cmn77=No Host\\                   \\FirmV                 S    Report||1
  Cmn78=Firmware version\\IP_Address            S    Report IP Address\\
  Cmn79=IP_SubnetMask         S    Report SubnetMask\\IP_Gateway||8
  Cmn80=||4S    Report Gateway\\MAC_Address           S    Report MAC Address\\
  Cmn81=\\HostMeeting_fb        S    Report String of current Host Meeting,||1
  Cmn82=based on USB Host value and Display out value. \\\\USBC_Video_fb||1
  Cmn83=||8S    Report Detected Laptop USB-C video format\\Laptop_Video_fb||1
  Cmn84=||6S    Report Detected Laptop HDMI video format\\RoomPC_Video_fb||1
  Cmn85=||6S    Report Detected RoomPC video format             \\\\Tx$||1
  Cmn86=||BS    Serial data string to be routed to a COM||1
  Cmn87=port.
[END]
