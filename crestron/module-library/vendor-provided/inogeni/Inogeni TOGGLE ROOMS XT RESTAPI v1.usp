PUSH FactoryDefault 	//Erase the current configuration onboard and return to default values
{
	if (CommMode = "REST API")
	{	
		//rstr will reset all settings to default and reboot the device.
		SendStoreCommand("rstr");	
	}
	else
	{
		//RSTR 0, will factory reset without rebooting unit.
		SendStoreCommand("RSTR 0\x0d\x0a");
	}
}
