			for( count = 1 to GetNumArrayRows(VideoGeneralToken))
			{
				//if(Debug) Print("searching ShareOut VideoGeneralToken[%d] = %s from data", count, VideoGeneralToken[count]);
				if(find(VideoGeneralToken[count], stemp2))
				{	
					start = find(VideoGeneralToken[count], stemp2) + len(VideoGeneralToken[count]) + 3;	
					if(find(",", stemp2, start) > 1  )
						end = find(",", stemp2, start) - start;
					else
						end = find("\x0a", stemp2, start) - start;

					temp = mid(stemp2, start, end);
						if(find("\x22", temp))//info are in double quote
						{		
							temp = mid(temp, 2, find("\x22", temp, 2)-2 );						
						}			
					ShareInfo[count] = temp;
				}
				else { ShareInfo[count] = ""; //if(Debug) Print("Not Found %s",VideoGeneralToken[count] );
					}
			}
		
		}

		if(find("Laptop-Out", JSONdata ))
		{
			start = find("{",JSONdata, find("Laptop-Out", JSONdata )) +1;
			end = find("}",JSONdata, start) - start;
			stemp2 = mid(JSONdata,start , end );
			
			for( count = 1 to GetNumArrayRows(VideoGeneralToken))
			{
				//if(Debug) Print("searching LaptopOut VideoGeneralToken[%d] = %s from data", count, VideoGeneralToken[count]);
				if(find(VideoGeneralToken[count], stemp2))
				{	
					start = find(VideoGeneralToken[count], stemp2) + len(VideoGeneralToken[count]) + 3;	
					if(find(",", stemp2, start) > 1  )
						end = find(",", stemp2, start) - start;
					else
						end = find("\x0a", stemp2, start) - start;

					temp = mid(stemp2, start, end);
						if(find("\x22", temp))//info are in double quote
						{		
							temp = mid(temp, 2, find("\x22", temp, 2)-2 );						
						}			
					LaptopInfo[count] = temp;
				}
				else { LaptopInfo[count] = ""; //if(Debug) Print("Not Found %s",VideoGeneralToken[count] );
					}
			}
		
		}
				
		
		
		//if(Debug) Print("finished parsing JSON");

		return(1);			
						
}
 
Function StatusParserHTTP(integer code, string cmd, integer cmdlen)
{
	string sTemp2[MAX_CONTENT_STRING_LENGTH];
	string videotemp[255], temp[255];
	integer count;
	
	if((len(cmd) < cmdlen))
	{
		response_content = response_content + cmd;
	}
	else
	{
		response_content = cmd;
	}
	
	if(len(response_content) = cmdlen)
	{
			
		sTemp2 = response_content;
		response_content= "";
		
		//if (Debug) print("received data len: %d, with data:%s", len(sTemp2), stemp2 );

		if(code = 200)
		{
			//if (Debug) print("ParsingThis: %s", sTemp2);
			DeviceConnected_fb = 1;

			
			if(find("success", sTemp2))
			{
				if (Debug) print("Command %s Success",mCommand );
				iReady = 1;
			}
			if(find("failed", sTemp2))
			{
				if (Debug) print("Command %s Error",mCommand );
				iReady = 1;
			}
			else if(iStatusRequest)
			{
				TRJSONParse(stemp2);
				
				
				sFirmVersion = GeneralInfo[1] + "." + GeneralInfo[2] ;
				if(sFirmMem != sFirmVersion)
				{
					sFirmMem = sFirmVersion;
					Firmv = sFirmVersion;			
				}
				
				//BoardV = GeneralInfo[3] + "." + GeneralInfo[4] ;
				if(find("XT", GeneralInfo[6],1))
				{
					DeviceIsXT = 1;
				}
				else if(find("TR", GeneralInfo[6], 1))
				{
					DeviceIsXT = 0;
				}
				if(sMAC != GeneralInfo[5])
				{
					sMAC = GeneralInfo[5];
					MAC_Address = sMAc;
				}
				if(sIP != GeneralInfo[8])
				{
					sIP = GeneralInfo[8];
					IP_Address = sIP;
				}
				if(sSubnetMem != GeneralInfo[9])
				{
					sSubnetMem = GeneralInfo[9];
					IP_SubnetMask = sSubnetMem;
				}
				if(sGatewayMem != GeneralInfo[10])
				{
					sGatewayMem = GeneralInfo[10];
					IP_Gateway = sGatewayMem;
				}
				if(OperationMode_fb != atoi(ConfigurationInfo[1]))
					OperationMode_fb =  atoi(ConfigurationInfo[1]);
				if(iUSBHost != atoi(ConfigurationInfo[2]))
				{
					iUSBHost = atoi(ConfigurationInfo[2]);
					if(iUSBHost = 4) //RoomPC with no Link
						iUSBHost = 0;
					if(USB_Host_fb != iUSBHost)
					{
						USB_Host_fb = iUSBHost; 
						iCtrlsChanged = 1;
					}
				}
				if(iDisplaySrc != atoi(ConfigurationInfo[3]))
				{
					iDisplaySrc = atoi(ConfigurationInfo[3]);
					DisplaySource_fb = iDisplaySrc;  
					iCtrlsChanged = 1;  
				}
				if(ShareSource_fb != atoi(ConfigurationInfo[4]))
				{
					ShareSource_fb = atoi(ConfigurationInfo[4]); 
				}
				if(iUSBssMode != atoi(ConfigurationInfo[11])) //TR only
				{
					USBC4K60EN_fb = atoi(ConfigurationInfo[11]); 
				}
				if(LaptopSource_fb != atoi(ConfigurationInfo[40])) //TR XT only
				{
					LaptopSource_fb = atoi(ConfigurationInfo[40]); 
				}
				if(USBSwitchMode_fb != atoi(ConfigurationInfo[5]))
				{
					USBSwitchMode_fb = atoi(ConfigurationInfo[5]); 
				}
				if(USBPriority_fb != atoi(ConfigurationInfo[6]))
				{
					USBPriority_fb = atoi(ConfigurationInfo[6]); 
				}
				if(DisplaySwitchMode_fb != atoi(ConfigurationInfo[7]))
				{
					DisplaySwitchMode_fb = atoi(ConfigurationInfo[7]); 
				}
				if(DisplayPriority_fb != atoi(ConfigurationInfo[8]))
				{
					DisplayPriority_fb = atoi(ConfigurationInfo[8]); 
				}
				if(ShareSwitchMode_fb != atoi(ConfigurationInfo[9]))
				{
					ShareSwitchMode_fb = atoi(ConfigurationInfo[9]); 
				}
				if(SharePriority_fb != atoi(ConfigurationInfo[10]))
				{
					SharePriority_fb = atoi(ConfigurationInfo[10]); 
				}
				if(LaptopSwitchMode_fb != atoi(ConfigurationInfo[39]))
				{
					LaptopSwitchMode_fb = atoi(ConfigurationInfo[39]); 
				}
				if(LaptopPriority_fb != atoi(ConfigurationInfo[38]))
				{
					LaptopPriority_fb = atoi(ConfigurationInfo[38]); 
				}
				if(DisplayScaler_fb != atoi(ConfigurationInfo[29]))
				{
					DisplayScaler_fb = atoi(ConfigurationInfo[29]); 
				}
				if(ShareScaler_fb != atoi(ConfigurationInfo[30]))
				{
					ShareScaler_fb = atoi(ConfigurationInfo[30]); 
				}
				if(LaptopScaler_fb != atoi(ConfigurationInfo[41]))
				{
					LaptopScaler_fb = atoi(ConfigurationInfo[41]); 
				}
				if(Laptop1Info[3] = "true")
				{
					Makestring(videotemp, "%s,%s", Laptop1Info[1], Laptop1Info[5]);
					if(sVideoMem[1] != videotemp)
					{
						sVideoMem[1] = videotemp;
						USBC_Video_fb = sVideoMem[1];
					}
					
				}
				else
				{
					if(sVideoMem[1] != "Not Detected")
					{
						sVideoMem[1] = "Not Detected";
						USBC_Video_fb = sVideoMem[1];
					}
				}
				if(Laptop2Info[3] = "true")
				{
					Makestring(videotemp, "%s,%s", Laptop2Info[1], Laptop2Info[5]);
					if(sVideoMem[2] != videotemp)
					{
						sVideoMem[2] = videotemp;
						Laptop_Video_fb = sVideoMem[2];
					}
					
				}
				else
				{
					if(sVideoMem[2] != "Not Detected")
					{
						sVideoMem[2] = "Not Detected";
						Laptop_Video_fb = sVideoMem[2];
					}
				}
				if(RoomPCInfo[3] = "true")
				{
					Makestring(videotemp, "%s,%s", RoomPCInfo[1], RoomPCInfo[5]);
					if(sVideoMem[3] != videotemp)
					{
						sVideoMem[3] = videotemp;
						RoomPC_Video_fb = sVideoMem[3];
					}
				}
				else
				{
					if(sVideoMem[3] != "Not Detected")
					{
						sVideoMem[3] = "Not Detected";
						RoomPC_Video_fb = sVideoMem[3];
					}
				}
				if(iCECPassthrough != atoi(ConfigurationInfo[35]))
				{
					iCECPassthrough = atoi(ConfigurationInfo[35]);
					CECPassthrough_fb = iCECPassthrough; 
				}
				if(iAutoHDMIcecPower != atoi(ConfigurationInfo[34]))
				{
					iAutoHDMIcecPower = atoi(ConfigurationInfo[34]);
					AutoHDMIcecPower_fb = iAutoHDMIcecPower; 
				}
				if(USBDevicePower_RoomPC_fb != atoi(ConfigurationInfo[22]))
				{
					USBDevicePower_RoomPC_fb = atoi(ConfigurationInfo[22]); 
				}
				if(USBDevicePower_LUSBc_fb != atoi(ConfigurationInfo[23]))
				{
					USBDevicePower_LUSBc_fb = atoi(ConfigurationInfo[23]); 
				}
				if(USBDevicePower_LHdmi_fb != atoi(ConfigurationInfo[24]))
				{
					USBDevicePower_LHdmi_fb = atoi(ConfigurationInfo[24]); 
				}
				if(USBDevicePower_Nohost_fb != atoi(ConfigurationInfo[25]))
				{
					USBDevicePower_Nohost_fb = atoi(ConfigurationInfo[25]); 
				}
				if(HostMeetingPriority_fb != atoi(ConfigurationInfo[36]))
				{
					HostMeetingPriority_fb = atoi(ConfigurationInfo[36]); 
				}

				//Add new commands here
				
				if(iCtrlsChanged)
				{
					iCtrlsChanged = 0;
					if(iDisplaySrc = iUSBHost) //evaluate Hostmeeting
					{
						switch(DisplaySource_fb)
						{
							case (0):
							{		
								HostMeeting_fb = "RoomPC";
							}
							case (1):
							{
								HostMeeting_fb = "Laptop USB-C";
							}
							case (2):
							{
								HostMeeting_fb = "Laptop HDMI";
							}
							Default:
							{  
								HostMeeting_fb = "None";
							}
						}
					}
					else
					{
						HostMeeting_fb = "Custom HDMI/USB Routing";
					}

				}
				iStatusRequest = 0;
				iReady = 1;
				if (Debug) print("Status completed");
			}	
			else if(find("link", mCommand))
			{
				//decode Link info json data
				LinkInfoToken[1] = "HdbtLink";
				LinkInfoToken[2] = "HdbtCableLength";
							
				for( count = 1 to GetNumArrayRows(LinkInfoToken))
				{
					
					if(find(LinkInfoToken[count], stemp2))
					{	
						//if(Debug) Print("Foud %s",LinkInfoToken[count] );
				
						start = find(LinkInfoToken[count], stemp2) + len(LinkInfoToken[count]) + 3;
						end = find(",", stemp2, start) - start;
						
						temp = mid(stemp2, start, end);
							if(find("\x22", temp))//info are in double quote
							{		
								temp = mid(temp, 2, len(temp)-2 );						
							}			
							LinkInfo[count] = temp;
					}
					else { LinkInfo[count] = ""; //if(Debug) Print("Not Found %s",LinkInfoToken[count] );
					}
				}


				if(Link_fb != atoi(LinkInfo[1]))
				{
					Link_fb = atoi(LinkInfo[1]); 
				}
				else
				if(sLinkLenght != LinkInfo[2])
				{
					sLinkLenght = LinkInfo[2]; 
					if(LinkInfo[2] != "0")
						LinkLength_fb = sLinkLenght; 
					else
						LinkLength_fb = "";
				}
				
				
				iReady = 1;
				
			}		
		}
		else if(code = 400)
		{
			if (Debug) print("400 Error : %s", stemp2);
			iReady = 1;	
		}
		else if(code = 401)
		{
			
			if (Debug) print("401 Authentification Error, verify API Token");
			iNextStore = iNextSend; //stop sending command in memory
			iReady = 1;
			DeviceConnected_fb = 0 ;

		}
		else
		{
			if (Debug) print("Bad Command, %s", stemp2);
			iNextStore = iNextSend;
			iReady = 1;
		}
	

		if(iReady = 1)
		{
			if(iNextStore <> iNextSend)
			{
				SendStoreCommand(sQueue[iNextSend]);
			}
			else
			{
				fPollTimeOut();
			}
		}
	}
}
 
//RS232 Telnet Parsing
Function StatusParser(string s)
{
	integer temp;
	//cancelwait(wTimeOut);//cancel no response timeouOn ACK or NACK only

	//if (Debug) print("ParsingThis: %s", s);
	if(find("NACK",s))
	{
		cancelwait(wTimeOut);//cancel no response timeouOn ACK or NACK only
		if (Debug) print("Invalid selection or Command Error, plese check command");
		iReady = 1;
	}
	else if(find("ACK",s) = 1) //filter NACK by searching ACK at start of string
	{	
		cancelwait(wTimeOut);//cancel no response timeouOn ACK or NACK onlyP
		DeviceConnected_fb = 1;	
		if(iStatusRequest)
		{
			
			sFirmVersion = sMajor + "." + sMinor;
			if(sFirmMem != sFirmVersion)
			{
				sFirmMem = sFirmVersion;
				Firmv = sFirmVersion;			
			}
			if(iCtrlsChanged)
			{
				iCtrlsChanged = 0;
				if(iDisplaySrc = iUSBHost) //evaluate Hostmeeting
				{	
					switch(DisplaySource_fb)
					{
						case (0):
						{		
							HostMeeting_fb = "RoomPC";
						}
						case (1):
						{
							HostMeeting_fb = "Laptop USB-C";
						}
						case (2):
						{
							HostMeeting_fb = "Laptop HDMI";
						}
						Default:
						{  
							HostMeeting_fb = "None";
						}
					}
				}
				else if(iDisplaySrc = 3) //Share Source
				{
					switch(ShareSource_fb)
					{
						case (0):
						{
							HostMeeting_fb = "RoomPC";
						}
						case (1):
						{
							HostMeeting_fb = "Laptop USB-C";
						}
						case (2):
						{
							HostMeeting_fb = "Laptop HDMI";
						}
						Default:
						{
							HostMeeting_fb = "None";
						}
					}
				}
				else if(iDisplaySrc = 4) //Laptop Source
				{
					switch(LaptopSource_fb)
					{
						case (0):
						{
							HostMeeting_fb = "RoomPC";
						}
						case (1):
						{
							HostMeeting_fb = "Laptop USB-C";
						}
						case (2):
						{
							HostMeeting_fb = "Laptop HDMI";
						}
						Default:
						{
							HostMeeting_fb = "None";
						}
					}
				
				}
				else
				{
					HostMeeting_fb = "Custom HDMI/USB Routing";
				}
			}
			iStatusRequest = 0;
			//updating Info		
		}
		else if(find("PRIORHOSTMEETING", mCommand) || find("CECPOWER", mCommand) )
		{
			if(find("PRIORHOSTMEETING ", mCommand)) //command with space mean we change the value
				HostMeetingPriority_fb = HostMeetingPriority; //force feedback on ACK response
		}
		else if(find("SCALER 0", mCommand))
		{
			DisplayScaler_fb = atoi(mid(mCommand,10, 1));//force feedback on ACK response				
		}
		else if(find("SCALER 1",mCommand))
		{
			ShareScaler_fb = atoi(mid(mCommand,10, 1));	//force feedback on ACK response	
		}
		else if(find("SCALER 2",mCommand))
		{
			LaptopScaler_fb = atoi(mid(mCommand,10, 1));	//force feedback on ACK response	
		}
		else if(find("REBOOT", mCommand))
		{
			if (Debug) print("Please Wait unit is rebooting");
			wait(400)
			{
				SendStoreCommand("STATUS\x0d\x0a");
			}

		}
		else if(find("RSTR", mCommand))
		{
			if (Debug) print("Factory Reset please wait, will re-enable Telnet if control mode is Telnet");
			
			wait(400)
			{
				if (CommMode = "Telnet")
					SendStoreCommand("TELNETEN 1\x0d\x0a");
					
				SendStoreCommand("STATUS\x0d\x0a");
			}
		}
				
		iReady = 1;
		
		
	}
	else if(find("STATUS", mCommand))
	{		
		start = find("=",s) + 1;
		end = len(s)-start-1;
				
		//if (Debug) print("searching into, %s from %d to %d", s, start, end);
	
		if(find("MAJOR",s) = 1)
			sMajor = mid(s, start, end);
		if(find("MINOR",s) = 1)
			sMinor = mid(s, start, end);			
		if(find("MAC",s))
		{
			if(sMAC != mid(s, start, end))
			{
				sMAC = mid(s, start, end);
				MAC_Address = sMAc;
			}
		}
		if(find("IP=",s))
		{
			if(sIP != mid(s, start, end))
			{
				sIP = mid(s, start, end);
				IP_Address = sIP;
			}
		}		
		if(find("SUBNET",s))
		{
			if(sSubnetMem != mid(s, start, end))
			{
				sSubnetMem = mid(s, start, end);
				IP_SubnetMask = sSubnetMem;
			}
		}
		if(find("GATEWAY",s))
		{
			if(sGatewayMem != mid(s, start, end))
			{
				sGatewayMem = mid(s, start, end);
				IP_Gateway = sGatewayMem;
			}
		}
		if(find("OPMODE=",s))
		{
			temp = atoi(mid(s, start, end));
			if(temp != OperationMode_fb)
				OperationMode_fb =  temp;
		}
		if(find("USBHOST=",s) = 1)
		{
			iUSBHost = atoi(mid(s, start, end));		//keep track of USBHost
			if(iUSBHost = 4)
				iUSBHost = 0;
			if(USB_Host_fb != iUSBHost)
			{
				USB_Host_fb = iUSBHost; 
				iCtrlsChanged = 1;
			}
		}
		if(find("DISPLAYSRC=",s) = 1)
		{
			iDisplaySrc = atoi(mid(s, start, end)); //keep track of DISPLAYSRC
			if(DisplaySource_fb != iDisplaySrc)
			{
				DisplaySource_fb = iDisplaySrc;  
				iCtrlsChanged = 1;
			}   
		}
		if(find("SHARESRC=",s) = 1)
		{
			temp = atoi(mid(s, start, end));
			if(temp != ShareSource_fb)
				ShareSource_fb = temp;

		}	
		if(find("LAPTOPSRC=",s) = 1)
		{
			temp = atoi(mid(s, start, end));
			if(temp != LaptopSource_fb)
				LaptopSource_fb = temp;

		}			
		if(find("USBHOSTSWMODE",s))
		{
			temp = atoi(mid(s, start, end));
			if(temp != USBSwitchMode_fb)
				USBSwitchMode_fb = temp;
		}
		if(find("SHARESWMODE",s))
		{
			temp = atoi(mid(s, start, end));
			if(temp != ShareSwitchMode_fb)
				ShareSwitchMode_fb = temp;
		}
		if(find("DISPLAYSWMODE",s))
		{
			temp = atoi(mid(s, start, end));
			if(temp != DisplaySwitchMode_fb)
				DisplaySwitchMode_fb = temp;
		}
		if(find("LAPTOPSWMODE",s))
		{
			temp = atoi(mid(s, start, end));
			if(temp != LaptopSwitchMode_fb)
				LaptopSwitchMode_fb = temp;
		}

		if(find("PRIORDISPLAYSRC",s))
		{
			temp = atoi(mid(s, start, end));
			if(temp != DisplayPriority_fb)
				DisplayPriority_fb = temp;
		}
		if(find("PRIORLAPTOPSRC",s))
		{
			temp = atoi(mid(s, start, end));
			if(temp != LaptopPriority_fb)
				LaptopPriority_fb = temp;
		}

		if(find("PRIORSHARESRC",s))
		{
			temp = atoi(mid(s, start, end));
			if(temp != SharePriority_fb)
				SharePriority_fb = temp;
		}
		if(find("PRIORUSBHOST",s))
		{
			temp = atoi(mid(s, start, end));
			if(temp != USBPriority_fb)
				USBPriority_fb = temp;
		}			
		if(find("LAPTOP-USBC",s) && sVideoMem[1] != mid(s, start, end) )
		{	
			sVideoMem[1] = mid(s, start, end);
			USBC_Video_fb = sVideoMem[1];
		}
		if(find("LAPTOP-HDMI",s) && sVideoMem[2] != mid(s, start, end))
		{		
			sVideoMem[2] = mid(s, start, end);
			Laptop_Video_fb = sVideoMem[2];
			
		}			
		if(find("ROOMPC",s) && sVideoMem[3] != mid(s, start, end))
		{
			sVideoMem[3] = mid(s, start, end);
			RoomPC_Video_fb = sVideoMem[3];
		}
		if(find("USBC4K60EN",s))
		{
			USBC4K60EN_fb = atoi(mid(s, start, end));
		}
		if(find("CECPASSTHROUGHEN",s))
			CECPassthrough_fb = atoi(mid(s, start, end));
		if(find("AUTOHDMICECPWR",s))
			AutoHDMIcecPower_fb = atoi(mid(s, start, end));
			
		if(find("USBDEVEN0",s))
		{
			temp = atoi(mid(s, start, end));
			if(USBDevicePower_RoomPC_fb != temp)
				USBDevicePower_RoomPC_fb = temp;
		}
		if(find("USBDEVEN1",s))
		{
			temp = atoi(mid(s, start, end));
			if(USBDevicePower_LUSBc_fb != temp)
				USBDevicePower_LUSBc_fb = temp;
		}
		if(find("USBDEVEN2",s))
		{
			temp = atoi(mid(s, start, end));
			if(USBDevicePower_LHdmi_fb != temp)
				USBDevicePower_LHdmi_fb = temp;
		}
		if(find("USBDEVEN3",s))
		{
			temp = atoi(mid(s, start, end));
			if(USBDevicePower_Nohost_fb != temp)
				USBDevicePower_Nohost_fb = temp;
		}
		if(find("PRIORHOSTMEETING",s))
		{
			temp = atoi(mid(s, start, end));
			if(HostMeetingPriority_fb != temp)
				HostMeetingPriority_fb = temp;
		}
		if(find("HDBTLINK",s))
		{
			DeviceIsXT = 1;
			temp = atoi(mid(s, start, end));
			if(Link_fb != temp)
				Link_fb = temp;
		}
		if(find("HDBTCABLEL",s))
		{
			if(sLinkLenght != mid(s, start, end))
			{
				sLinkLenght = mid(s, start, end);
				LinkLength_fb = sLinkLenght;
			}
		}
								
        
		//continue !!			
	}
	else if(find("SCALER 0",mCommand))
	{
		start = find("=",s) + 1;
		end = len(s)-start-1;
		
		if(find("ENABLE",s))
			DisplayScaler_fb = atoi(mid(s, start, end));		
	}
	else if(find("SCALER 1",mCommand))
	{
		start = find("=",s) + 1;
		end = len(s)-start-1;
		
		if(find("ENABLE",s))
			ShareScaler_fb = atoi(mid(s, start, end));			
	}
	else if(find("SCALER 2",mCommand))
	{
		start = find("=",s) + 1;
		end = len(s)-start-1;
		
		if(find("ENABLE",s))
			LaptopScaler_fb = atoi(mid(s, start, end));			
	}

	

	if(iReady = 1)
	{
		if(iNextStore <> iNextSend)
		{
			SendStoreCommand(sQueue[iNextSend]);
		}
		else
		{
			fPollTimeOut();
		}

	}

		
}

//Telnet Socket management
Function CheckSocketStatus()
{
	wait(200, TelnetDelay)
	{
		if(TCPClient.SocketStatus = 2)
		{ 
			if (Debug) print("Telnet Connected clear buffer and begin polling");
			clearbuffer(TCPClient.SocketRxBuf);
			iCtrlsChanged = 1;
			iReady = 1;
			iNextSend = 1;
			iNextStore = 1;
			ReadyToPoll = 1;
			Module_Enable_dly = 1;

			SendStoreCommand("SCALER 0\x0d\x0a");
			SendStoreCommand("SCALER 1\x0d\x0a");
			SendStoreCommand("SCALER 2\x0d\x0a");
			//ReadyToPoll = 1;		
		}
		else
		{
			//TCP socket did not connect within expected time, retry
			if (Debug) print("Telnet Not connected in time, close and retry");
			SocketDisconnectClient(TCPClient);
			delay(100);
            SOCKETCONNECTCLIENT(TCPClient, IP, 23, 0);
        } 
	}	      
}
SocketStatus TCPClient
{
	TelnetSocketStatus_fb = TCPClient.SocketStatus;
	cancelwait(TelnetDelay) ;
	if(Module_Enable)
		CheckSocketStatus();  
			
}
SocketReceive TCPClient
{
	string sTCPdata[300];

	//if(DeviceConnected_fb = 0)		//throw away telnet header
	//	clearbuffer(TCPClient.SocketRxBuf);
		
	while(len(TCPClient.SocketRxBuf) > 0)
	{
		sTCPdata = Gather("\x0D\x0A",TCPClient.SocketRxBuf);
		if (Debug) print("Telnet Received= %s",sTCPdata);
		StatusParser(sTCPdata);
	}      
}


