CHANGE Module_Enable
{
	DeviceConnected_fb = 0;

	if(Module_Enable = 1)
	{
		if(CommMode = "Telnet")
		{		
			SOCKETCONNECTCLIENT(TCPClient, IP, 23, 0);
		}
		else
		{
        	iCtrlsChanged = 1;
			iReady = 1;
			iNextSend = 1;
			iNextStore = 1;
			ReadyToPoll = 1;
			Module_Enable_dly = 1;
		}
	}
	else
	{
		SocketDisconnectClient(TCPClient);
		iReady = 0;
		iNextSend = 1;
		iNextStore = 1;
		ReadyToPoll = 0;
		Module_Enable_dly = 0;
	}
	
}
