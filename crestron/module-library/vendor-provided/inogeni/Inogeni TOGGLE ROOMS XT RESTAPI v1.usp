CALLBACK FUNCTION SimplHttpsClientResponseHandler(INTEGER statusCode, STRING responseUrl, STRING messageBody, SIGNED_LONG_INTEGER contentLength)
{
	//if(debug) print("HTTPS Response received: %d, %s, %s, %d", statusCode, responseUrl, messageBody, contentLength);
	cancelwait(wTimeOut); //cancel no response timeout
	StatusParserHTTP(statusCode, messageBody, LowWord(contentLength) ); //Parse received data		
}
 
			            

FUNCTION Main()
{
	
	WaitForInitializationComplete();  
    
	DeviceConnected_fb = 0;
	
    iReady = 1;
	iNextSend = 1;
	iNextStore = 1;
	
		
	iDisplaySrc = 5;
	iUSBHost = 5;
	setarray(sQueue, "");
	
	if (CommMode = "REST API")
	{
		RegisterDelegate(HTTPSobj, SimplHttpsClientResponse, SimplHttpsClientResponseHandler);
		_url = "https://" + IP + "/api/v1/";
		_headers = "Authorization: Bearer " + APIToken; //multiple header need pipe separator
		response_content = "";	  	
	}
	/*
	DisplaySource_fb = 9;
