/*******************************************************************************************
  Functions
*******************************************************************************************/

Function fTimeOut(INTEGER fTime)
{
	wait(fTime, wTimeOut)//Wait for command response
	{
		if(Debug) print("Error No Reply from device after timeout\n");
		iReady = 1;	
		ReadyToPoll = 1;
		DeviceConnected_fb = 0;
		mCommand = "";
		iNextStore = 1;
		iNextSend = 1; //Clear send/store pointer	
					
	}
}
Function fPollTimeOut()
{
	wait(100, polldelay)//wait 1 sec before polling again
	{
		ReadyToPoll = 1;
	}
}
 
FUNCTION SendStoreCommand(STRING cmd)
{	
	if(Module_Enable_dly = 1)
	{
		cancelwait(polldelay);
		ReadyToPoll = 0;
					
	    if(iReady = 1 && iNextStore = iNextSend)
		{
			iReady = 0;
			mCommand = cmd;
			
			
			if(find("STATUS", cmd) || find("status", cmd) )
			{
				iStatusRequest = 1;
			}
			
			fTimeOut(1000); //wait for command response.			
			if(CommMode = "Serial")
			{
				//fTimeOut(400);
				Tx$ = cmd;
				if(Debug) print("Command sent : %s\n", cmd) ;
			}
			else if(CommMode = "Telnet") 	
			{
				if(tcpclient.SocketStatus = 2)
				{
					//fTimeOut(400);
					SocketSend(TCPClient, cmd);	
					if(Debug) print("Command sent : %s\n", cmd) ;

				}
			}
			else if(CommMode = "REST API") 	
			{
				//fTimeOut(500);
				//sTempSend = _url + cmd + "\r\n";
				sTempSend = _url + cmd;
				if(Debug) print("Command sent : %s\n", cmd) ;
				HTTPSobj.SendGet(sTempSend, _headers);	
			}
			

	   								
		}
		else if(iReady = 1 && iNextStore <> iNextSend)
		{
			iReady = 0;
			mCommand = sQueue[iNextSend];
			

			if(find("STATUS", sQueue[iNextSend]) || find("status", sQueue[iNextSend]) )
			{
				iStatusRequest = 1;
			}

			fTimeOut(500); //wait for command response, 5sec is enough for all protocols
			
			if(CommMode = "Serial")
			{
				//fTimeOut(200);
				Tx$ = sQueue[iNextSend];
				if(Debug) print("Command %s From memory %d", sQueue[iNextSend] , iNextSend ) ;	
				sQueue[iNextSend] = "";
				iNextSend = iNextSend + 1;
				if(iNextSend > ciQUEUESIZE)	
					iNextSend = 1;	
			}
			else if(CommMode = "Telnet") 	
			{
				if(tcpclient.SocketStatus = 2)
				{	
					//fTimeOut(200);
					SocketSend(TCPClient, sQueue[iNextSend]);
					if(Debug) print("Command %s From memory %d", sQueue[iNextSend] , iNextSend ) ;	
					sQueue[iNextSend] = "";
					iNextSend = iNextSend + 1;
					if(iNextSend > ciQUEUESIZE)	
						iNextSend = 1;		
				}				
			}	
			else if(CommMode = "REST API") 	
			{
				sTempSend = _url + sQueue[iNextSend] + "\r\n";
				//need to change memmory first to avoid sending same command again caused by SIMPL# module
				sQueue[iNextSend] = "";
				iNextSend = iNextSend + 1;
				if(iNextSend > ciQUEUESIZE)	
					iNextSend = 1;	

				//fTimeOut(500); //HTTPS client time out is 5sec.
				if(Debug) print("Command %s From memory %d", sQueue[iNextSend] , iNextSend ) ;
				HTTPSobj.SendGet(sTempSend, _headers);	
			}
				

	    }
		else
	 	{
	 	 
			sQueue[iNextStore] = cmd;
			if(debug) print("Command %s put in memory %d\n", cmd , iNextStore ) ;
			
			iNextStore = iNextStore + 1;
			if(iNextStore > ciQUEUESIZE)
			{
				iNextStore = 1;
			}
						
	    }
     }
}
 
Function Polling()
{	
    	ReadyToPoll = 0;		
		if (CommMode = "REST API")
		{	
			SendStoreCommand("status");	
			if(DeviceIsXT)
			{
				SendStoreCommand("link");
			}
		}
		else
		{
			SendStoreCommand("STATUS\x0d\x0a");
		}				
}

//REST API parsing

Integer_Function TRJSONParse(string JSONdata)
{
    string stemp2[MAX_CONTENT_STRING_LENGTH];
    signed_integer i, count, start, end;
   	string temp[255];

	// 	
   	setarray(GeneralInfo, "");
   	setarray(ConfigurationInfo, "");
   	setarray(Laptop1Info, "");
   	setarray(Laptop2Info, "");
   	setarray(RoomPCInfo, "");
   	setarray(DisplayInfo, "");
   	setarray(ShareInfo, ""); 
	setarray(LaptopInfo, ""); 

	GeneralToken[1] = "major";
	GeneralToken[2] = "minor";
	GeneralToken[3] = "hwmajor";
	GeneralToken[4] = "hwminor";
	GeneralToken[5] = "mac";
	GeneralToken[6] = "serial";
	GeneralToken[7] = "dhcp";
	GeneralToken[8] = "ip";
	GeneralToken[9] = "subnet";
	GeneralToken[10] = "gateway";
	

	ConfigurationToken[1] = "opMode";
	ConfigurationToken[2] = "usbHost";
	ConfigurationToken[3] = "displaySrc";
	ConfigurationToken[4] = "shareSrc";
	ConfigurationToken[5] = "usbHostSwMode";
	ConfigurationToken[6] = "priorUsbHost";
	ConfigurationToken[7] = "displaySrcSwMode";
	ConfigurationToken[8] = "priorDisplaySrc";
	ConfigurationToken[9] = "shareSrcSwMode";
	ConfigurationToken[10] = "priorShareSrc";
	ConfigurationToken[11] = "usbc4K60En";
	ConfigurationToken[12] = "usbcCharging";
	ConfigurationToken[13] = "gpi1Function";
	ConfigurationToken[14] = "gpi1Mode";
	ConfigurationToken[15] = "gpi2Function";
	ConfigurationToken[16] = "gpi2Mode";
	ConfigurationToken[17] = "vout";
	ConfigurationToken[18] = "baudRate";
	ConfigurationToken[19] = "telnetEn";
	ConfigurationToken[20] = "httpEn";
	ConfigurationToken[21] = "mdnsEn";
	ConfigurationToken[22] = "usbDevEn0";
	ConfigurationToken[23] = "usbDevEn1";
	ConfigurationToken[24] = "usbDevEn2";
	ConfigurationToken[25] = "usbDevEn3";
	ConfigurationToken[26] = "hdcp0";
	ConfigurationToken[27] = "hdcp1";
	ConfigurationToken[28] = "hdcp2";
	ConfigurationToken[29] = "scaler0";
	ConfigurationToken[30] = "scaler1";
	ConfigurationToken[31] = "edid0";
	ConfigurationToken[32] = "edid1";
	ConfigurationToken[33] = "edid2";
	ConfigurationToken[34] = "autoHdmiCecPwr";
	ConfigurationToken[35] = "cecPassthroughEn";
	ConfigurationToken[36] = "priorHostMeeting";
	ConfigurationToken[37] = "accessTokenEn";
	ConfigurationToken[38] = "priorLaptopSrc";
	ConfigurationToken[39] = "laptopSrcSwMode";
	ConfigurationToken[40] = "laptopSrc";
	ConfigurationToken[41] = "scaler2";


	VideoGeneralToken[1] = "resolution";
	VideoGeneralToken[2] = "colorspace";
	VideoGeneralToken[3] = "detected";
	VideoGeneralToken[4] = "colordepth";
	VideoGeneralToken[5] = "hdcp";

 
   	
						
		for( count = 1 to GetNumArrayRows(GeneralToken))
		{
			//if(Debug) Print("searching GeneralToken[%d] = %s from data", count, GeneralToken[count]);
			if(find(GeneralToken[count], JSONdata))
			{			
				start = find(GeneralToken[count], JSONdata) + len(GeneralToken[count]) + 3;
				if(find(",", JSONdata, start) < find("\x0a", JSONdata, start))
					end = find(",", JSONdata, start) - start;
				else
					end = find("\x0a", JSONdata, start) - start;
			
				temp = mid(JSONdata, start, end);
					if(find("\x22", temp))//info are in double quote
					{		
						temp = mid(temp, 2, len(temp)-2 );						
					}			
				GeneralInfo[count] = temp;
				//if(Debug) Print("GeneralInfo[%d] = %s", count, GeneralInfo[count]);
			}
			else { GeneralInfo[count] = ""; //if(Debug) Print("Not Found %s",GeneralToken[count] );
			}
		}

		for( count = 1 to GetNumArrayRows(ConfigurationToken))
		{
			//if(Debug) Print("searching ConfigurationToken[%d] = %s from data", count, ConfigurationToken[count]);
			if(find(ConfigurationToken[count], JSONdata))
			{	
				start = find(ConfigurationToken[count], JSONdata) + len(ConfigurationToken[count]) + 3;
				if(find(",", JSONdata, start) < find("\x0a", JSONdata, start))
					end = find(",", JSONdata, start) - start;
				else
					end = find("\x0a", JSONdata, start) - start;

				temp = mid(JSONdata, start, end);
					if(find("\x22", temp))//info are in double quote
					{		
						temp = mid(temp, 2, len(temp)-2 );						
					}			
				ConfigurationInfo[count] = temp;
				//if(Debug) Print("ConfigurationInfo[%d] = %s", count, ConfigurationInfo[count]);
			}
			else { ConfigurationInfo[count] = ""; //if(Debug) Print("Not Found %s",ConfigurationToken[count]);
				}
		}	


		if(find("Laptop-USBC", JSONdata ))
		{
			start = find("{",JSONdata, find("Laptop-USBC", JSONdata )) +1;
			end = find("}",JSONdata, start) - start;
			stemp2 = mid(JSONdata,start , end );


			for( count = 1 to GetNumArrayRows(VideoGeneralToken))
			{
				//if(Debug) Print("searching Laptop USB-C VideoGeneralToken[%d] = %s from data", count, VideoGeneralToken[count]);
				if(find(VideoGeneralToken[count], stemp2))
				{		
					start = find(VideoGeneralToken[count], stemp2) + len(VideoGeneralToken[count]) + 3;		
					if(find(",", stemp2, start) > 1  )
						end = find(",", stemp2, start) - start;
					else
						end = find("\x0a", stemp2, start) - start;

					temp = mid(stemp2, start, end);
						if(find("\x22", temp))//info are in double quote
						{		
							temp = mid(temp, 2, find("\x22", temp, 2)-2 );						
						}			
					Laptop1Info[count] = temp;
					//if(debug) Print("Laptop1Info[%d] = %s", count, Laptop1Info[count]);
				}
				else { Laptop1Info[count] = ""; //if(Debug) Print("Not Found %s",VideoGeneralToken[count] );
					}
			}
		
		}

		if(find("Laptop-HDMI", JSONdata ))
		{
			start = find("{",JSONdata, find("Laptop-HDMI", JSONdata ));
			end = find("}",JSONdata, start) - start +1;
			stemp2 = mid(JSONdata,start , end );

			for( count = 1 to GetNumArrayRows(VideoGeneralToken))
