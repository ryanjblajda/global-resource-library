}

PUSH Make_Smaller
{
	MakeString(To_Device$,"SIZE\x20%s\x20s\x201\x0D",Window#$);
}

PUSH Preset_1
{
    Preset#$ = "\x31";
    Wait(500, P1) To_Device$ = "WPSAVE 1\r"; 
}

Release Preset_1
{
    CancelWait(P1);
	To_Device$ = "WPLOAD 1\r";
}

