#SYMBOL_NAME "RGB Spectrum Quadview XL String Generator"
// #HINT ""
// #DEFINE_CONSTANT
// #CATEGORY "" 
// #DEFAULT_VOLATILE
#DEFAULT_NONVOLATILE
//#ENABLE_STACK_CHECKING

#HELP_BEGIN
   This module is only to be used with the RGB Spectrum
   Quadview XL Module.#
