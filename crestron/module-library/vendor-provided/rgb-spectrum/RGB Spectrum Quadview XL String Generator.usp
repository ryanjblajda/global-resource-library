/*******************************************************************************************
  Include Libraries
  (Uncomment and include additional librarys as needed)
*******************************************************************************************/
// #CRESTRON_LIBRARY ""
// #USER_LIBRARY ""

/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
DIGITAL_INPUT Input_1, Input_2, Input_3, Input_4, Src_RGB, Src_DVI, Src_YUV, Src_Composite1,
              Src_Composite2, Src_SVideo,
              Window_1, Window_2, Window_3, Window_4, Move_Up, Move_Down, Move_Left, Move_Right,
              Make_Larger, Make_Smaller, Preset_1, Preset_2, Preset_3, Preset_4, Preset_5, 
			  Preset_6, Preset_7, Preset_8, Preset_9, Preset_10, Poll_Preset_Name; 
ANALOG_INPUT Adjustment_Pixels;
// STRING_INPUT
BUFFER_INPUT Preset_Data$[30]; 

DIGITAL_OUTPUT Input_1_FB, Input_2_FB, Input_3_FB, Input_4_FB,
               Window_1_FB, Window_2_FB, Window_3_FB, Window_4_FB;  
// ANALOG_OUTPUT 
STRING_OUTPUT To_Device$, Preset_Name$; 

/*******************************************************************************************
  Structure Definitions
  (Uncomment and define structure definitions as needed)
  Note:  Be sure to initialize all declared STRING variables as needed
         For example, in Function Main: struct.myString = "";
*******************************************************************************************/
// STRUCTURE MyStruct1
// {
// };

// MyStruct1 struct;

/*******************************************************************************************
  Global Variables
  (Uncomment and declare global variables as needed)
  Note:  Be sure to initialize all declared STRING variables as needed
         For example, in Function Main: myString = "";
*******************************************************************************************/
INTEGER Semaphore, iETX;
STRING Input#$[1],Window#$[1], Preset#$[2], Temp$[30];

/*******************************************************************************************
  Functions
  (Add any additional functions here)
  Note:  Functions must be physically placed before the location in
         the code that calls them.
*******************************************************************************************/
/*******************************************************************************************
  Event Handlers
  (Uncomment and declare additional event handlers as needed)
*******************************************************************************************/

PUSH Input_1
{
    Input#$ = "\x31";
	Input_2_FB = 0;
	Input_3_FB = 0;
	Input_4_FB = 0;
	Input_1_FB = 1;

}

PUSH Input_2
{
    Input#$ = "\x32";
	Input_1_FB = 0;
	Input_3_FB = 0;
	Input_4_FB = 0;
	Input_2_FB = 1;
}

PUSH Input_3
{
    Input#$ = "\x33";
	Input_1_FB = 0;
	Input_2_FB = 0;
	Input_4_FB = 0;
	Input_3_FB = 1;
}

PUSH Input_4
{
    Input#$ = "\x34";
	Input_1_FB = 0;
	Input_2_FB = 0;
	Input_3_FB = 0;
	Input_4_FB = 1;
}

PUSH Src_RGB
{
	MakeString(To_Device$,"INSRC\x20%s\x20RGB\x0D",Input#$);
}

PUSH Src_DVI
{
	MakeString(To_Device$,"INSRC\x20%s\x20DVI\x0D",Input#$);
}

