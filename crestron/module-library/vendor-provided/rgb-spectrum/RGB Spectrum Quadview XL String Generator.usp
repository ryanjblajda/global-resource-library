	To_Device$ = "WPLOAD 10\r";
}

PUSH Poll_Preset_Name
{
	MakeString(To_Device$,"WPNAME\x20%s\x0D",Preset#$);
}

Change Preset_Data$
{
	If (Semaphore = 0)
		{
			Semaphore = 1; 
			While (Find("\x0D\x0D\x0A", Preset_Data$) > 0)
				{
					Temp$ = Remove("\x0D\x0D\x0A",Preset_Data$);
					iETX = Find("\x0A", Temp$);
            		Preset_Name$ = Mid(Temp$, 1, (iETX-3));
				}
		}
	Semaphore = 0;
}

Change Adjustment_Pixels
{
	If(Adjustment_Pixels < 21)
		MakeString(To_Device$, "SETRATE %d %d\r", Adjustment_Pixels, Adjustment_Pixels);
}

/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/

Function Main()
{
	Semaphore = 0;		
}


