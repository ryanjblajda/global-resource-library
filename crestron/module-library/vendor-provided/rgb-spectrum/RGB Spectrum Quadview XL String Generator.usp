}

PUSH Src_SVideo
{
	MakeString(To_Device$,"INSRC\x20%s\x20SVIDEO\x0D",Input#$);
}

PUSH Window_1
{
    Window#$ = "\x31";
	Window_2_FB = 0;
	Window_3_FB = 0;
	Window_4_FB = 0;
	Window_1_FB = 1;
}

