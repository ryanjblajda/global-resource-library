PUSH High_Sensitivity_On 
{
  Camera.ExposureHighSensitivity(InstanceName, "On");  
}

PUSH High_Sensitivity_Off 
{
  Camera.ExposureHighSensitivity(InstanceName, "Off");  
}

PUSH Slow_Shutter_On 
