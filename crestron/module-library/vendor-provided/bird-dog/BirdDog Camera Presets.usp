//
// String Functions
//  

CHANGE Dynamic_IP 
{
  if(Dynamic_IP <> "") {
    Camera.init(Dynamic_IP, Control_Port, PTZ_Port);
  } else {
    Camera.init(IP_Address, Control_Port, PTZ_Port);
  } 
}

CHANGE Freed_IP 
{
  if(Freed_IP <> "") {
    Camera.init(Freed_IP, Control_Port, PTZ_Port);
  } else {
    Camera.init(IP_Address, Control_Port, PTZ_Port);
  } 
}


/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/
Function Main()
{
  WaitForInitializationComplete();
  InstanceName = GetSymbolInstanceName();
  module_enabled = 0;
  

  init();
}

                    
