PUSH Exposure_Compensation_Off 
{
  Camera.ExposureCompensation(InstanceName, "Off");
}

//
// Presets
//

PUSH Preset_Save 
{ 
  Camera.SavePreset(preset);
}

PUSH Preset_Load 
{
  Camera.RecallPreset(preset);
}

