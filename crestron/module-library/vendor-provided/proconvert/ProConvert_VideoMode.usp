/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
DIGITAL_INPUT _skip_,Enable_Debug,Get_Supported_Video_Modes;
ANALOG_INPUT _skip_,Width, Height;
DIGITAL_INPUT Interlaced;
STRING_INPUT Field_Rate[256], Aspect_Ratio[256];
DIGITAL_INPUT _skip_,Set_Video_Mode;
DIGITAL_INPUT _skip_,Set_Video_Mode_By_Index[150,150];
// ANALOG_INPUT 
STRING_INPUT _skip_,Cookie[256];
// BUFFER_INPUT 

// DIGITAL_OUTPUT 
// ANALOG_OUTPUT 
DIGITAL_OUTPUT _skip_,Video_Mode_Selected[150], _skip_, Video_Mode_Visible[150,150];
ANALOG_OUTPUT _skip_,Status;
ANALOG_OUTPUT _skip_, Video_Mode_Count, Video_Mode_Pref_Index, Video_Mode_Curr_Index;
STRING_OUTPUT Test;
STRING_OUTPUT _skip_, Video_Mode_Names[150,150];

MainProg magewell;

STRING_PARAMETER HostIp[16];

#BEGIN_PARAMETER_PROPERTIES HostIp   
	propValidUnits = unitString;
   	propDefaultUnit = unitString;
   	propDefaultValue = "58.213.29.2:50080";
#END_PARAMETER_PROPERTIES

// INTEGER
// LONG_INTEGER
// SIGNED_INTEGER
// SIGNED_LONG_INTEGER
// STRING

Callback Function SupportedVideoModeFunc(SupportVideoModeArg arg)
{
    string videoModeName[256];
	integer i, videoModeCount; 
    videoModeCount = arg.GetVideoModeCount();
    Video_Mode_Pref_Index = -1;
    Video_Mode_Curr_Index = -1;
    Video_Mode_Count = videoModeCount;
   	for(i=1 to 150)
  	{
        if(i-1<Video_Mode_Count)
        { 
            videoModeName = ItoA(arg.widths[i-1]);
            videoModeName = videoModeName + "x";
            videoModeName = videoModeName + ItoA(arg.heights[i-1]);
            videoModeName = videoModeName + " ";
            videoModeName = videoModeName + magewell.sGetFieldRateString(i-1);
            if(arg.interlaceds[i-1]!=0)
            {
                videoModeName = videoModeName + "i ";
            }
            else
            {
                videoModeName = videoModeName + "p ";
            }
            videoModeName = videoModeName + magewell.sGetAspectRatioString(i-1);
            Video_Mode_Names[i] = videoModeName;
            if(arg.prefModes[i-1]!=0)
            {
                if(Video_Mode_Pref_Index!=i-1)
                {
                    Video_Mode_Pref_Index = i-1;
                }
            }
            if(arg.currModes[i-1]!=0)
            {
                if(Video_Mode_Curr_Index!=i-1)
                {
                    Video_Mode_Curr_Index = i-1;
                }
            }
        }
        else
        {
            Video_Mode_Names[i]="";
        }
	}
}
                
PUSH Enable_Debug
{
	magewell.pDebugging = Enable_Debug;
}
         
PUSH Get_Supported_Video_Modes
{
    integer i;
	Status = magewell.sGetSupportedVideoModes();
    if(Status=0)
	{
        for(i=1 to 150)
	    {
            if(i-1<Video_Mode_Count)
            {
                Video_Mode_Visible[i] = 1;
            }
            else
            {
                Video_Mode_Visible[i] = 0;
            }
            if(i-1<Video_Mode_Count && i-1=Video_Mode_Curr_Index)
            {
                Video_Mode_Selected[i] = 1;
            }
            else
            {
        	    Video_Mode_Selected[i] = 0;
            }
        }
  	}
    else
    {
        for(i=1 to 150)
        { 
            Video_Mode_Visible[i] = 0;
  	        Video_Mode_Selected[i] = 0;
        }
    }
}

PUSH Set_Video_Mode_By_Index
{
    integer i;  
    Status = magewell.sSetVideoModeByIndex(GetLastModifiedArrayIndex()-1);
    if(Status=0)
    {
    	Status = magewell.sGetSupportedVideoModes();
        if(Status=0)
    	{
            for(i=1 to 150)
	        {
                if(i-1<Video_Mode_Count && i-1=Video_Mode_Curr_Index)
                {
                    Video_Mode_Selected[i] = 1;
                }
                else
                {
        	        Video_Mode_Selected[i] = 0;
                }
          	}
        }
    }
}

CHANGE Cookie
{
    magewell.sSetApiCookie(Cookie);
}
 
CHANGE Set_Video_Mode
{
    integer i;
	Status = magewell.sSetVideoMode(Width, Height, Interlaced, Field_Rate, Aspect_Ratio);
    if(Status=0)
    {
    	Status = magewell.sGetSupportedVideoModes();
        if(Status=0)
    	{
            for(i=1 to 150)
	        { 
                if(i-1<Video_Mode_Count && i-1=Video_Mode_Curr_Index)
                {
                    Video_Mode_Selected[i] = 1;
                }
                else
                {
            	    Video_Mode_Selected[i] = 0;
                }
          	}
        }
    }
}

Function Main()
{
    integer i, ret;
    integer pageStartIndex;
	Delay ( 100 );
	
	magewell.pDebugging = 1;
		
	magewell.pHostIp = HostIp;
	
	RegisterDelegate ( magewell , SupportedVideoModeCallBack , SupportedVideoModeFunc ); 
    while(1)
    { 
    	ret = magewell.sGetSupportedVideoModes();
        if(ret=0)
    	{
            for(i=1 to 150)
        	{
                if(i-1<Video_Mode_Count)
                {
                    Video_Mode_Visible[i] = 1;
                }
                else
                {
                    Video_Mode_Visible[i] = 0;
                }
                if(i-1<Video_Mode_Count && i-1=Video_Mode_Curr_Index)
                {
                    Video_Mode_Selected[i] = 1;
                }
                else
                {
            	    Video_Mode_Selected[i] = 0;
                }
            }
        }
       	Delay ( 100 );
    }
}
