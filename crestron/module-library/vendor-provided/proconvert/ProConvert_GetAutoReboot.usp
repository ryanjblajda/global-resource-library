/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
DIGITAL_INPUT _skip_,Enable_Debug, GetAutoReboot;
DIGITAL_INPUT AutoReboot_Enable_Input;
STRING_INPUT _skip_,Cookie[256];

DIGITAL_OUTPUT _skip_,AutoReboot_Enabled_Output;
ANALOG_OUTPUT _skip_,Status;
ANALOG_OUTPUT AutoReboot_Hour_Output, AutoReboot_Min_Output, AutoReboot_WeekFlags_Output;

MainProg magewell;

STRING_PARAMETER HostIp[16];

#BEGIN_PARAMETER_PROPERTIES HostIp   
	propValidUnits = unitString;
   	propDefaultUnit = unitString;
   	propDefaultValue = "58.213.29.2:50080";
#END_PARAMETER_PROPERTIES

// INTEGER
// LONG_INTEGER
// SIGNED_INTEGER
// SIGNED_LONG_INTEGER
// STRING

Callback Function AutoRebootFunc(AutoRebootArg arg)
{
    AutoReboot_Enabled_Output = arg.IsEnable();
    AutoReboot_Hour_Output = arg.GetHour();
    AutoReboot_Min_Output = arg.GetMin();
    AutoReboot_WeekFlags_Output = arg.GetWeekFlags();
}

PUSH Enable_Debug
{
	magewell.pDebugging = Enable_Debug;
} 

PUSH AutoReboot_Enable_Input
{
    AutoReboot_Enabled_Output = !AutoReboot_Enabled_Output;
}

PUSH GetAutoReboot
{
	magewell.sGetAutoReboot();
}

CHANGE Cookie
{
    magewell.sSetApiCookie(Cookie);
}

Function Main()
{	
    Delay ( 100 );
	
	magewell.pDebugging = 1;
		
	magewell.pHostIp = HostIp;
    RegisterDelegate ( magewell,  AutoRebootCallBack, AutoRebootFunc );
}

