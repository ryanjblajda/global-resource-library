/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
DIGITAL_INPUT _skip_,_skip_,Enable_Debug,Get_Users, Add_User, Del_User, Change_Password;
DIGITAL_INPUT _skip_,Set_Password_By_Index[150];
DIGITAL_INPUT _skip_,Del_User_By_Index[150, 150];
// ANALOG_INPUT 
STRING_INPUT _skip_,Cookie[256];
STRING_INPUT _skip_, Id[256], Password[256], New_Password[256];
// BUFFER_INPUT 

// DIGITAL_OUTPUT 
// ANALOG_OUTPUT 
DIGITAL_OUTPUT _skip_, User_Visible[150,150];
ANALOG_OUTPUT _skip_,Status;
ANALOG_OUTPUT _skip_,User_Count;
STRING_OUTPUT _skip_,User_Id[150],_skip_,User_Group[150,150];

MainProg magewell;

STRING_PARAMETER HostIp[16];

#BEGIN_PARAMETER_PROPERTIES HostIp   
	propValidUnits = unitString;
   	propDefaultUnit = unitString;
   	propDefaultValue = "58.213.29.2:50080";
#END_PARAMETER_PROPERTIES

// INTEGER
// LONG_INTEGER
// SIGNED_INTEGER
// SIGNED_LONG_INTEGER
// STRING

Callback Function UserFunction(UserArg arg)
{
	integer i, userCount; 
    userCount = arg.GetUserCount();

    User_Count = arg.GetUserCount(); 

	for(i=1 to 150)
	{
        if(i-1<userCount)
        {
      	    User_Id[i] = arg.GetId(i-1);
            User_Group[i] = arg.GetGroup(i-1);
        }
        else
        {
    	    User_Id[i] = "";
    	   	User_Group[i] = "";
        } 
    }
}
                
PUSH Enable_Debug
{
	magewell.pDebugging = Enable_Debug;
}
         
PUSH Get_Users
{
    integer i;	
    Status = magewell.sGetUsers(); 
    if(Status=0)
	{	
        for(i=1 to 150)
	    {
            if(i-1<User_Count)
            {
                User_Visible[i] = 1;
            }
            else
            {
                User_Visible[i] = 0;
            } 
        }
   	}
    else
    {
        for(i=1 to 150)
	    { 
            User_Visible[i] = 0; 
        }
    }
}

PUSH Add_User
{
    integer i; 
    Status = magewell.sAddUser(Id, Password);
    //Reset the user list.
	Status = magewell.sGetUsers();  
    if(Status=0)
	{	
        for(i=1 to 150)
	    {
            if(i-1<User_Count)
            {
                User_Visible[i] = 1;
            }
            else
            {
                User_Visible[i] = 0;
            }
        }
   	}
    else
    {
        for(i=1 to 150)
	    { 
            User_Visible[i] = 0; 
        }
    }
}

PUSH Change_Password
{
    Status = magewell.sChangePassword(Password, New_Password);
}
                    
PUSH Del_User
{
    integer i; 
    Status = magewell.sDelUser(Id);
    //Reset the user list.
	Status = magewell.sGetUsers();
    if(Status=0)
	{	
        for(i=1 to 150)
        {
            if(i-1<User_Count)
            {
                User_Visible[i] = 1;
            }
            else
            {
                User_Visible[i] = 0;
            }
        }
   	}
    else
    {
	    for(i=1 to 150)  
        { 
            User_Visible[i] = 0;
        } 
    }
}
                        
PUSH Set_Password_By_Index
{
    Status = magewell.sSetPasswordByIndex(GetLastModifiedArrayIndex()-1, Password); 
}

PUSH Del_User_By_Index
{
    integer i;
    Status = magewell.sDelUserByIndex(GetLastModifiedArrayIndex()-1);
    //Reset the user list.
	Status = magewell.sGetUsers();
    if(Status=0)
	{	
        for(i=1 to 150)
        {
            if(i-1<User_Count)
            {
                User_Visible[i] = 1;
            }
            else
            {
                User_Visible[i] = 0;
            }
        }
   	}
    else
    {
	    for(i=1 to 150)  
        { 
            User_Visible[i] = 0;
        } 
    }
}

CHANGE Cookie
{
    magewell.sSetApiCookie(Cookie);
}
 
Function Main()
{
    integer i, ret;	
    Delay ( 100 );
	
	magewell.pDebugging = 1;
		
	magewell.pHostIp = HostIp;	

	RegisterDelegate ( magewell , UserCallBack , UserFunction ); 

    while(1)
    {    
        //Reset the user list.
    	ret = magewell.sGetUsers();
        if(ret=0)
    	{
            for(i=1 to 150)
            {
                if(i-1<User_Count)
                {
                    User_Visible[i] = 1;
                }
                else
                {
                    User_Visible[i] = 0;
                }
            }
       	}
        else
        {
    	    for(i=1 to 150)  
            { 
                User_Visible[i] = 0;
            } 
        }
      	Delay ( 100 );
    }
}
