/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
DIGITAL_INPUT _skip_,Enable_Debug,Get_Audio_Config;
DIGITAL_INPUT _skip_, Check_Pts_Input;
STRING_INPUT _skip_,Cookie[256];

ANALOG_OUTPUT _skip_, Status;
STRING_OUTPUT _skip_, Gain_Output, SampleRate_Output; 
ANALOG_OUTPUT _skip_, Channels_Output, BitCount_Output, Ch0_Output, Ch1_Output, Ch2_Output, Ch3_Output, Ch4_Output, Ch5_Output, Ch6_Output, Ch7_Output, Ch8_Output, Ch9_Output, Ch10_Output, Ch11_Output, Ch12_Output, Ch13_Output, Ch14_Output, Ch15_Output;
DIGITAL_OUTPUT _skip_, Check_Pts_Output;

MainProg magewell;

STRING_PARAMETER HostIp[16];

#BEGIN_PARAMETER_PROPERTIES HostIp   
	propValidUnits = unitString;
   	propDefaultUnit = unitString;
   	propDefaultValue = "58.213.29.2:50080";
#END_PARAMETER_PROPERTIES

// INTEGER
// LONG_INTEGER
// SIGNED_INTEGER
// SIGNED_LONG_INTEGER
// STRING

Callback Function AudioConfigFunc(AudioConfigArg arg)
{   
    Gain_Output = arg.gain;
    SampleRate_Output = arg.sampleRate;
    Channels_Output = arg.channels;
    BitCount_Output = arg.bitCount;
    Ch0_Output = arg.ch0;
    Ch1_Output = arg.ch1;
    Ch2_Output = arg.ch2;
    Ch3_Output = arg.ch3;
    Ch4_Output = arg.ch4;
    Ch5_Output = arg.ch5;
    Ch6_Output = arg.ch6;
    Ch7_Output = arg.ch7;
    Ch8_Output = arg.ch8;
    Ch9_Output = arg.ch9;
    Ch10_Output = arg.ch10;
    Ch11_Output = arg.ch11;
    Ch12_Output = arg.ch12;
    Ch13_Output = arg.ch13;
    Ch14_Output = arg.ch14;
    Ch15_Output = arg.ch15;
    Check_Pts_Output = arg.checkPts;
}

PUSH Enable_Debug
{
	magewell.pDebugging = Enable_Debug;
}
PUSH Check_Pts_Input
{
    Check_Pts_Output = !Check_Pts_Output;
}

PUSH Get_Audio_Config
{
    Status = magewell.sGetAudioConfig();
}
CHANGE Cookie
{
    magewell.sSetApiCookie(Cookie);
}

Function Main()
{	
    Delay ( 100 );
	
	magewell.pDebugging = 1;
		
	magewell.pHostIp = HostIp; 

    RegisterDelegate ( magewell,  AudioConfigCallBack, AudioConfigFunc );
}

