/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
DIGITAL_INPUT _skip_,Enable_Debug,Get_Caps;
STRING_INPUT _skip_,Cookie[256];

DIGITAL_OUTPUT _skip_,Has_Input, Has_Output, Has_Loop_Through, Has_Fan, Has_Input_EDID, Has_Output_EDID, Has_SDCard, Has_PTZ, Has_NDI, Has_Alpha_Disp_Mode;
ANALOG_OUTPUT _skip_,Status, Max_Input_Width, Max_Input_Height, Max_Output_Width, Max_Output_Height;

MainProg magewell;

STRING_PARAMETER HostIp[16];

#BEGIN_PARAMETER_PROPERTIES HostIp   
	propValidUnits = unitString;
   	propDefaultUnit = unitString;
   	propDefaultValue = "58.213.29.2:50080";
#END_PARAMETER_PROPERTIES

// INTEGER
// LONG_INTEGER
// SIGNED_INTEGER
// SIGNED_LONG_INTEGER
// STRING

Callback Function GetCapsFunc(CapsArg arg)
{   
    Max_Input_Width = arg.GetMaxInputWidth();
    Max_Input_Height = arg.GetMaxInputHeight();
    Max_Output_Width = arg.GetMaxOutputWidth();
    Max_Output_Height = arg.GetMaxOutputHeight();
    Has_Input = arg.GetHasInput();
    Has_Output = arg.GetHasOutput();
    Has_Loop_Through = arg.GetHasLoopThrough();
    Has_Fan = arg.GetHasFan();
    Has_Input_EDID = arg.GetHasInputEdid();
    Has_Output_EDID = arg.GetHasOutputEdid();
    Has_SDCard = arg.GetHasSdcard();
    Has_PTZ = arg.GetHasPtz();
    Has_NDI = arg.GetHasNdi();
    Has_Alpha_Disp_Mode = arg.GetHasAlphaDispMode();
}

PUSH Enable_Debug
{
	magewell.pDebugging = Enable_Debug;
}
PUSH Get_Caps
{
    Status = magewell.sGetCaps();
}

CHANGE Cookie
{
    magewell.sSetApiCookie(Cookie);
}

Function Main()
{	
    Delay ( 100 );
	
	magewell.pDebugging = 1;
		
	magewell.pHostIp = HostIp; 

    RegisterDelegate ( magewell,  GetCapsCallBack, GetCapsFunc );
}

