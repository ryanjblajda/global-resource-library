/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
DIGITAL_INPUT _skip_,Enable_Debug,Reset_Video_Config;
STRING_INPUT _skip_,Cookie[256];

DIGITAL_OUTPUT _skip_,Show_Title, Show_Tally, Show_VuMeter;
ANALOG_OUTPUT _skip_, Status;
STRING_OUTPUT _skip_, VuMeter_Mode;
DIGITAL_OUTPUT Show_Center_Cross; 
STRING_OUTPUT Safe_Area_Mode, Ident_Mode, Ident_Text;
DIGITAL_OUTPUT HFlip ,VFlip; 
STRING_OUTPUT Switch_Mode, Deinterlace_Mode;
DIGITAL_OUTPUT In_Auto_Color_Fmt;
STRING_OUTPUT In_Color_Fmt, Ar_Convert_Mode, Alpha_Disp_Mode; 

MainProg magewell;

STRING_PARAMETER HostIp[16];

#BEGIN_PARAMETER_PROPERTIES HostIp   
	propValidUnits = unitString;
   	propDefaultUnit = unitString;
   	propDefaultValue = "58.213.29.2:50080";
#END_PARAMETER_PROPERTIES

// INTEGER
// LONG_INTEGER
// SIGNED_INTEGER
// SIGNED_LONG_INTEGER
// STRING

Callback Function ResetVideoConfigFunc(ResetVideoConfigArg arg)
{   
    Show_Title = arg.showTitle;
    Show_Tally = arg.showTally;
    Show_VuMeter = arg.showVuMeter;
    VuMeter_Mode = arg.vuMeterMode;
    Show_Center_Cross = arg.showCenterCross;
    Safe_Area_Mode = arg.safeAreaMode;
    Ident_Mode = arg.identMode;
    Ident_Text = arg.identText;
    HFlip = arg.hFlip;
    VFlip = arg.vFlip; 
    Switch_Mode = arg.switchMode;
    Deinterlace_Mode = arg.deinterlaceMode;
    In_Auto_Color_Fmt = arg.inAutoColorFmt;
    In_Color_Fmt = arg.inColorFmt;
    Ar_Convert_Mode = arg.arConvertMode;
    Alpha_Disp_Mode = arg.alphaDispMode;
}

PUSH Enable_Debug
{
	magewell.pDebugging = Enable_Debug;
}
PUSH Reset_Video_Config
{
    Status = magewell.sResetVideoConfig();
}

CHANGE Cookie
{
    magewell.sSetApiCookie(Cookie);
}

Function Main()
{	
    Delay ( 100 );
	
	magewell.pDebugging = 1;
		
	magewell.pHostIp = HostIp; 

    RegisterDelegate ( magewell,  ResetVideoConfigCallBack, ResetVideoConfigFunc );
}

