Function Racklink_ContactOn(INTEGER contactID)
{
	STRING data[6];

	MakeString(data,"%s%s0000",CHR(contactID),CHR(RL_CS_ON));

	RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_DRY_CONTACTS, RL_SUB_SET, data));
}

Function Racklink_ContactOff(INTEGER contactID)
{
	STRING data[6];

	MakeString(data,"%s%s0000",CHR(contactID),CHR(RL_CS_OFF));

	RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_DRY_CONTACTS, RL_SUB_SET, data));
}

Function Racklink_ContactCycle(INTEGER contactID)
{
	INTEGER cycleTime;
	STRING data[6];

	cycleTime = POWER_CYCLE_TIME;

	IF (cycleTime = 0 || cycleTime > 3600)
		cycleTime = 1;

	MakeString(data,"%s%s%04d", CHR(contactID), CHR(RL_CS_CYCLE), cycleTime);

	RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_DRY_CONTACTS, RL_SUB_SET, data));
}

Function Racklink_ContactNameSet(INTEGER contactID, STRING name)
{
	STRING sValue[MAX_NAME_SIZE];

	IF (contactID > 0 && contactID <= MAX_OUTLETS)
	{
		MakeString(sValue, "%s%s", CHR(contactID), name);

		RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_DRY_CONTACTS_NAME, RL_SUB_SET, sValue));
	}
}

////////////////////////////////////////////////////////////
// POWER SEQUENCING
////////////////////////////////////////////////////////////
Function Racklink_PowerSequenceUp()
{
	STRING data[5];
	INTEGER powerSeqTime;

	powerSeqTime = POWER_SEQ_TIME;

	IF (powerSeqTime < 1 || powerSeqTime > 999)
		powerSeqTime = 1;

	MakeString(data,"%s%04d",CHR(RL_PWRSEQ_UP), powerSeqTime);
	
	RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_SEQUENCE_POWER_OUTLETS, RL_SUB_SET, data));
}

Function Racklink_PowerSequenceDown()
{
	STRING data[5];
	INTEGER powerSeqTime;

	powerSeqTime = POWER_SEQ_TIME;

	IF (powerSeqTime < 1 || powerSeqTime > 999)
		powerSeqTime = 1;

	MakeString(data,"%s%04d",CHR(RL_PWRSEQ_DN), powerSeqTime);
	
	RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_SEQUENCE_POWER_OUTLETS, RL_SUB_SET, data));
}

////////////////////////////////////////////////////////////
// EMERGENCY POWER OPERATE MODE (EPO)
////////////////////////////////////////////////////////////
Function Racklink_EPOInit()
{
	RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_EMERGENCY_POWER_OFF, RL_SUB_SET, CHR(RL_EPO_INIT)));
}

Function Racklink_EPORecover()
{	
	RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_EMERGENCY_POWER_OFF, RL_SUB_SET, CHR(RL_EPO_RECOVER)));
}

////////////////////////////////////////////////////////////
// ROOM OCCUPANCY
////////////////////////////////////////////////////////////
Function Racklink_Set_Occupied()
{
	RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_CURRENT_OCCUPANCY_STATE, RL_SUB_SET, RL_OCCUPIED));
}

Function Racklink_Set_Unoccupied()
{	
	RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_CURRENT_OCCUPANCY_STATE, RL_SUB_SET, RL_UNOCCUPIED));
}
  
/*******************************************************************************************
  Event Handlers
  (Uncomment and declare additional event handlers as needed)
*******************************************************************************************/
////////////////////////////////////////////////////////////
// CONNECT CONTROL
////////////////////////////////////////////////////////////
PUSH CONNECT
{
	IF (isHeartBeatRunning = FALSE)
	{
		RackLink_StartHeartBeat();
	}
}

PUSH DISCONNECT
{
	STRING statusChange[6];

	IF (isHeartBeatRunning = TRUE)
	{
		resetQueue();
		CANCELWAIT (heartbeat);
		isHeartBeatRunning = FALSE;
		IS_COMMUNICATING_FB = FALSE;
		isLoggedIn = FALSE;
		isIntialized = FALSE;

		MakeString(statusChange,"%s%s%s%s%s%s",CHR(0x00),CHR(0x00),CHR(0x00),CHR(0x00),CHR(0x00),CHR(0x00));
		RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_REG_STATUS_CHANGE, RL_SUB_SET, statusChange));
                                                                                                

		MakeString(statusChange,"%s%s",CHR(0x00),CHR(0x00));
		RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_REG_LOG_ALERTS, RL_SUB_SET, statusChange));
	}
}

