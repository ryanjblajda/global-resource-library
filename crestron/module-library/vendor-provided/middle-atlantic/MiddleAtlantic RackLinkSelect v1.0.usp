////////////////////////////////////////////////////////////
// stringTokenizer
////////////////////////////////////////////////////////////                                
Integer_Function stringTokenizer(STRING tokenList[], STRING stringMsg, STRING delimiter)
{
	INTEGER nStartLocation;
	INTEGER nFoundLocation;
	INTEGER item;

	item = 0;

	nStartLocation = 1;

	WHILE (TRUE)
	{
		nFoundLocation = FIND(delimiter, stringMsg, nStartLocation);

		IF (nFoundLocation = 0)
			break;

		item = item + 1;

		tokenList[item] = MID(stringMsg, nStartLocation, nFoundLocation - nStartLocation);

		nStartLocation = nFoundLocation + LEN(delimiter);	
	}

	IF (nStartLocation <= LEN(stringMsg))
	{
		item = item + 1;

		tokenList[item] = MID(stringMsg, nStartLocation, (LEN(stringMsg) - nStartLocation) + 1);
	}
                                                       
	return (item);
}
 
////////////////////////////////////////////////////////////
// stringReplace
////////////////////////////////////////////////////////////
String_Function stringReplace(STRING stringMsg, STRING search, STRING replace)
{
	INTEGER X;
	STRING response[MAX_MSG_SIZE];
    
	INTEGER tokenCount;
    STRING tokens[MAX_TOKENS][MAX_TOKEN_LENGTH];
	
	tokenCount = stringTokenizer(tokens, stringMsg, search);

	response = "";

	IF (tokenCount > 0)
	{
		FOR (X = 1 TO tokenCount)
		{
			IF (X < tokenCount)
				MakeString(response,"%s%s%s",response,tokens[X],replace);	
			ELSE
				MakeString(response,"%s%s",response,tokens[X]);	
		}
	}
   
	return (response);
}
  
////////////////////////////////////////////////////////////
// cleanFloat
////////////////////////////////////////////////////////////
String_Function cleanFloat(String float)
{
	STRING response[MAX_NAME_SIZE];

	INTEGER tokenCount;
    STRING tokens[MAX_TOKENS][MAX_TOKEN_LENGTH];

	tokenCount = stringTokenizer(tokens, float, ".");

	response = "0";
                   
	// is float? XXXX.X
	IF (tokenCount = 2)
	{
     	MakeString(response,"%d.%d",ATOI(tokens[1]),ATOI(tokens[2]));
	}

	RETURN (response);
}

////////////////////////////////////////////////////////////
// cleanInteger
////////////////////////////////////////////////////////////
String_Function cleanInteger(String int)
{
	RETURN (ITOA(ATOI(int)));
}

////////////////////////////////////////////////////////////
// EMS State Helper Methods
////////////////////////////////////////////////////////////
String_Function getEMSState_MsgValue(INTEGER state)
{
	STRING response[1];

	SWITCH (state)
	{	
		// Off
		CASE (1):
		{
			response = "O";
		}
		// On
		CASE (2):
		{
			response = "I";
		}
		// Standby
		CASE (3):
		{
			response = "S";
		}
		// Disconnected
		CASE (4):
		{
			response = "D";
		}
		// Unknown
		DEFAULT:
		{
			response = "U";
		}
	}

	RETURN (response);
}

String_Function getEMSState_Text(INTEGER state)
{
	STRING response[MAX_NAME_SIZE];

	SWITCH (state)
	{	
		// Off
		CASE (1):
		{
			response = "Off";
		}
		// On
		CASE (2):
		{
			response = "On";
		}
		// Standby
		CASE (3):
		{
			response = "Standby";
		}
		// Disconnected
		CASE (4):
		{
			response = "Disconnected";
		}
		// Unknown
		DEFAULT:
		{
			response = "Unknown";
		}
	}

	RETURN (response);
}

Integer_Function getEMSState_Value(STRING state)
{
	INTEGER response;

	IF (state = "O")
		response = 1;
	ELSE IF (state = "I")
		response = 2;
	ELSE IF (state = "S")
		response = 3;
	ELSE IF (state = "D")
		response = 4;
	ELSE
		response = 0;

	RETURN (response);
}
 
////////////////////////////////////////////////////////////
// deQueue
////////////////////////////////////////////////////////////
Function deQueue()
{
	STRING msg[MAX_MSG_SIZE];
	INTEGER responseTime;
	INTEGER logRequestID;

	IF (LEN(queue) > 0 || LEN(queueLowPriority) > 0)
	{
		IF (queueIsBusy = FALSE)
		{
			queueIsBusy = TRUE;
                                         
			IF (LEN(queue) > 0)	
				msg = REMOVE(CHR(TAIL), queue);
			ELSE
				msg = REMOVE(CHR(TAIL), queueLowPriority);

			responseTime = 100;

			// MSG CONTACTS REQUESTID
			IF (BYTE(msg,1) != HEADER)
				logRequestID = BYTE(RemoveByLength(1, msg), 1);

			// LOG ENTRY? GIVE IT ALOT OF TIME!
			//IF (BYTE(msg, 4) = RL_CMD_LOG_ENTRY)
			//	responseTime = 3000;
              
			WAIT (500, commTimeoutQueue)
				IS_COMMUNICATING_FB = FALSE;

			WAIT (responseTime, falseResponse)
			{	
				queueIsBusy = FALSE;
				deQueue();
			}
                                   
			// Send Message!
			MakeString(comTX$,"%s", msg);
		}
	}
}
 
////////////////////////////////////////////////////////////
// enQueue
////////////////////////////////////////////////////////////
Function enQueue(STRING msg, INTEGER requestID)
{
	IF (LEN(queue) > 0 || LEN(queueLowPriority) > 0)
	{
		MakeString(queue,"%s%s%s", queue, CHR(requestID), msg);
    }                  
    ELSE
	{
		MakeString(queue,"%s%s%s", queue, CHR(requestID), msg);

		IF (queueIsBusy = FALSE)
			deQueue();
	}
}

Function enQueueLowPriority(STRING msg, INTEGER requestID)
{
	IF (LEN(queue) > 0 || LEN(queueLowPriority) > 0)
	{
		MakeString(queueLowPriority,"%s%s%s", queueLowPriority, CHR(requestID), msg);
    }                  
    ELSE
	{
		MakeString(queueLowPriority,"%s%s%s", queueLowPriority, CHR(requestID), msg);

		IF (queueIsBusy = FALSE)
			deQueue();
	}
}

////////////////////////////////////////////////////////////
// resetQueue
////////////////////////////////////////////////////////////
Function resetQueue()
{
	CANCELWAIT (commTimeoutQueue);
	CANCELWAIT(falseResponse);
	queue = "";
	queueIsBusy = FALSE;
}

////////////////////////////////////////////////////////////
// goodResponse
////////////////////////////////////////////////////////////
Function goodResponse()
{
	IF (isLoggedIn = TRUE)
		IS_COMMUNICATING_FB = TRUE;

	CANCELWAIT (falseResponse);
	queueIsBusy = false;
	deQueue();
}

////////////////////////////////////////////////////////////
// RackLink_CalcChecksum
////////////////////////////////////////////////////////////
Integer_Function RackLink_CalcChecksum(STRING msg)
{
    INTEGER cs;
	INTEGER x;
	INTEGER nByte;

	cs = 0;

	FOR (X = 1 TO LEN(msg))
	{
 		nByte = BYTE(MID(msg, X ,1), 1);

		cs = ((cs + nByte) % 0x80);
	}

	Return (cs);
}
  
////////////////////////////////////////////////////////////
// RackLink_EscapeMessage
////////////////////////////////////////////////////////////
String_Function RackLink_EscapeMessage(STRING msg)
{
	INTEGER x;
	INTEGER nByte;
	STRING escapedMessage[MAX_MSG_SIZE];

	FOR (x = 1 to LEN(msg))
	{
		nByte = BYTE(MID(msg, X ,1), 1);
       
		IF (nByte = HEADER || nByte = TAIL || nByte = ESCAPE)
			MakeString(escapedMessage,"%s%s%s",escapedMessage,CHR(ESCAPE),CHR(NOT(nByte)));
		ELSE       
			MakeString(escapedMessage,"%s%s",escapedMessage,CHR(nByte));
    }

	Return (escapedMessage);
}

////////////////////////////////////////////////////////////
// RackLink_UnescapeMessage
////////////////////////////////////////////////////////////
String_Function RackLink_UnescapeMessage(STRING msg)
{
	INTEGER x;
	INTEGER nByte;
	INTEGER escapeByte;
	STRING unescapedMessage[MAX_MSG_SIZE];

	FOR (x = 1 to LEN(msg))
	{
		nByte = BYTE(MID(msg, X ,1), 1);

		IF (nByte = ESCAPE)
			escapeByte = TRUE;
		ELSE
		{
			IF (escapeByte = TRUE)
				MakeString(unescapedMessage,"%s%s",unescapedMessage, CHR(NOT(nByte)));
			ELSE
				MakeString(unescapedMessage,"%s%s",unescapedMessage, CHR(nByte));

			escapeByte = FALSE;
		}        
	}

	Return (unescapedMessage);
}
  
////////////////////////////////////////////////////////////
// RackLink_CreateMessage
////////////////////////////////////////////////////////////
String_Function RackLink_CreateMessage(INTEGER cmd, INTEGER subCmd, STRING data)
{
	INTEGER length;
	INTEGER cs;
	STRING finalMessage[MAX_MSG_SIZE];
	STRING tMsg[MAX_MSG_SIZE];

	MakeString(finalMessage,"%s%s%s%s",CHR(RL_ADD_GLOBAL), CHR(cmd), CHR(subCmd), data);

	length = LEN(finalMessage);

	MakeString(finalMessage,"%s%s",CHR(length), finalMessage);

	MakeString(tMsg,"%s%s",CHR(HEADER), finalMessage);

	cs = RackLink_CalcChecksum(tMsg);

	finalMessage = RackLink_EscapeMessage(finalMessage);

	MakeString(finalMessage,"%s%s%s%s", CHR(HEADER), finalMessage, CHR(cs), CHR(TAIL));

	Return (finalMessage);
}
  
////////////////////////////////////////////////////////////
// RackLink_SendDirectMessage
////////////////////////////////////////////////////////////
Function RackLink_SendDirectMessage(STRING msg)
{
	comTX$ = msg;
}
     
////////////////////////////////////////////////////////////
// RackLink_SendQueueMessage
////////////////////////////////////////////////////////////
Function RackLink_SendQueueMessage(STRING msg)
{
	enQueue(msg, 0);
}

////////////////////////////////////////////////////////////
// RackLink_SendQueueMessageLowPriority
////////////////////////////////////////////////////////////
Function RackLink_SendQueueMessageLowPriority(STRING msg)
{
	enQueueLowPriority(msg, 0);
}
 
////////////////////////////////////////////////////////////
// RackLink_LogEntryTypeName
////////////////////////////////////////////////////////////
String_Function RackLink_LogEntryTypeName(STRING typeNum)
{
	String response[MAX_NAME_SIZE];

	response = "Unknown";

	if (typeNum = "00")
		response = "NORMAL";
	else if (typeNum = "01")
		response = "OVER_VOLT";
	else if (typeNum = "02")
		response = "UNDER_VOLT";
	else if (typeNum = "03")
		response = "OVER_CURRENT";
	else if (typeNum = "04")
		response = "UNDER_CURRENT";
	else if (typeNum = "05")
		response = "OVER_TEMP";
	else if (typeNum = "06")
		response = "UNDER_TEMP";
	else if (typeNum = "07")
		response = "SURGE_FAULT";
	else if (typeNum = "08")
		response = "AUTO_PING";
	else if (typeNum = "09")
		response = "COMM_FAIL";
	else if (typeNum = "10")
		response = "EPO_INIT";
	else if (typeNum = "11")
		response = "EPO_RECOVER";

	return (response);
}

////////////////////////////////////////////////////////////
// RackLink_GetStatus
////////////////////////////////////////////////////////////
Function RackLink_Poll()
{
	INTEGER X;
                     
	// only poll if things are quite.
	IF (LEN(queueLowPriority) = 0)
	{
		FOR (X = 1 TO MAX_OUTLETS)
			RackLink_SendQueueMessageLowPriority(RackLink_CreateMessage(RL_CMD_PWR_OUTLET_NAME, RL_SUB_GET, CHR(X)));
	}
}

Function RackLink_GetStatus()
{
	INTEGER X;
	STRING statusChange[MAX_NAME_SIZE];
    
	FOR (X = 1 TO MAX_OUTLETS)
	{
		RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_PWR_OUTLET, RL_SUB_GET, CHR(X)));
		RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_PWR_OUTLET_NAME, RL_SUB_GET, CHR(X)));
	}

	MakeString(statusChange,"%s%s%s%s%s%s",CHR(0x01),CHR(0x04),CHR(0x00),CHR(0x00),CHR(0x00),CHR(0x00));
	RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_REG_STATUS_CHANGE, RL_SUB_SET, statusChange));

	RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_SEQUENCE_POWER_OUTLETS, RL_SUB_GET, sNull));
	RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_CURRENT_OCCUPANCY_STATE, RL_SUB_GET, sNull));
                                                                                             
	MakeString(statusChange,"%s%s",CHR(0x00),CHR(0x00));
	RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_REG_LOG_ALERTS, RL_SUB_SET, statusChange));
	
	RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_CURRENT_COMPETE_EMS, RL_SUB_GET, sNull));

	RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_PWR_OUTLET_COUNT, RL_SUB_GET, sNull));
	
	RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_PRODUCT_IP_ADDRESS, RL_SUB_GET, sNull));
	RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_PRODUCT_RATING, RL_SUB_GET, sNull));
	RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_PRODUCT_PART_NUM, RL_SUB_GET, sNull));
}
 
////////////////////////////////////////////////////////////
// RackLink_CreateLogMessage
////////////////////////////////////////////////////////////            
String_Function RackLink_CreateLogMessage(STRING entry, STRING category, STRING logData)
{
	STRING modifiedLogData[100];
	STRING categoryName[MAX_NAME_SIZE];
	STRING response[MAX_MSG_SIZE];

	//  TAKE "LOG" PROTION AND REPLACE COMMA FOR PIPE AND SPACE FOR PIPE.
	modifiedLogData = stringReplace(logData, ",", "|");
	modifiedLogData = stringReplace(modifiedLogData, " ", "|");

 	categoryName = RackLink_LogEntryTypeName(category);

	MakeString(response,"%s|%s|%s", entry, categoryName, modifiedLogData);

	return (response); 
}
 
////////////////////////////////////////////////////////////
// Racklink_ParseResponse
////////////////////////////////////////////////////////////            
Function Racklink_ParseResponse(INTEGER cmd, STRING dataEnvelope, INTEGER isResponse)
{
	// parsing
	INTEGER nValue1;
	INTEGER nValue2;
	STRING sValue1[MAX_NAME_SIZE];
	STRING sValue2[MAX_NAME_SIZE];
	STRING sTemp[MAX_MSG_SIZE];
                                        
	// STRING TOKENIZER
	INTEGER tokenCount;
    STRING tokens[MAX_TOKENS][MAX_TOKEN_LENGTH];

	switch (cmd)
	{
		case (RL_CMD_NACK):	
		{
		}
		case (RL_CMD_LOGIN):	
		{
            nValue1 = BYTE(dataEnvelope, 1);

			IF (nValue1 = RL_LOGIN_ACCEPTED)
			{
				isLoggedIn = TRUE;

				RackLink_SendQueueMessage(cmdHeartbeat);
			}
			ELSE
				isLoggedIn = FALSE;
		}
		case (RL_CMD_PWR_OUTLET):	
		{
			nValue1 = BYTE(dataEnvelope, 1);

			IF (nValue1 > 0 && nValue1 <= MAX_OUTLETS)
			{
				nValue2 = BYTE(dataEnvelope, 2);

				SWITCH (nValue1)
				{
					CASE (1):		
					{		
						OUTLET_1_ON_FB = (nValue2 = RL_CS_ON);
						OUTLET_1_OFF_FB = !OUTLET_1_ON_FB;
					}
					CASE (2):		
					{		
						OUTLET_2_ON_FB = (nValue2 = RL_CS_ON);
						OUTLET_2_OFF_FB = !OUTLET_2_ON_FB;
					}
					CASE (3):		
					{		
						OUTLET_3_ON_FB = (nValue2 = RL_CS_ON);
						OUTLET_3_OFF_FB = !OUTLET_3_ON_FB;
					}
					CASE (4):		
					{		
						OUTLET_4_ON_FB = (nValue2 = RL_CS_ON);
						OUTLET_4_OFF_FB = !OUTLET_4_ON_FB;
					}
					CASE (5):		
					{		
						OUTLET_5_ON_FB = (nValue2 = RL_CS_ON);
						OUTLET_5_OFF_FB = !OUTLET_5_ON_FB;
					}
					CASE (6):		
					{		
						OUTLET_6_ON_FB = (nValue2 = RL_CS_ON);
						OUTLET_6_OFF_FB = !OUTLET_6_ON_FB;
					}
					CASE (7):		
					{		
						OUTLET_7_ON_FB = (nValue2 = RL_CS_ON);
						OUTLET_7_OFF_FB = !OUTLET_7_ON_FB;
					}
					CASE (8):		
					{		
						OUTLET_8_ON_FB = (nValue2 = RL_CS_ON);
						OUTLET_8_OFF_FB = !OUTLET_8_ON_FB;
					}
					CASE (9):		
					{		
						OUTLET_9_ON_FB = (nValue2 = RL_CS_ON);
						OUTLET_9_OFF_FB = !OUTLET_9_ON_FB;
					}
					CASE (10):		
					{		
						OUTLET_10_ON_FB = (nValue2 = RL_CS_ON);
						OUTLET_10_OFF_FB = !OUTLET_10_ON_FB;
					}
					CASE (11):		
					{		
						OUTLET_11_ON_FB = (nValue2 = RL_CS_ON);
						OUTLET_11_OFF_FB = !OUTLET_11_ON_FB;
					}
					CASE (12):		
					{		
						OUTLET_12_ON_FB = (nValue2 = RL_CS_ON);
						OUTLET_12_OFF_FB = !OUTLET_12_ON_FB;
					}
					CASE (13):		
					{		
						OUTLET_13_ON_FB = (nValue2 = RL_CS_ON);
						OUTLET_13_OFF_FB = !OUTLET_13_ON_FB;
					}
					CASE (14):		
					{		
						OUTLET_14_ON_FB = (nValue2 = RL_CS_ON);
						OUTLET_14_OFF_FB = !OUTLET_14_ON_FB;
					}
					CASE (15):		
					{		
						OUTLET_15_ON_FB = (nValue2 = RL_CS_ON);
						OUTLET_15_OFF_FB = !OUTLET_15_ON_FB;
					}
					CASE (16):		
					{		
						OUTLET_16_ON_FB = (nValue2 = RL_CS_ON);
						OUTLET_16_OFF_FB = !OUTLET_16_ON_FB;
					}
				}
			}	
		}
		case (RL_CMD_PWR_OUTLET_NAME):	
		{
			nValue1 = BYTE(dataEnvelope, 1);

			IF (nValue1 > 0 && nValue1 <= MAX_OUTLETS)
			{
                sValue1 = MID(dataEnvelope, 2, LEN(dataEnvelope));

				IF (outletNames[nValue1] != sValue1)
				{
					outletNames[nValue1] = sValue1;
					
					SWITCH (nValue1)
					{
						CASE (1):		
						{		
							OUTLET_1_NAME$ = outletNames[nValue1];
						}
						CASE (2):		
						{		
							OUTLET_2_NAME$ = outletNames[nValue1];
						}
						CASE (3):		
						{		
							OUTLET_3_NAME$ = outletNames[nValue1];
						}
						CASE (4):		
						{		
							OUTLET_4_NAME$ = outletNames[nValue1];
						}
						CASE (5):		
						{		
							OUTLET_5_NAME$ = outletNames[nValue1];
						}
						CASE (6):		
						{		
							OUTLET_6_NAME$ = outletNames[nValue1];
						}
						CASE (7):		
						{		
							OUTLET_7_NAME$ = outletNames[nValue1];
						}
						CASE (8):		
						{		
							OUTLET_8_NAME$ = outletNames[nValue1];
						}
						CASE (9):		
						{		
							OUTLET_9_NAME$ = outletNames[nValue1];
						}
						CASE (10):		
						{		
							OUTLET_10_NAME$ = outletNames[nValue1];
						}
						CASE (11):		
						{		
							OUTLET_11_NAME$ = outletNames[nValue1];
						}
						CASE (12):		
						{		
							OUTLET_12_NAME$ = outletNames[nValue1];
						}
						CASE (13):		
						{		
							OUTLET_13_NAME$ = outletNames[nValue1];
						}
						CASE (14):		
						{		
							OUTLET_14_NAME$ = outletNames[nValue1];
						}
						CASE (15):		
						{		
							OUTLET_15_NAME$ = outletNames[nValue1];
						}
						CASE (16):		
						{		
							OUTLET_16_NAME$ = outletNames[nValue1];
						}
					}
				}
			}				
		}
		case (RL_CMD_PWR_OUTLET_COUNT):	
		{			
			FOR (nValue1 = 1 to LEN(dataEnvelope))
			{
				nValue2 = (0x01 << (nValue1 - 1));

				IF (MID(dataEnvelope, nValue1, 1) = "C")
				{
					// LSB = PRESENT
					OUTLETS_PRESENT_BITMASK = OUTLETS_PRESENT_BITMASK | nValue2;

					// MSB = CONTROLLABLE
					OUTLETS_CONTROLLABLE_BITMASK = OUTLETS_CONTROLLABLE_BITMASK | nValue2;
				}
				ELSE IF (MID(dataEnvelope, nValue1, 1) = "N")
				{
					// LSB = PRESENT
					OUTLETS_PRESENT_BITMASK = OUTLETS_PRESENT_BITMASK | nValue2;

					// MSB = CONTROLLABLE
					OUTLETS_CONTROLLABLE_BITMASK = OUTLETS_CONTROLLABLE_BITMASK & (0xffff - nValue2);
				}
				ELSE IF (MID(dataEnvelope, nValue1, 1) = "X")
				{
					// LSB = PRESENT
					OUTLETS_PRESENT_BITMASK = OUTLETS_PRESENT_BITMASK & (0xffff - nValue2);

					// MSB = CONTROLLABLE
					OUTLETS_CONTROLLABLE_BITMASK = OUTLETS_CONTROLLABLE_BITMASK & (0xffff - nValue2);
				}
			}
		}
		case (RL_CMD_PWR_OUTLET_EMS):	
		{
			nValue1 = BYTE(dataEnvelope, 1);

			IF (nValue1 > 0 && nValue1 <= MAX_OUTLETS)
			{
                sValue1 = MID(dataEnvelope, 2, LEN(dataEnvelope));

				IF (outletEMS[nValue1] != getEMSState_Value(sValue1))
				{
					outletEMS[nValue1] = getEMSState_Value(sValue1);
					
					SWITCH (nValue1)
					{
						CASE (1):		
						{		
							OUTLET_1_EMS_STATUS = outletEMS[nValue1];
							OUTLET_1_EMS_STATUS$ = getEMSState_Text(outletEMS[nValue1]);
						}
						CASE (2):		
						{		
							OUTLET_2_EMS_STATUS = outletEMS[nValue1];
							OUTLET_2_EMS_STATUS$ = getEMSState_Text(outletEMS[nValue1]);
						}
						CASE (3):		
						{		
							OUTLET_3_EMS_STATUS = outletEMS[nValue1];
							OUTLET_3_EMS_STATUS$ = getEMSState_Text(outletEMS[nValue1]);
						}
						CASE (4):		
						{		
							OUTLET_4_EMS_STATUS = outletEMS[nValue1];
							OUTLET_4_EMS_STATUS$ = getEMSState_Text(outletEMS[nValue1]);
						}
						CASE (5):		
						{		
							OUTLET_5_EMS_STATUS = outletEMS[nValue1];
							OUTLET_5_EMS_STATUS$ = getEMSState_Text(outletEMS[nValue1]);
						}
						CASE (6):		
						{		
							OUTLET_6_EMS_STATUS = outletEMS[nValue1];
							OUTLET_6_EMS_STATUS$ = getEMSState_Text(outletEMS[nValue1]);
						}
						CASE (7):		
						{		
							OUTLET_7_EMS_STATUS = outletEMS[nValue1];
							OUTLET_7_EMS_STATUS$ = getEMSState_Text(outletEMS[nValue1]);
						}
						CASE (8):		
						{		
							OUTLET_8_EMS_STATUS = outletEMS[nValue1];
							OUTLET_8_EMS_STATUS$ = getEMSState_Text(outletEMS[nValue1]);
						}
						CASE (9):		
						{		
							OUTLET_9_EMS_STATUS = outletEMS[nValue1];
							OUTLET_9_EMS_STATUS$ = getEMSState_Text(outletEMS[nValue1]);
						}
						CASE (10):		
						{		
							OUTLET_10_EMS_STATUS = outletEMS[nValue1];
							OUTLET_10_EMS_STATUS$ = getEMSState_Text(outletEMS[nValue1]);
						}
						CASE (11):		
						{		
							OUTLET_11_EMS_STATUS = outletEMS[nValue1];
							OUTLET_11_EMS_STATUS$ = getEMSState_Text(outletEMS[nValue1]);
						}
						CASE (12):		
						{		
							OUTLET_12_EMS_STATUS = outletEMS[nValue1];
							OUTLET_12_EMS_STATUS$ = getEMSState_Text(outletEMS[nValue1]);
						}
						CASE (13):		
						{		
							OUTLET_13_EMS_STATUS = outletEMS[nValue1];
							OUTLET_13_EMS_STATUS$ = getEMSState_Text(outletEMS[nValue1]);
						}
						CASE (14):		
						{		
							OUTLET_14_EMS_STATUS = outletEMS[nValue1];
							OUTLET_14_EMS_STATUS$ = getEMSState_Text(outletEMS[nValue1]);
						}
						CASE (15):		
						{		
							OUTLET_15_EMS_STATUS = outletEMS[nValue1];
							OUTLET_15_EMS_STATUS$ = getEMSState_Text(outletEMS[nValue1]);
						}
						CASE (16):		
						{		
							OUTLET_16_EMS_STATUS = outletEMS[nValue1];
							OUTLET_16_EMS_STATUS$ = getEMSState_Text(outletEMS[nValue1]);
						}
					}
				}
			}				
		}
		case (RL_CMD_SEQUENCE_POWER_OUTLETS):	
		{
			nValue1 = BYTE(dataEnvelope, 1);

			if (nValue1 != powerSequenceStatus)
			{
				powerSequenceStatus = nValue1;
                                          
				SWITCH (powerSequenceStatus)
				{
					CASE (SEQ_STATUS_NONE):
					{
						POWER_SEQ_UP_FB = FALSE;
						POWER_SEQ_DN_FB = FALSE;
						CS_POWER_SEQ$ = "None";
					}
					CASE (SEQ_STATUS_UP):
					{
						POWER_SEQ_UP_FB = TRUE;
						POWER_SEQ_DN_FB = FALSE;
						CS_POWER_SEQ$ = "Up.Running";
					}
					CASE (SEQ_STATUS_UP_DONE):
					{
						POWER_SEQ_UP_FB = FALSE;
						POWER_SEQ_DN_FB = FALSE;
						CS_POWER_SEQ$ = "Up.Completed";
					}
					CASE (SEQ_STATUS_DN):
					{
						POWER_SEQ_UP_FB = FALSE;
						POWER_SEQ_DN_FB = TRUE;
						CS_POWER_SEQ$ = "Down.Running";
					}
					CASE (SEQ_STATUS_DN_DONE):
					{
						POWER_SEQ_UP_FB = FALSE;
						POWER_SEQ_DN_FB = FALSE;
						CS_POWER_SEQ$ = "Down.Completed";
					}
				}
			}
		}
		case (RL_CMD_CURRENT_COMPETE_EMS):
		{
			IF (LEN(dataEnvelope) = 9)
			{
				ROOM_OCCUPANCY_ON_FB = (LEFT(dataEnvelope,1) = RL_OCCUPIED);
				ROOM_OCCUPANCY_OFF_FB = (LEFT(dataEnvelope,1) = RL_UNOCCUPIED);		
                               
				outletEMS[1] = getEMSState_Value(MID(dataEnvelope,2,1));
				outletEMS[2] = getEMSState_Value(MID(dataEnvelope,3,1));
				outletEMS[3] = getEMSState_Value(MID(dataEnvelope,4,1));
				outletEMS[4] = getEMSState_Value(MID(dataEnvelope,5,1));
				outletEMS[5] = getEMSState_Value(MID(dataEnvelope,6,1));
				outletEMS[6] = getEMSState_Value(MID(dataEnvelope,7,1));
				outletEMS[7] = getEMSState_Value(MID(dataEnvelope,8,1));
				outletEMS[8] = getEMSState_Value(MID(dataEnvelope,9,1));
		
				OUTLET_1_EMS_STATUS$ = getEMSState_Text(outletEMS[1]);
				OUTLET_2_EMS_STATUS$ = getEMSState_Text(outletEMS[2]);
				OUTLET_3_EMS_STATUS$ = getEMSState_Text(outletEMS[3]);
				OUTLET_4_EMS_STATUS$ = getEMSState_Text(outletEMS[4]);
				OUTLET_5_EMS_STATUS$ = getEMSState_Text(outletEMS[5]);
				OUTLET_6_EMS_STATUS$ = getEMSState_Text(outletEMS[6]);
				OUTLET_7_EMS_STATUS$ = getEMSState_Text(outletEMS[7]);
				OUTLET_8_EMS_STATUS$ = getEMSState_Text(outletEMS[8]);

				OUTLET_1_EMS_STATUS = outletEMS[1];
				OUTLET_2_EMS_STATUS = outletEMS[2];
				OUTLET_3_EMS_STATUS = outletEMS[3];
				OUTLET_4_EMS_STATUS = outletEMS[4];
				OUTLET_5_EMS_STATUS = outletEMS[5];
				OUTLET_6_EMS_STATUS = outletEMS[6];
				OUTLET_7_EMS_STATUS = outletEMS[7];
				OUTLET_8_EMS_STATUS = outletEMS[8];
			}
		}
		case (RL_CMD_CURRENT_OCCUPANCY_STATE):
		{
			IF (LEN(dataEnvelope) = 1)
			{
				ROOM_OCCUPANCY_ON_FB = (dataEnvelope = RL_OCCUPIED);
				ROOM_OCCUPANCY_OFF_FB = (dataEnvelope = RL_UNOCCUPIED);
			}
		}
		case (RL_CMD_REG_LOG_ALERTS):	
		{
			nValue1 = BYTE(dataEnvelope, 1);
			nValue2 = BYTE(dataEnvelope, 2);

			//LOG_ALERT_REG_FB = (nValue2 << 8) + nValue1;
		}
		case (RL_CMD_PRODUCT_PART_NUM):	
		{
			IF (LEN(dataEnvelope) > 0)
			{
				IF (model != dataEnvelope)
				{
					model = dataEnvelope;
					
					MakeString(PI_PART_NUMBER$,"%s" ,model);
				}

				IF (isIntialized = FALSE)
					isIntialized = TRUE;
			}
		}
		case (RL_CMD_PRODUCT_RATING):	
		{
			IF (LEN(dataEnvelope) > 0)
			{
				IF (rating != dataEnvelope)
				{
					rating = dataEnvelope;
					
					MakeString(PI_RATING$,"%s", rating);
				}
			}
		}
		case (RL_CMD_PRODUCT_IP_ADDRESS):	
		{
			IF (LEN(dataEnvelope) > 0)
			{
				IF (ipAddress != dataEnvelope)
				{
					ipAddress = dataEnvelope;
					
					MakeString(PI_IP_ADDRESS$,"%s", ipAddress);
				}
			}
		}
		case (RL_CMD_PRODUCT_MAC):	
		{
			IF (LEN(dataEnvelope) > 0)
			{	
				IF (macAddress != dataEnvelope)
				{
					macAddress = dataEnvelope;
					
					MakeString(PI_MAC_ADDRESS$,"%s", macAddress);
				}
			}

			IF (isIntialized = FALSE)
				RackLink_GetStatus();
		}
	}

	IF (isResponse = TRUE && cmd != RL_CMD_LOG_ENTRY)
		goodResponse();
}
 
////////////////////////////////////////////////////////////
// Racklink_ParseMessage
////////////////////////////////////////////////////////////
Function Racklink_ParseMessage(STRING MSG)
{
	STRING unescapedMsg[MAX_MSG_SIZE];
	
	// pieces
	STRING dataEnvelope[MAX_MSG_SIZE];
	INTEGER length;
	INTEGER cs;
	INTEGER cmd;
	INTEGER subCmd;

	INTEGER tokenCount;
    STRING tokens[MAX_TOKENS][MAX_TOKEN_LENGTH];

	// check to see if whole message
	IF (BYTE(MSG, 1) = HEADER && BYTE(RIGHT(MSG, 1), 1) = TAIL)
	{
		CancelWait(commTimeoutQueue);

		unescapedMsg = RackLink_UnescapeMessage(MSG);

		length = BYTE(unescapedMsg, 2);
        
		cmd =  BYTE(unescapedMsg, 4);

		subCmd =  BYTE(unescapedMsg, 5);

		dataEnvelope = MID(unescapedMsg, 6, length - 3);

		switch (subCmd)
		{
			case (RL_SUB_SET):
			{
				IF (cmd = RL_CMD_PING && isLoggedIn = TRUE)
				{
					// Non-Response Message, bypass queue!
					RackLink_SendDirectMessage(RackLink_CreateMessage(RL_CMD_PING, RL_SUB_RESPONSE, sNull));
				}
			}
			case (RL_SUB_RESPONSE):
			{
				Racklink_ParseResponse(cmd, dataEnvelope, TRUE);
			}
			case (RL_SUB_STATUS_CHANGE):
			{
				Racklink_ParseResponse(cmd, dataEnvelope, FALSE);
			}
			case (RL_SUB_LOG_ALERT):
			{
				IF (cmd = RL_CMD_LOG_ENTRY)
				{
					// ITEM|ITEMS TO RECEIVE|ENTRY|CATEGORY|LOG
		            tokenCount = stringTokenizer(tokens, dataEnvelope, "|");
		
					if (tokenCount = 5)
					{
						//LOG_ALERT$ = RackLink_CreateLogMessage(tokens[3], tokens[4], tokens[5]);
					}
				}			
			}
		}
	}
	ELSE
		TRACE("PARSE_ERROR!");
}

////////////////////////////////////////////////////////////
// RackLink_StartHeartBeat
////////////////////////////////////////////////////////////
Function RackLink_StartHeartBeat()
{
	STRING login[MAX_NAME_SIZE];

	isHeartBeatRunning = TRUE;
	
	IF (isLoggedIn = FALSE)
	{
		MakeString(login, "%s|%s", USER_NAME$, USER_PASSWORD$);
						
		RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_LOGIN, RL_SUB_SET, login));
	}
	ELSE
		RackLink_SendQueueMessage(cmdHeartbeat);

	WAIT (3000, heartbeat)
		RackLink_StartHeartBeat();
}

////////////////////////////////////////////////////////////
// OUTLET CONTROL
////////////////////////////////////////////////////////////
Function Racklink_OutletOn(INTEGER outletID)
{
	STRING data[6];

	MakeString(data,"%s%s0000",CHR(outletID),CHR(RL_CS_ON));

	RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_PWR_OUTLET, RL_SUB_SET, data));
}

Function Racklink_OutletOff(INTEGER outletID)
{
	STRING data[6];

	MakeString(data,"%s%s0000",CHR(outletID),CHR(RL_CS_OFF));

	RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_PWR_OUTLET, RL_SUB_SET, data));
}

Function Racklink_OutletCycle(INTEGER outletID)
{
	INTEGER cycleTime;
	STRING data[6];

	cycleTime = POWER_CYCLE_TIME;

	IF (cycleTime = 0 || cycleTime > 3600)
		cycleTime = 1;

	MakeString(data,"%s%s%04d", CHR(outletID), CHR(RL_CS_CYCLE), cycleTime);

	RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_PWR_OUTLET, RL_SUB_SET, data));
}

Function Racklink_OutletNameSet(INTEGER outletID, STRING name)
{
	STRING sValue[MAX_NAME_SIZE];

	IF (outletID > 0 && outletID <= MAX_OUTLETS)
	{
		MakeString(sValue, "%s%s", CHR(outletID), name);

		RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_PWR_OUTLET_NAME, RL_SUB_SET, sValue));
	}
}

Function Racklink_OutletEMSSet(INTEGER outletID, INTEGER state)
{
	STRING sValue[MAX_NAME_SIZE];

	IF (outletID > 0 && outletID <= MAX_OUTLETS)
	{
		IF (state >= 0 && state <= 4)
		{
			MakeString(sValue, "%s%s", CHR(outletID), getEMSState_MsgValue(state));

			RackLink_SendQueueMessage(RackLink_CreateMessage(RL_CMD_PWR_OUTLET_EMS, RL_SUB_SET, sValue));
		}
	}
}

