////////////////////////////////////////////////////////////
// LOG
////////////////////////////////////////////////////////////
PUSH REFRESH_LOG
{
}
////////////////////////////////////////////////////////////
// INCOMING PACKETS
////////////////////////////////////////////////////////////
CHANGE comRX$
{
	IF (parsingBusy = FALSE)
	{
		parsingBusy = TRUE;
		
		WHILE (TRUE)
		{
			sMsg = GATHER(CHR(TAIL), comRX$);
	
			IF (LEN(sMsg) > 0)
			{
				Racklink_ParseMessage(sMsg);  
	
				//ProcessLogic();			
			}
		}

		parsingBusy = FALSE;
	}          
}

/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/

Function Main()
{
    // TODO:  Add code here
    // Initialize declared global and local variables/arrays as needed.

	isLoggedIn = FALSE;

	cmdHeartbeat = RackLink_CreateMessage(RL_CMD_PRODUCT_MAC, RL_SUB_GET, sNull);

	queueIsBusy = FALSE;
	queue = "";

	isHeartBeatRunning = FALSE;

	parsingBusy = FALSE;

	isIntialized = FALSE;

	powerSequenceStatus = 0xff;
	epoStatus = 0xff;

    //WaitForInitializationComplete();
}
