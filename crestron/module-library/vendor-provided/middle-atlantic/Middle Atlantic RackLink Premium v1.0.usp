THREADSAFE PUSH Dry_Contact_Power_Cycle
{
  INTEGER i;
  i = GETLASTMODIFIEDARRAYINDEX();

  device.DryContactPowerCycle(i);
}

THREADSAFE PUSH Dry_Contacts_Power_On_Selected
{
  device.DryContactPowerOnSelected();
}

THREADSAFE PUSH Dry_Contacts_Power_Off_Selected
{
  device.DryContactPowerOffSelected();
}

THREADSAFE PUSH Dry_Contacts_Power_Cycle_Selected
{
  device.DryContactPowerCycleSelected();
}

// LOG

THREADSAFE PUSH Refresh_Log
{
  device.RefreshLog();
}

THREADSAFE PUSH Clear_Log
{
  device.ClearLog();
}

THREADSAFE PUSH Log_Page_Top
{
  device.LogPageTop();
}

THREADSAFE PUSH Log_Page_Up
{
  device.LogPageUp();
}

THREADSAFE PUSH Log_Page_Down
{
  device.LogPageDown();
}

THREADSAFE PUSH Log_Page_Bottom
{
  device.LogPageBottom();
}

/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/

FUNCTION Main()
{
  WAITFORINITIALIZATIONCOMPLETE();
  ResetAllInfo();

  REGISTEREVENT(device, OnDebug, OnDebug);
  REGISTEREVENT(device, OnCommunicatingChange, OnCommunicatingChange);
  REGISTEREVENT(device, OnInitializedChange, OnInitializedChange);
  REGISTEREVENT(device, OnPduInfoChange, OnPduInfoChange);  
  REGISTEREVENT(device, OnTemperatureInfoChange, OnTemperatureInfoChange);                                          
  REGISTEREVENT(device, OnOutletsListChange, OnOutletsListChange);
  REGISTEREVENT(device, OnDryContactsListChange, OnDryContactsListChange);
  REGISTEREVENT(device, OnLogEntriesListChange, OnLogEntriesListChange);
  REGISTEREVENT(device, OnPollStateChange, OnPollStateChange);
  
  DELAY(500);
  
  device.Configure(Command_Processor, IP_Address, Username, Password, Log_Entries_Per_Page);
}
