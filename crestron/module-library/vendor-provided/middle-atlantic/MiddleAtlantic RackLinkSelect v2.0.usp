		OUTLET_9_NAME$ = name;
		OUTLET_9_PRESENT_FB = isPresent;
        OUTLET_9_CONTROLLABLE_FB = isControllable;
	}

	ELSE IF(index = 10)
	{
    	OUTLET_10_ON_FB = isOn;
    	OUTLET_10_OFF_FB = isOff;
		OUTLET_10_NAME$ = name;
		OUTLET_10_PRESENT_FB = isPresent;
		OUTLET_10_CONTROLLABLE_FB = isControllable;

	}

	ELSE IF(index = 11)
	{
    	OUTLET_11_ON_FB = isOn;
