{
	RackLinkCommandProcessor.OutletNameSet(16, OUTLET_16_NAME_SET$);
}

////////////////////////////////////////////////////////////
// POWER SEQUENCE
////////////////////////////////////////////////////////////
PUSH POWER_SEQ_UP
{
	RackLinkCommandProcessor.PowerSequenceUp();
}

PUSH POWER_SEQ_DN
{
	RackLinkCommandProcessor.PowerSequenceDown();
}



THREADSAFE CHANGE POWER_CYCLE_TIME 
{
    RackLinkCommandProcessor.SetPowerCycleTime(POWER_CYCLE_TIME);
}

THREADSAFE CHANGE POWER_SEQ_TIME
{
    RackLinkCommandProcessor.SetPowerSequenceTime(POWER_SEQ_TIME);
}




/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/

Function Main()
{
	Ready = 0;

	WaitForInitializationComplete();                      

	REGISTEREVENT(RackLinkCommandProcessor, OnCommunicating, OnCommunicating);
	REGISTEREVENT(RackLinkCommandProcessor, OnInitialized, OnInitialized);
	REGISTEREVENT(RackLinkCommandProcessor, OnDebug, OnDebug);
	REGISTEREVENT(RackLinkCommandProcessor, OnReady, OnReady);
	REGISTEREVENT(RackLinkCommandProcessor, OnProductPartNumber, OnProductPartNumber);                                             
	REGISTEREVENT(RackLinkCommandProcessor, OnProductRating, OnProductRating);
	REGISTEREVENT(RackLinkCommandProcessor, OnProductIp, OnProductIp);
	REGISTEREVENT(RackLinkCommandProcessor, OnProductMac, OnProductMac);
	REGISTEREVENT(RackLinkCommandProcessor, OnOutletState, OnOutletState);
	REGISTEREVENT(RackLinkCommandProcessor, OnSequence, OnSequence);


	RackLinkCommandProcessor.Configure(ConnectionType, IPAddress, Username, Password);

}
           