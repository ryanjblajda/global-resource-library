	RackLinkCommandProcessor.OutletNameSet(10, OUTLET_10_NAME_SET$);
}

CHANGE OUTLET_11_NAME_SET$
{
	RackLinkCommandProcessor.OutletNameSet(11, OUTLET_11_NAME_SET$);
}

CHANGE OUTLET_12_NAME_SET$
{
	RackLinkCommandProcessor.OutletNameSet(12, OUTLET_12_NAME_SET$);
}

CHANGE OUTLET_13_NAME_SET$
{
	RackLinkCommandProcessor.OutletNameSet(13, OUTLET_13_NAME_SET$);
}

CHANGE OUTLET_14_NAME_SET$
{
	RackLinkCommandProcessor.OutletNameSet(14, OUTLET_14_NAME_SET$);
}

CHANGE OUTLET_15_NAME_SET$
{
	RackLinkCommandProcessor.OutletNameSet(15, OUTLET_15_NAME_SET$);
