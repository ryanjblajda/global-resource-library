/*******************************************************************************************
  Global Variables
  (Uncomment and declare global variables as needed)
  Note:  Be sure to initialize all declared STRING variables as needed
         For example, in Function Main: myString = "";
*******************************************************************************************/
INTEGER Ready;
// LONG_INTEGER
// SIGNED_INTEGER
// SIGNED_LONG_INTEGER
// STRING
CommandProcessor RackLinkCommandProcessor;
OutletModel outlet; 
SequenceModel sequence;         

/*******************************************************************************************
  Functions
  (Add any additional functions here)
  Note:  Functions must be physically placed before the location in
         the code that calls them.
*******************************************************************************************/  

EventHandler OnCommunicating ( CommandProcessor sender, DigEventArgs args )
{
	IS_COMMUNICATING_FB = args.Payload;
}
EventHandler OnInitialized ( CommandProcessor sender, DigEventArgs args )
{
	IS_INITIALIZED_FB = args.Payload;
}
EventHandler OnDebug ( CommandProcessor sender, SerEventArgs args )
{
	if(DEBUG_ENABLE)
		TRACE("%s", args.Payload);
}
EventHandler OnReady ( CommandProcessor sender, EventArgs e )
{
	Ready = 1;

	RackLinkCommandProcessor.SetPowerCycleTime(POWER_CYCLE_TIME);
	RackLinkCommandProcessor.SetPowerSequenceTime(POWER_SEQ_TIME);

	IF(Connect)
		RackLinkCommandProcessor.Connect();
}
 

EventHandler OnProductPartNumber ( CommandProcessor sender, SerEventArgs args )
{
	PI_PART_NUMBER$ = args.Payload;
}
EventHandler OnProductRating ( CommandProcessor sender, SerEventArgs args )
{
	PI_RATING$ = args.Payload;
}

EventHandler OnProductIp ( CommandProcessor sender, SerEventArgs args )
{
	PI_IP_ADDRESS$ = args.Payload;
}
EventHandler OnProductMac ( CommandProcessor sender, SerEventArgs args )
{
	PI_MAC_ADDRESS$ = args.Payload;
}

EventHandler OnSequence ( CommandProcessor sender, SequenceEventArgs args )
{
	sequence = args.Payload;
	POWER_SEQ_UP_FB = 0;
	POWER_SEQ_DN_FB = 0;

	POWER_SEQ_UP_FB = sequence.IsUp;
	POWER_SEQ_DN_FB = sequence.IsDown;
    CS_POWER_SEQ$ = sequence.Text;	
}

EventHandler OnOutletState ( CommandProcessor sender, OutletEventArgs args )
{
	INTEGER index, isOn, isOff, isControllable, isPresent;
	STRING name[50];
    
	outlet = args.Payload;

	index = outlet.Index;
	isOn = outlet.IsOn;	
	isOff = outlet.IsOff;
	isControllable = outlet.Controllable;
    isPresent = outlet.Exists;	
	name = outlet.Name;   


    IF(index = 1)
	{
    	OUTLET_1_ON_FB = isOn;
    	OUTLET_1_OFF_FB = isOff;		
		OUTLET_1_NAME$ = name;
		OUTLET_1_PRESENT_FB = isPresent;
		OUTLET_1_CONTROLLABLE_FB = isControllable;
	}

	ELSE IF(index = 2)
	{
    	OUTLET_2_ON_FB = isOn;
    	OUTLET_2_OFF_FB = isOff;
		OUTLET_2_NAME$ = name;
		OUTLET_2_PRESENT_FB = isPresent;
		OUTLET_2_CONTROLLABLE_FB = isControllable;
	}

	ELSE IF(index = 3)
	{
    	OUTLET_3_ON_FB = isOn;
    	OUTLET_3_OFF_FB = isOff;
		OUTLET_3_NAME$ = name;
		OUTLET_3_PRESENT_FB = isPresent;
		OUTLET_3_CONTROLLABLE_FB = isControllable;
	}

	ELSE IF(index = 4)
	{
    	OUTLET_4_ON_FB = isOn;
    	OUTLET_4_OFF_FB = isOff;
		OUTLET_4_NAME$ = name;
		OUTLET_4_PRESENT_FB = isPresent;
        OUTLET_4_CONTROLLABLE_FB = isControllable;
	}

	ELSE IF(index = 5)
	{
    	OUTLET_5_ON_FB = isOn;
    	OUTLET_5_OFF_FB = isOff;
		OUTLET_5_NAME$ = name;
		OUTLET_5_PRESENT_FB = isPresent;
        OUTLET_5_CONTROLLABLE_FB = isControllable;
	}

	ELSE IF(index = 6)
	{
    	OUTLET_6_ON_FB = isOn;
    	OUTLET_6_OFF_FB = isOff;
		OUTLET_6_NAME$ = name;
		OUTLET_6_PRESENT_FB = isPresent;
        OUTLET_6_CONTROLLABLE_FB = isControllable;
	}

	ELSE IF(index = 7)
	{
    	OUTLET_7_ON_FB = isOn;
    	OUTLET_7_OFF_FB = isOff;
		OUTLET_7_NAME$ = name;
		OUTLET_7_PRESENT_FB = isPresent;
        OUTLET_7_CONTROLLABLE_FB = isControllable;
	}

	ELSE IF(index = 8)
	{
    	OUTLET_8_ON_FB = isOn;
    	OUTLET_8_OFF_FB = isOff;
		OUTLET_8_NAME$ = name;
		OUTLET_8_PRESENT_FB = isPresent;
        OUTLET_8_CONTROLLABLE_FB = isControllable;
	}

	ELSE IF(index = 9)
	{
    	OUTLET_9_ON_FB = isOn;
