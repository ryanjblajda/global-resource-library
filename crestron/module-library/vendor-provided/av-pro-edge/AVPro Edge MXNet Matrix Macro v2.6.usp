/*******************************************************************************************
  INFORMATION
*******************************************************************************************/

/*
Dealer Name: Control Concepts, Inc.
System Name: AVPro Edge MXNet Matrix Macro v2.6
Programmer:  VNR
Version:     2.5
*/

/*******************************************************************************************
  COMPILER DIRECTIVES
*******************************************************************************************/

#SYMBOL_NAME "AVPro Edge MXNet Matrix Macro v2.6"
#CATEGORY "0"
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

// #ENABLE_DYNAMIC
// #HINT ""
// #PRINT_TO_TRACE
// #DIGITAL_EXPAND 
// #ANALOG_SERIAL_EXPAND 
// #OUTPUT_SHIFT 
// #HELP_PDF_FILE ""
// #ENCODING_ASCII
// #ENCODING_UTF16
// #ENCODING_INHERIT_FROM_PARENT
// #ENCODING_INHERIT_FROM_PROGRAM

/*******************************************************************************************
  CONSTANTS
*******************************************************************************************/

#DEFINE_CONSTANT TRUE 1
#DEFINE_CONSTANT FALSE 0
#DEFINE_CONSTANT MAX_STRING 255
#DEFINE_CONSTANT NULL_STRING ""
#DEFINE_CONSTANT NULL_VALUE 0

#HELP_BEGIN
To be used with AVPro Edge MXNet Matrix Macro v2.6.umc module only.
Not to be used as a stand-alone module.
#HELP_END

/*******************************************************************************************
  INCLUDE LIBRARIES
*******************************************************************************************/

#USER_SIMPLSHARP_LIBRARY "AVProEdgeMXNetLib2"

/*******************************************************************************************
  MODULE I/O
*******************************************************************************************/

// --------------------- INPUTS

DIGITAL_INPUT _SKIP_, _SKIP_;
DIGITAL_INPUT MacroSave, MacroRecall;
				
STRING_INPUT  MacroName[MAX_STRING];

// --------------------- OUTPUTS

DIGITAL_OUTPUT _SKIP_, _SKIP_,
			   _SKIP_;
				
STRING_OUTPUT  LastRecalledMacro, CurrentMacroName;
				
/*******************************************************************************************
  PARAMETERS
*******************************************************************************************/

INTEGER_PARAMETER CommandProcessorID;

/*******************************************************************************************
  PARAMETER PROPERTIES
*******************************************************************************************/

/*******************************************************************************************
  GLOBAL VARIABLES
*******************************************************************************************/
                                           
// --------------------- SIMPL# Classes

MatrixMacroComponent matrixMacroComp;   

/*******************************************************************************************
  FUNCTIONS
*******************************************************************************************/

// --------------------- RESET
          
FUNCTION ResetOutputs()
{
  // -- SERIALS

  LastRecalledMacro = NULL_STRING;
}

// --------------------- SIMPL# EVENT HANDLERS


EVENTHANDLER OnLastRecalled (MatrixMacroComponent sender, SerEventArgs args)
{
  LastRecalledMacro = args.Payload;
}


EVENTHANDLER OnMacroName (MatrixMacroComponent sender, SerEventArgs args)
{
  CurrentMacroName = args.Payload;
}



/*******************************************************************************************
  EVENT HANDLERS
*******************************************************************************************/

// --------------------- RECALL  

THREADSAFE PUSH MacroRecall
{
  matrixMacroComp.RecallMacro(MacroName);
}

// --------------------- SAVE  

THREADSAFE PUSH MacroSave
{
  matrixMacroComp.SaveMacro(MacroName);
}

THREADSAFE CHANGE MacroName
{
 	matrixMacroComp.SetMacroName(MacroName);

}

/*******************************************************************************************
  MAIN
*******************************************************************************************/

FUNCTION Main()
{
  WAITFORINITIALIZATIONCOMPLETE();
	
  ResetOutputs();

  REGISTEREVENT(matrixMacroComp, OnLastRecalled, OnLastRecalled);
  REGISTEREVENT(matrixMacroComp, OnMacroName, OnMacroName);

  matrixMacroComp.Configure(CommandProcessorID);
}
