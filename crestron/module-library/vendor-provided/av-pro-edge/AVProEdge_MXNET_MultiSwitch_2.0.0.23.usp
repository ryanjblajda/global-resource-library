
#define_constant MAX_OUTPUTS  200
#define_constant MAX_INPUTS  200

buffer_input RX[10000];
Digital_input SYNCHRONISE;

string_output TX;
analog_input OUTPUT[MAX_OUTPUTS];
digital_output Clear;

analog_output  OUTPUT_STATUS[MAX_OUTPUTS];

CMutex buffer_mutex;

integer setValue[200];

push SYNCHRONISE  
{
	integer cntOut, cntIn;
	string tempOut[256], cmd[10000];
	for (cntIn = 0 to MAX_INPUTS)
	{
		for (cntOut = 1 to MAX_OUTPUTS)
		{
			if (cntIn = setValue[cntOut])
			{
				tempOut = tempOut + itoa(cntOut) + ",";
			}
		}
		if ("" != tempOut)
		{
			tempOut = left( tempOut, len( tempOut ) -1 ); //remove last ,
			cmd = cmd + "SW " + tempOut + "=" + itoa( cntIn ) + ";";
		}
		tempOut = "";
	}
	while(len( cmd ) > 255)
	{
		TX = removebylength(255, cmd);
	}
	TX = cmd;
	Clear = 1;
	
}

threadsafe change OUTPUT
{
	integer i; 
	i = getlastmodifiedarrayindex();
	setValue[i] = OUTPUT[i];
}

THREADSAFE change RX
{                                                                  
	string sO[4], cmd[100], sOutputs[100];
	integer iInput, iOutput;
	SetArray(setValue, 999);        
	buffer_mutex.WaitForMutex();
	while(len(RX) > 5 && find( ";", RX, 1 ) > 0)
	{
		cmd = gather( ";", RX );
		cmd = left( cmd, len( cmd ) -1 ); //remove ;
		
		if (len(cmd) > 4 && find( "SW ", cmd, 1 ) > 0)
		{
			sOutputs = remove( "SW ", cmd );
			sOutputs = remove( "=", cmd );
			iInput = atoi( cmd );
			sOutputs = left( sOutputs, len( sOutputs ) -1 ); //remove =
			
			while(len( sOutputs ) > 0 && find( ",", sOutputs, 1 ) > 0)
			{
				sO = remove( ",", sOutputs, 1 ); 
				sO = left( sO, len( sO ) -1 ); //remove ,
				iOutput = atoi( sO );
				if (iOutput <= MAX_OUTPUTS)
				{
					if(OUTPUT_STATUS[iOutput] != iInput)
					{
						OUTPUT_STATUS[iOutput] = iInput;
					}
				}
				else
				{
					Print( "%d is not a support output\n", iOutput );
				}
			}
			
			sO = sOutputs;
			iOutput = atoi( sO );
			if (iOutput <= MAX_OUTPUTS)
			{
				if(OUTPUT_STATUS[iOutput] != iInput)
				{
					OUTPUT_STATUS[iOutput] = iInput;
				}
			}
			else
			{
				Print( "%d is not a support output\n", iOutput );
			}
		}
	}
	buffer_mutex.ReleaseMutex();		
}

Function Main()
{
	SetArray(setValue, 999);
}
