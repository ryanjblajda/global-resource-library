#define_constant MAX_INPUTS  200

digital_input set_1080P_2CH[MAX_INPUTS];
digital_input set_1080P_6CH[MAX_INPUTS];  

digital_input set_1080P_3D_2CH[MAX_INPUTS];
digital_input set_1080P_3D_6CH[MAX_INPUTS];

digital_input set_4k30HZ_3D_2CH[MAX_INPUTS];
digital_input set_4k30HZ_3D_6CH[MAX_INPUTS];
digital_input set_4k30HZ_3D_8CH[MAX_INPUTS];

digital_input set_1080P_2CH_HDR[MAX_INPUTS];
digital_input set_1080P_6CH_HDR[MAX_INPUTS];

digital_input set_1080P_3D_2CH_HDR[MAX_INPUTS];
digital_input set_1080P_3D_6CH_HDR[MAX_INPUTS];

digital_input set_4k30HZ_3D_2CH_HDR[MAX_INPUTS];
digital_input set_4k30HZ_3D_6CH_HDR[MAX_INPUTS];
