digital_input set_1920X1200_2D_2CH_HDR[MAX_INPUTS];
digital_input set_USER_EDID[MAX_INPUTS];


string_output CONFIGURE_TX_CMD;
         

push set_1080P_2CH
{
  integer i;
  String cmd[256];

  i = getlastmodifiedarrayindex();
  makestring( CMD, "config set device edid 0 INPUT_ALIAS[%d];" , i ) ;
  CONFIGURE_TX_CMD = cmd;
}

