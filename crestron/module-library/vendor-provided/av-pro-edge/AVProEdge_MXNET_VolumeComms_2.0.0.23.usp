#DEFAULT_VOLATILE

#ENABLE_STACK_CHECKING

#ENABLE_TRACE

#ENCODING_ASCII

#INCLUDEPATH "..\\AVProEdge_MXNET\\SimplSharp\\AVProEdge_MXNET\\bin\\debug"
#USER_SIMPLSHARP_LIBRARY "libAVProEdge_MXNET_2.0.0.23"
#define_constant MAX_OUTPUTS  200
                 


ANALOG_INPUT VOLUME[MAX_OUTPUTS];
DIGITAL_INPUT VOLUME_UP[MAX_OUTPUTS]; 
DIGITAL_INPUT VOLUME_DOWN[MAX_OUTPUTS]; 

DIGITAL_INPUT MUTE_ON[MAX_OUTPUTS]; 
DIGITAL_INPUT MUTE_OFF[MAX_OUTPUTS];
DIGITAL_INPUT MUTE_TOGGLE[MAX_OUTPUTS];
  
DIGITAL_OUTPUT IS_MUTED[MAX_OUTPUTS];
ANALOG_OUTPUT CURRENT_VOLUME[MAX_OUTPUTS];
STRING_OUTPUT CURRENT_NATIVE_VOLUME[MAX_OUTPUTS];
STRING_OUTPUT CURRENT_PERCENT_VOLUME[MAX_OUTPUTS];


/*******************************************************************************************
Parameters
*******************************************************************************************/


/*******************************************************************************************
  Global Variables
  (Uncomment and declare global variables as needed)
  Note:  Be sure to initialize all declared STRING variables as needed
         For example, in Function Main: myString = "";
*******************************************************************************************/
SimplSharpHelperVolume mySimplSharpHelperVolume;
/*******************************************************************************************
  Functions
  (Add any additional functions here)
  Note:  Functions must be physically placed before the location in
         the code that calls them.
*******************************************************************************************/



threadsafe change VOLUME
{
	integer o;
	o = getlastmodifiedarrayindex();
	mySimplSharpHelperVolume.SetVolume(o, VOLUME[o]);
}


threadsafe push VOLUME_UP
{
	integer o;
	o = getlastmodifiedarrayindex();
	mySimplSharpHelperVolume.VolumeUp( o);	
}

threadsafe push VOLUME_DOWN
{
	integer o;
	o = getlastmodifiedarrayindex();
	mySimplSharpHelperVolume.VolumeDown( o );	
}
    

threadsafe push MUTE_ON
{
	integer o;
	o = getlastmodifiedarrayindex();
	mySimplSharpHelperVolume.Mute( o );	
}

threadsafe push MUTE_OFF
{
	integer o;
	o = getlastmodifiedarrayindex();
	mySimplSharpHelperVolume.UnMute( o );	
} 
    

threadsafe push MUTE_TOGGLE
{
	integer o;
	o = getlastmodifiedarrayindex();
	mySimplSharpHelperVolume.ToggleMute( o );	
}  


threadsafe release VOLUME_UP
{
	integer o;
	o = getlastmodifiedarrayindex();
	mySimplSharpHelperVolume.VolumeStop( o);	
}

threadsafe release VOLUME_DOWN
{
	integer o;
	o = getlastmodifiedarrayindex();
	mySimplSharpHelperVolume.VolumeStop( o);	
}


Function Init()
{
	RegisterEvent(mySimplSharpHelperVolume, VolumeToSend, VolumeToSendFB);
	RegisterEvent(mySimplSharpHelperVolume, MuteToSend, MuteToSendFB);

}

eventhandler VolumeToSendFB(SimplSharpHelperVolume sender, VolumeEventArgs args)
{
		CURRENT_VOLUME[args.Output] = args.Volume;  
		CURRENT_NATIVE_VOLUME[args.Output] = itoa( args.NativeVolume ); 
		CURRENT_PERCENT_VOLUME[args.Output] = itoa( args.PercentageVolume ); 

}

eventhandler MuteToSendFB(SimplSharpHelperVolume sender, MuteEventArgs args)
{
		IS_MUTED[args.Output] = args.iMute;  
}

/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/

Function Main()
{
	WaitForInitializationComplete();
	Init();
}
