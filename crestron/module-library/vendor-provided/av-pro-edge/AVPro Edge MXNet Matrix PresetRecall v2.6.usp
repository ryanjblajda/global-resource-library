/*******************************************************************************************
  INFORMATION
*******************************************************************************************/

/*
Dealer Name: Control Concepts, Inc.
System Name: AVPro Edge MXNet Matrix PresetRecall v2.6
Programmer:  JJM
Version:     2.5
*/

/*******************************************************************************************
  COMPILER DIRECTIVES
*******************************************************************************************/

#SYMBOL_NAME "AVPro Edge MXNet Matrix PresetRecall v2.6"
#CATEGORY "0"
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

// #ENABLE_DYNAMIC
// #HINT ""
// #PRINT_TO_TRACE
// #DIGITAL_EXPAND 
// #ANALOG_SERIAL_EXPAND 
// #OUTPUT_SHIFT 
// #HELP_PDF_FILE ""
// #ENCODING_ASCII
// #ENCODING_UTF16
// #ENCODING_INHERIT_FROM_PARENT
// #ENCODING_INHERIT_FROM_PROGRAM

/*******************************************************************************************
  CONSTANTS
*******************************************************************************************/

#DEFINE_CONSTANT TRUE 1
#DEFINE_CONSTANT FALSE 0
#DEFINE_CONSTANT MAX_STRING 255
#DEFINE_CONSTANT NULL_STRING ""
#DEFINE_CONSTANT NULL_VALUE 0

#HELP_BEGIN
To be used with AVPro Edge MXNet Matrix PresetRecall v2.6.umc module only.
Not to be used as a stand-alone module.
#HELP_END

/*******************************************************************************************
  INCLUDE LIBRARIES
*******************************************************************************************/

#USER_SIMPLSHARP_LIBRARY "AVProEdgeMXNetLib2"

/*******************************************************************************************
  MODULE I/O
*******************************************************************************************/

// --------------------- INPUTS

DIGITAL_INPUT _SKIP_, _SKIP_, _SKIP_;
DIGITAL_INPUT PresetRecall;
				
STRING_INPUT  PresetName[MAX_STRING];

// --------------------- OUTPUTS

DIGITAL_OUTPUT _SKIP_, _SKIP_, _SKIP_,
			   _SKIP_;
				
STRING_OUTPUT  LastRecalledPreset;
				
/*******************************************************************************************
  PARAMETERS
*******************************************************************************************/

INTEGER_PARAMETER CommandProcessorID;
INTEGER_PARAMETER DestinationRouter_PollDelay;

/*******************************************************************************************
  PARAMETER PROPERTIES
*******************************************************************************************/
#BEGIN_PARAMETER_PROPERTIES DestinationRouter_PollDelay
   propValidUnits = unitTime;
   propDefaultUnit = unitTime;
   propDefaultValue = 10s;
#END_PARAMETER_PROPERTIES

/*******************************************************************************************
  GLOBAL VARIABLES
*******************************************************************************************/

// --------------------- SIMPL# Classes

MatrixPresetRecallComponent presetRecallComp;   

/*******************************************************************************************
  FUNCTIONS
*******************************************************************************************/

// --------------------- RESET
          
FUNCTION ResetOutputs()
{
  // -- SERIALS

  LastRecalledPreset = NULL_STRING;
}

// --------------------- SIMPL# EVENT HANDLERS


EVENTHANDLER OnLastRecalled (MatrixPresetRecallComponent sender, SerEventArgs args)
{
  LastRecalledPreset = args.Payload;
}


/*******************************************************************************************
  EVENT HANDLERS
*******************************************************************************************/

// --------------------- RECALL  

THREADSAFE PUSH PresetRecall
{
  presetRecallComp.RecallPreset(PresetName);
}

/*******************************************************************************************
  MAIN
*******************************************************************************************/

FUNCTION Main()
{
  WAITFORINITIALIZATIONCOMPLETE();
	
  ResetOutputs();

  REGISTEREVENT(presetRecallComp, OnLastRecalled, OnLastRecalled);

  presetRecallComp.DestinationRouterPollDelay = DestinationRouter_PollDelay;

  presetRecallComp.Configure(CommandProcessorID);
}
