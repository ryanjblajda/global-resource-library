	integer i,X;
	i = getlastmodifiedarrayindex();
	X = I;
	if(i = 5) { X = 0; } //Change all
	CSInstance.SetHDMIAudioMute( X , 1 );
}

PUSH OUTPUT_MUTE_OFF
{
	integer i,X;
	i = getlastmodifiedarrayindex();
