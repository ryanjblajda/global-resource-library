
#DEFINE_CONSTANT TRUE 1
#DEFINE_CONSTANT FALSE 0
#DEFINE_CONSTANT MAX_RS232 4


#INCLUDEPATH "..\\cxxx\\SimplSharp\\CXseries\\bin"
#USER_SIMPLSHARP_LIBRARY "CXseries"

BUFFER_INPUT SERIAL_RX[60000];
STRING_INPUT CONSOLE_COMMAND[256];
STRING_INPUT CUSTOM_COMMAND[256];

DIGITAL_INPUT REBOOT_DEVICE;

DIGITAL_INPUT SINGLE_SWITCH_MODE; 
DIGITAL_INPUT DOUBLE_SWITCH_MODE;


DIGITAL_INPUT AUDIO_EX_MIC_INPUT_ENABLE[5];

DIGITAL_INPUT VIDEO_MODE_LOW[5];
DIGITAL_INPUT VIDEO_MODE_HIGH[5];

ANALOG_INPUT MIC_VOLUME;

STRING_INPUT  RS232_PASSTHROUGH_DATA[MAX_RS232][100];
ANALOG_INPUT RS232_PASSTHROUGH_BAUD[MAX_RS232];
           
ANALOG_INPUT OUTPUTS[5];
ANALOG_INPUT AUDIO_OUTPUTS[5];

DIGITAL_INPUT EX_AUDIO_ENABLE[5];

DIGITAL_INPUT OUTPUT_STREAM_OFF[5];
DIGITAL_INPUT OUTPUT_STREAM_ON[5];

DIGITAL_INPUT OUTPUT_MUTE_ON[5];  
DIGITAL_INPUT OUTPUT_MUTE_OFF[5];  

DIGITAL_INPUT OUTPUT_SIGNAL_GEN_ENABLE[5];  

DIGITAL_INPUT ZONE_VOLUME_UP[4]; 
DIGITAL_INPUT ZONE_VOLUME_DOWN[4]; 
ANALOG_INPUT ZONE_VOLUME_SET[4]; 

STRING_OUTPUT SERIAL_TX;
STRING_OUTPUT CONNECTION_STATUS;
DIGITAL_OUTPUT CONNECTION_STATE;
ANALOG_OUTPUT MIC_VOLUME_FB;
ANALOG_OUTPUT OUTPUT_FB[4];
ANALOG_OUTPUT AUDIO_OUTPUT_FB[4];
ANALOG_OUTPUT ZONE_CURRENT_VOLUME[4];
STRING_OUTPUT ZONE_CURRENT_NATIVE_VOLUME[4];
STRING_OUTPUT ZONE_CURRENT_PERCENT_VOLUME[4];



/*******************************************************************************************
  Parameters
  (Uncomment and declare parameters as needed)
*******************************************************************************************/
STRING_PARAMETER IP_ADDRESS[16];
INTEGER_PARAMETER PORT;
INTEGER_PARAMETER MODEL;
LONG_INTEGER_PARAMETER POLL_TIME;


/*******************************************************************************************
  Global Variables
  (Uncomment and declare global variables as needed)
  Note:  Be sure to initialize all declared STRING variables as needed
         For example, in Function Main: myString = "";
*******************************************************************************************/
CXseries CSInstance;
CMutex string_mutex;
CMutex work_mutex;
INTEGER IS_IP;


/*******************************************************************************************
  Functions
  (Add any additional functions here)
  Note:  Functions must be physically placed before the location in
         the code that calls them.
*******************************************************************************************/
CALLBACK FUNCTION SerialTXSimpl(string toSend)
{
	SERIAL_TX = toSend;
}

CALLBACK FUNCTION SerialTxFunc(integer message[])
{
	integer iSize, i;
	string sMessage[1000];
	sMessage = "";
	iSize = GetNumArrayCols(message);
	for (i = 0 to iSize)
	{
		sMessage = sMessage + chr(message[i]);
	}
	SERIAL_TX = sMessage;
	Delay(10); // Slow down comms slightly so that signals don't overwrite each other
}

CALLBACK FUNCTION ConnectionStatusFunc(string connstatus)
{
	CONNECTION_STATUS = connstatus;
}


CALLBACK FUNCTION ConnectionStateFunc(integer connstate)
{
	CONNECTION_STATE = connstate;
}

CALLBACK FUNCTION StatusStateFunc(integer x, integer i )
{
	if (x = 0)
	{
		setarray(OUTPUT_FB, i);
	}
	else
	{
		OUTPUT_FB[x] = i;
	}
}

CALLBACK FUNCTION VolUpdateFunc( integer o, integer v)
{
	ZONE_CURRENT_VOLUME[o] = v;  
}
                         
CALLBACK FUNCTION VolUpdatePercentageFunc( integer o, integer v)
{
	ZONE_CURRENT_PERCENT_VOLUME[o] = itoa(v);  
}

CALLBACK FUNCTION VolUpdateNativeFunc( integer o, integer v)
{
	ZONE_CURRENT_NATIVE_VOLUME[o] = itoa(v);  
}


CALLBACK FUNCTION AudioStatusStateFunc(integer x, integer i )
{
	if (x = 0)
	{
		setarray(AUDIO_OUTPUT_FB, i);
	}
	else
	{
		AUDIO_OUTPUT_FB[x] = i;
	}
}


CALLBACK FUNCTION MicVolumeFunc(integer x )
{
	MIC_VOLUME_FB = x;
}
/*******************************************************************************************
  Event Handlers
  (Uncomment and declare additional event handlers as needed)
*******************************************************************************************/
CHANGE SERIAL_RX
{
	STRING serial[60000];      
	
	string_mutex.WaitForMutex();
	serial = RemoveByLength( len( SERIAL_RX ), SERIAL_RX );
	if (0 != len( serial ))
	{
		work_mutex.WaitForMutex();
		string_mutex.ReleaseMutex();
		
		CSInstance.SetSerialRx(serial);
		
		work_mutex.ReleaseMutex();
		Delay(500);
	}
	else
	{
		string_mutex.ReleaseMutex();
	}
}


CHANGE ZONE_VOLUME_SET
{
	integer o;
	o = getlastmodifiedarrayindex();
	CSInstance.SetOutputAnalogVolume(o,ZONE_VOLUME_SET[o]);
}



CHANGE OUTPUTS
{
	integer i,X;
	i = getlastmodifiedarrayindex();
	X = I;
	if(i = 5) { 
		X = 0; } //Change all
	
	CSInstance.SetOutputToInput( X, OUTPUTS[i] );
}


CHANGE AUDIO_OUTPUTS
{
	integer i,X;
	i = getlastmodifiedarrayindex();
	X = I;
	if(i = 5) { 
		X = 0; } //Change all
	
	CSInstance.SetAudioOutputToInput( X, AUDIO_OUTPUTS[i] );
}

RELEASE ZONE_VOLUME_UP
{
	integer o;
	o = getlastmodifiedarrayindex();
	CSInstance.setVolumeStep( o,1);	
}

RELEASE ZONE_VOLUME_DOWN
{
	integer o;
	o = getlastmodifiedarrayindex();
	CSInstance.setVolumeStep( o,0);	
}




PUSH REBOOT_DEVICE { CSInstance.RebootUnit(); }

PUSH SINGLE_SWITCH_MODE { CSInstance.SetSwitchMode(0); }
PUSH DOUBLE_SWITCH_MODE { CSInstance.SetSwitchMode(1); }


