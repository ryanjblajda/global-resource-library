CHANGE CONSOLE_COMMAND
{
	CSInstance.ConsoleCommand( CONSOLE_COMMAND );
}

THREADSAFE CHANGE RS232_PASSTHROUGH_DATA
{
	integer i;
	i = getlastmodifiedarrayindex();

	CSInstance.SendRS232String(i , RS232_PASSTHROUGH_BAUD[i] , RS232_PASSTHROUGH_DATA[i] );
}

THREADSAFE CHANGE CUSTOM_COMMAND
{
	CSInstance.CustomCommand(CUSTOM_COMMAND);
	clearbuffer(CUSTOM_COMMAND);	
}

CHANGE MIC_VOLUME
{
	CSInstance.setMicVolume( MIC_VOLUME );
}



/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/

Function Main()
{
	WaitForInitializationComplete();
	RegisterDelegate(CSInstance, TheSerialTXDelegate, SerialTXSimpl);
	RegisterDelegate(CSInstance, ConnectionStatusDelegate, ConnectionStatusFunc);
	RegisterDelegate(CSInstance, ConnectionStateDelegate, ConnectionStateFunc);
	RegisterDelegate(CSInstance, OutputToInputDelegate, StatusStateFunc);
	RegisterDelegate(CSInstance, AudioOutputToInputDelegate, AudioStatusStateFunc);
	RegisterDelegate(CSInstance, MicVolumeDelegate, MicVolumeFunc);
	RegisterDelegate(CSInstance, VolumeDelegate,  VolUpdateFunc);
	RegisterDelegate(CSInstance, VolumePercentageDelegate,  VolUpdatePercentageFunc);
	RegisterDelegate(CSInstance, VolumeNativeDelegate,  VolUpdateNativeFunc);


	
	
	
	Print("Create Connection");
	if(IP_ADDRESS != ""){
		CSInstance.CreateTCPConnection(IP_ADDRESS,PORT,POLL_TIME, MODEL);
	}else{
		CSInstance.CreateSerialConnection(POLL_TIME, MODEL);
	}
}

