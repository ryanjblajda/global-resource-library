// SIMPL+ Module Information
/*
Dealer Name:	Front Side Solutions, Inc.
Programmer:		cdr
Comments:			A&H AHM64 XPoint Mute Control
*/

// Compiler Directives
#ENABLE_DYNAMIC
#SYMBOL_NAME "AandH XPointMute Control-AHM64"
#CATEGORY "34" // Mixer
// #PRINT_TO_TRACE
// #DIGITAL_EXPAND 
// #ANALOG_SERIAL_EXPAND
// #OUTPUT_SHIFT
// #HELP_PDF_FILE ""
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

#HELP_BEGIN
AandH XPointMute Control-AHM64 r0.0

Controls Input to Zone, and Zone to Zone mutes.

Parameters:
 Input ControlType: 	Select Input, Zone or Group.
 Input ControlChnl: 	Select valid range from control type in decimal format.
 Output ControlType: 	Select Input, Zone or Group.
 Output ControlChnl: 	Select valid range from control type in decimal format.

Inputs:
 Digital-
  MuteOn/Off/Toggle: Pulse to turn mute on/off or toggle state.
	Poll: Pulse to poll the current Mute. Should only be needed for initial 
			reading of Mute at code start and after recalling a preset. 

 Serial-
  FmMixer: Connect to the TCP/IP symbol receive line.

Outputs:
 Digital-
  MuteOnFb/OffFb: Mute Feedback. This is tracked internally
   by the module. It is also updated when the mixer sends
   feedback when the control is nudged.

 Serial-
  ToMixer: Connect to the TCP/IP symbol Transmit line.

Notes:
 Reference the AHM64 protocol for valid Control Channels for the
  selected control type.

 For more information Reference: AHM-TCP-Protocol-V1.pdf

 Tested with AHM64 Firmware V1.02 - Rev59154

 Release: 2020-Nov-19 Release r0.0

#HELP_END


// DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
DIGITAL_INPUT 	_SKIP_,_SKIP_,_SKIP_,_SKIP_,MuteOn, MuteOff, MuteToggle, Poll;
BUFFER_INPUT 		FmMixer[1024];
DIGITAL_OUTPUT 	_SKIP_,_SKIP_,_SKIP_,_SKIP_,MuteOnFb, MuteOffFb;
STRING_OUTPUT 	_SKIP_,_SKIP_,ToMixer;

// Parameters
INTEGER_PARAMETER	IptControlType;
INTEGER_PARAMETER	IptControlChnl;
INTEGER_PARAMETER	OptControlChnl;
// Parameter Properties
#BEGIN_PARAMETER_PROPERTIES IptControlChnl
	propValidUnits = unitDecimal;
	propDefaultUnit = unitDecimal;
	propBounds = 1d , 128d;
  propDefaultValue = 1d;
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES IptControlType
	propValidUnits = unitDecimal;
  propList = 	{1d ,"Input"},
  						{2d ,"Zone"};
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES OptControlChnl
	propValidUnits = unitDecimal;
	propDefaultUnit = unitDecimal;
	propBounds = 1d , 128d;
  propDefaultValue = 1d;
#END_PARAMETER_PROPERTIES

// Global Variables
STRING cType[2][2], cCtrlChnl[2][2], cCmd[3][20];
STRING cCmdSysExHdr[8], cPollCmd[20];
NONVOLATILE INTEGER	nState;

// Functions
Function BuildFb()
{
  If(nState)
  {
	  MuteOffFb = 0;
	  MuteOnFb = 1;
	}
  Else
  {
	  MuteOnFb = 0;
	  MuteOffFb = 1;
	}
}

// Event Handlers
PUSH MuteOn
{
	nState = 1;
	Makestring(ToMixer, "%s", cCmd[1]);
	Wait(5)
	{
		Makestring(ToMixer, "%s", cPollCmd);
		BuildFb();
	}
}
PUSH MuteOff
{
	nState = 0;
	Makestring(ToMixer, "%s", cCmd[2]);
	Wait(5)
	{
		Makestring(ToMixer, "%s", cPollCmd);
		BuildFb();
	}
}
PUSH MuteToggle
{
	nState =! nState;
  If(nState)
		Makestring(ToMixer, "%s", cCmd[1]);
  Else
		Makestring(ToMixer, "%s", cCmd[2]);
	Wait(5)
	{
		Makestring(ToMixer, "%s", cPollCmd);
		BuildFb();
	}
}

PUSH Poll
{
	Makestring(ToMixer, "%s", cPollCmd);
}

THREADSAFE CHANGE FmMixer
{
// Standard Mute unsolicited Responses 
// \xF0\x00\x00\x1A\x50\x12\x01\x00 \x00\x03\x00 \x01\x00\x7F\xF7 // Input 1 to Zone 1 Mute On
	If (Find (cCmd[1],FmMixer))
	{
		nState = 1;
		BuildFb();
		ClearBuffer(FmMixer);
	}
	Else If (Find (cCmd[2],FmMixer))
	{
		nState = 0;
		BuildFb();
		ClearBuffer(FmMixer);
	}
	Else
	{
		ClearBuffer(FmMixer);
	}
}

// Main()
Function Main()
{
	WaitForInitializationComplete();

	cType[1] = CHR(IptControlType - 1);
	cType[2] = "\x01";	//Destination is always zone.

	cCtrlChnl[1] = CHR(IptControlChnl - 1);
	cCtrlChnl[2] = CHR(OptControlChnl - 1);


	Makestring(cCmdSysExHdr, "\xF0\x00\x00\x1A\x50\x12\x01\x00");

//\xF0\x00\x00\x1A\x50\x12\x01\x00 \x00\x03\x00 \x01\x00\x7F \xF7 // Input 1 to Zone 1 Mute On
	Makestring(cCmd[1],"%s%s\x03%s%s%s\x7F\xF7", cCmdSysExHdr,cType[1],cCtrlChnl[1],cType[2],cCtrlChnl[2]);// MuteOn
	Makestring(cCmd[2],"%s%s\x03%s%s%s\x3F\xF7", cCmdSysExHdr,cType[1],cCtrlChnl[1],cType[2],cCtrlChnl[2]);// MuteOff
	Makestring(cPollCmd, "%s%s\x01\x0F\x03%s%s%s\xF7",cCmdSysExHdr,cType[1],cCtrlChnl[1],cType[2],cCtrlChnl[2]);//Poll


// Response
// \xF0\x00\x00\x1A\x50\x12\x01\x00 \x00\x03\x00 \x01\x00\x7F\xF7 // Input 1 to Zone 1 Mute On
	BuildFb();
}	
