// SIMPL+ Module Information
/*
Dealer Name:	Front Side Solutions, Inc.
Programmer:		cdr
Comments:			A&H AHM64 Level Control
*/

// Compiler Directives
#ENABLE_DYNAMIC
#SYMBOL_NAME "AandH Level Control-AHM64"
#CATEGORY "34" // Mixer
// #PRINT_TO_TRACE
// #DIGITAL_EXPAND 
// #ANALOG_SERIAL_EXPAND
// #OUTPUT_SHIFT
// #HELP_PDF_FILE ""
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

#HELP_BEGIN
AandH Level Control-AHM64 r0.0.usp

Controls Input, Zone and Group levels.

Parameters:
 ControlType: Select Input, Zone or Group.
 ControlChnl: Select valid range from control type in decimal format.

Inputs:
 Analog-
  FdrLvl: Set the analog to the range of 0d~127d (00h~7Fh).
  		See documentation for dBu converstion.
  Inc: Increment Level (1) step with each pulse.
  Dec: Decrement Level (1) step with each pulse.
  		Note: Increment and Decrement does not ramp, must be down external to the module.
	Poll: Pulse to poll and sync the current level. Should only be needed for initial 
			reading of level at code start or after recalling a preset. Module will poll
			internally for other changes.
 Serial-
  FmMixer: Connect to the TCP/IP symbol receive line.

Outputs:
 Analog-
  FdrLvlFb: Feedback of the level in the range of 0d~127d (00h~7Fh). 
	This is tracked internally by the module. It is also updated
	when the mixer sends feedback when the control is nudged or on a poll.
  
 Serial-
  ToMixer: Connect to the TCP/IP symbol Transmit line.

Notes:
 Reference the AHM64 protocol for valid Control Channels for the
  selected control type.

 For more information Reference: AHM-TCP-Protocol-V1.pdf

 Tested with AHM64 Firmware V1.02 - Rev59154

 Release: 2020-Dec-16 Release r0.0

#HELP_END


// DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
DIGITAL_INPUT		_SKIP_,_SKIP_,Inc, Dec, Poll;
ANALOG_INPUT		FdrLvl;
BUFFER_INPUT 		FmMixer[1024];
ANALOG_OUTPUT		_SKIP_,_SKIP_,_SKIP_,_SKIP_,_SKIP_,FdrLvlFb;
STRING_OUTPUT 	ToMixer;

// Parameters
INTEGER_PARAMETER	ControlType;
INTEGER_PARAMETER	ControlChnl;
// Parameter Properties
#BEGIN_PARAMETER_PROPERTIES ControlChnl
	propValidUnits = unitDecimal;
	propDefaultUnit = unitDecimal;
	propBounds = 1d , 128d;
  propDefaultValue = 1d;
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES ControlType
	propValidUnits = unitDecimal;
  propList = 	{1d ,"Input"},
  						{2d ,"Zone"},
  						{3d ,"Group"};
#END_PARAMETER_PROPERTIES

// Global Variables
STRING cType[2], cCtrlChnl[2], cCmd[3][9],cRxCmd[6];
STRING cCmdSysExHdr[8], cPollType[2], cPollCmd[14];

NONVOLATILE INTEGER	nLvl;

// Functions
Function BuildFb()
{
	FdrLvlFb = nLvl;
}

// Event Handlers
CHANGE FdrLvl
{
  CancelAllWait();
  nLvl = FdrLvl;
	Makestring(ToMixer, "%s%s", cCmd[1],CHR(nLvl));
	BuildFb();
	Wait(200)
		Makestring(ToMixer, "%s", cPollCmd);
}

PUSH Inc
{
	Makestring(ToMixer, "%s", cCmd[2]);
	Wait(5)
		Makestring(ToMixer, "%s", cPollCmd);
}

PUSH Dec
{
	Makestring(ToMixer, "%s", cCmd[3]);
	Wait(5)
		Makestring(ToMixer, "%s", cPollCmd);
}

PUSH Poll
{
	Makestring(ToMixer, "%s", cPollCmd);
}

THREADSAFE CHANGE FmMixer
{
	INTEGER nLoc;
	STRING cTrash[100],cTemp[1];

	While (Len(FmMixer))
	{
		If (Find (cRxCmd,FmMixer))
		{
			cTrash = Remove(cRxCmd,FmMixer);
			cTemp = Left(FmMixer,1);
			nLvl = Byte(cTemp,1);
			BuildFb();
			ClearBuffer(FmMixer);
		}
		Else
		{
			ClearBuffer(FmMixer);
		}
	}
}

// Main()
Function Main()
{
	WaitForInitializationComplete();

	cType = CHR(0xB0 + ControlType - 1);
	cCtrlChnl = CHR(ControlChnl - 1);

/*
	CSwitch (ControlType)
	{
		CASE (1):	//Input
		{
			cType = "\xB0";
			cCtrlChnl = CHR(0x00 + ControlChnl - 1);
			Break;
		}
		CASE (2): //Zone
		{
			cType = "\xB1";
			cCtrlChnl = CHR(0x00 + ControlChnl - 1);
			Break;
		}
		CASE (3): //Group
		{
			cType = "\xB2";
			cCtrlChnl = CHR(0x00 + ControlChnl - 1);
			Break;
		}
	}
*/
	cPollType = CHR(0x00 + ControlType - 1);
	Makestring(cCmdSysExHdr, "\xF0\x00\x00\x1A\x50\x12\x01\x00");

	Makestring(cCmd[1],"%s\x63%s%s\x62\x17%s\x06", cType,cCtrlChnl,cType,cType);// Level
	Makestring(cCmd[2],"%s\x63%s%s\x62\x20%s\x06\x7F", cType,cCtrlChnl,cType,cType);// Inc
	Makestring(cCmd[3],"%s\x63%s%s\x62\x20%s\x06\x3F", cType,cCtrlChnl,cType,cType);// Dec

	Makestring(cPollCmd, "%S%S\x01\x0B\x17%S\xF7",cCmdSysExHdr,cPollType, cCtrlChnl);//Poll
  
  // Response
	Makestring(cRxCmd,"%s\x63%s\x62\x17\x06", cType, cCtrlChnl);


	BuildFb();
}	
