#SYMBOL_NAME "Epson TCP/IP Driver v1.0"
// #HINT ""
#DEFINE_CONSTANT	ciCONNECTFAILED		0
#DEFINE_CONSTANT	ciCONNECTED			1
#DEFINE_CONSTANT	ciINVALIDPASS	2
#DEFINE_CONSTANT	ciCONNECTING	3
#DEFINE_CONSTANT	ciDISCONNECTED		4
#DEFINE_CONSTANT	ciDISCONNECTING		5

#DEFINE_CONSTANT	ciQUEUESIZE			30

#DEFINE_CONSTANT	csCONNOPASS			"ESC/VP.net\x10\x03\x00\x00\x00\x00"
#DEFINE_CONSTANT	csERRUNAUTH			"ESC/VP.net\x10\x02\x00\x00\x41\x00"
#DEFINE_CONSTANT	csERRBUSY		"ESC/VP.net\x10\x02\x00\x00\x53\x00"
#DEFINE_CONSTANT	csCONOK			"ESC/VP.net\x10\x03\x00\x00\x20\x00"
#DEFINE_CONSTANT	csERRINVALID		"ESC/VP.net\x10\x02\x00\x00\x43\x00"
#DEFINE_CONSTANT	csUNAUTHORIZED		"ESC/VP.net\x10\x03\x00\x00\x41\x00"
#DEFINE_CONSTANT	csCONPASS		"ESC/VP.net\x10\x03\x00\x00\x00\x01\x01\x01"

#DEFINE_CONSTANT	csCOMMANDEOM		"\x0D"

// #CATEGORY "" 
#CATEGORY "24" // TV/Video Projector
#DEFAULT_VOLATILE
// #DEFAULT_NONVOLATILE
// #PRINT_TO_TRACE
// #ENABLE_TRACE
/*
#HELP_BEGIN
   (add additional lines of help lines)
#HELP_END
*/
/***********************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
***********************************************************************************/
DIGITAL_INPUT	Connect, Connected, Disconnect, Time_Out;
// ANALOG_INPUT 
STRING_INPUT	From_Device$[250];
BUFFER_INPUT	From_Module$[500];

DIGITAL_OUTPUT	Connect_Out, Ok_to_Send, Timed_Out;
ANALOG_OUTPUT		Status;
STRING_OUTPUT		To_Device$;
/***********************************************************************************
  Global Variables
  (Uncomment and declare global variables as needed)
  Note:  Be sure to initialize all declared STRING variables as needed
         For example, in Function Main: myString = "";
***********************************************************************************/
INTEGER	iFlag1, iFlag2, iNextSend, iNextStore, iSendOk, a;
STRING	sPassword[16], sTemp[250], sQueue[ciQUEUESIZE][50], sTemp1[50];

STRING_PARAMETER Password$[16]; 

//#BEGIN_PARAMETER_PROPERTIES Password$
//   propDefaultValue = "";
//#END_PARAMETER_PROPERTIES

/***********************************************************************************
  Functions
  (Add any additional functions here)
  Note:  Functions must be physically placed before the location in
         the code that calls them.
***********************************************************************************/
Function fTimeOut()
{
	wait(500, wTimeOut)
	{
		Timed_Out = 1;
	}
}

