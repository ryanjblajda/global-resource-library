/***********************************************************************************
  Event Handlers
  (Uncomment and declare additional event handlers as needed)
***********************************************************************************/
PUSH Connect
{
	if(Connected = 0)
	{
		Connect_Out = 1;
		Status = ciCONNECTING;
		iSendOk = 0;
		call fTimeOut();
	}
}

PUSH Connected
{
	To_Device$ = csCONPASS + sPassword;
}

PUSH Time_Out
{
	Timed_Out = 0;
	Connect_Out = 0;
	Status = ciCONNECTFAILED;
	iSendOk = 0;
	Ok_to_Send = 0;
}

RELEASE Connected
{
	Connect_Out = 0;
	Ok_to_Send = 0;
	iSendOk = 0;
	Status = ciDISCONNECTED;
}

PUSH Disconnect
{
	if(Connected = 1)
	{
		Connect_Out = 0;
		Ok_to_Send = 0;
		iSendOk = 0;
		Status = ciDISCONNECTING;
		call fTimeOut();
	}
	else
	{
		Connect_Out = 0;
		Ok_to_Send = 0;
		iSendOk = 0;
		Status = ciDISCONNECTED;
	}
}

/*
CHANGE Password$
{
	clearbuffer(sPassword);
	if(len(Password$) < 16)
	{
		for(a = 1 to (16 - len(Password$)))
			sPassword = sPassword + "\x00";
	} 
	sPassword = Password$ + sPassword;
}
*/
CHANGE From_Device$
{
	if(iFlag1 = 0)
	{
		iFlag1 = 1;
		while(len(From_Device$) > 0)
		{
			cancelwait(wTimeOut);
			sTemp = sTemp + From_Device$;
			clearbuffer(From_Device$);
			if(find(csCONOK, sTemp) > 0)
			{
				Status = ciCONNECTED;
				sTemp = "";
				if(iNextSend <> iNextStore)
				{
					To_Device$ = sQueue[iNextSend];
					iNextSend = inextSend + 1;
					if(iNextSend > ciQUEUESIZE)
					{
						iNextSend = 1;
					}
					iSendOk = 0;
					Ok_to_Send = 0;
				}
				else
				{
					iSendOk = 1;
					Ok_to_Send = 1;
				}
			}
			else if(find(csERRUNAUTH, sTemp) > 0)
			{
				makestring(To_Device$, "%s%s", csCONPASS, sPassword);
				Ok_to_Send = 0;
				iSendOk = 0;
				sTemp = "";
				call fTimeOut();
			}
/*			else if(find(csUNAUTHORIZED, sTemp) > 0)
			{
				makestring(To_Device$, "%s%s", csCONPASS, sPassword);
				Ok_to_Send = 0;
				iSendOk = 0;
				sTemp = "";
				call fTimeOut();
			}
*/			else if(find(csERRINVALID, sTemp) > 0)
			{
				Status = ciINVALIDPASS;
				Ok_to_Send = 0;
				iSendOk = 0;
				sTemp = "";
			}
			else if(find(csERRBUSY, sTemp) > 0)
			{
				Status = ciCONNECTFAILED;
				Ok_to_Send = 0;
				iSendOk = 0;
				sTemp = "";
			}
			else if((find("ESC/VP", sTemp) = 0) || (find("=", sTemp) > 0))
			{
				sTemp = "";
				if(iNextSend <> iNextStore)
				{
					To_Device$ = sQueue[iNextSend];
					iNextSend = inextSend + 1;
					if(iNextSend > ciQUEUESIZE)
					{
						iNextSend = 1;
					}
					iSendOk = 0;
					Ok_to_Send = 0;
				}
				else
				{
					Ok_to_Send = 1;
					iSendOk = 1;
				}
			}
		}
		iFlag1 = 0;
	}
}

CHANGE From_Module$
{
	if(iFlag2 = 0)
	{
		iFlag2 = 1;
		while(find(csCOMMANDEOM, From_Module$) > 0)
		{
			sTemp1 = remove(csCOMMANDEOM, From_Module$);
			if(iSendOk = 1)
			{
				To_Device$ = sTemp1;
				sTemp1 = "";
			}
			else
			{
				sQueue[iNextStore] = sTemp1;
				iNextStore = iNextStore + 1;
				if(iNextStore > ciQUEUESIZE)
				{
					iNextStore = 1;
				}
				sTemp1 = "";
				if(Connected = 0)
				{
					Connect_Out = 1;
					Status = ciCONNECTING;
				}
			}
		}
		iFlag2 = 0;
	}
}
/***********************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
***********************************************************************************/
Function Main()
{
	iFlag1 = 0;
	iFlag2 = 0;
	sTemp = "";
	sTemp1 = "";
	Status = ciDISCONNECTED;
	Connect_Out = 0;
	Ok_to_Send = 0;
	sPassword = "";
	iNextStore = 1;
	iNextSend = 1;
	iSendOk = 0;

	clearbuffer(sPassword);
	if(len(Password$) < 16)
	{
		for(a = 1 to (16 - len(Password$)))
			sPassword = sPassword + "\x00";
	} 
	sPassword = Password$ + sPassword;
}
