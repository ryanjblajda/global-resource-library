Function SendCommandQueued()
{
	if(iWaitingForResponse = 1 && (iPowerQueue <> 0 || iInputQueue <> 0 || iAVModeQueue <> 0 || iAspectQueue <> 0 || iVolumeMuteQueue <> 0
								|| iPIPModeQueue <> 0 || iPIPSourceQueue <> 0 || iPIPSoundQueue <> 0 || iPIPMainPosQueue <> 0 || iPBPSubPosQueue <> 0 || iDVISelectQueue <> 0 || iBNCSelectQueue <> 0 || iHDMISelectQueue <> 0))
	{
		if(iPowerQueue <> 0)
		{
			To_Device = SendPower(iPowerQueue);
		 	iCommand = ciPower;
			iPowerSent = iPowerQueue;
		}
		else if(iInputQueue <> 0)		
		{
			To_Device = SendInput(iInputQueue);
		 	iCommand = ciInput;
			iInputSent = iInputQueue;
		}
		else if(iAVModeQueue <> 0)		
		{
			To_Device = SendAVMode(iAVModeQueue);	   
		 	iCommand = ciAVMode;
			iAVModeSent = iAVModeQueue;
		}
		else if(iAspectQueue <> 0)		
		{
			To_Device = SendAspect(iAspectQueue);	   
		 	iCommand = ciAspect;
			iAspectSent = iAspectQueue;
		}
		else if(iVolumeMuteQueue <> 0)		
		{
			To_Device = SendVolumeMute(iVolumeMuteQueue);	   
		 	iCommand = ciVolumeMute;
			iVolumeMuteSent = iVolumeMuteQueue;
		}
		else if(iPIPModeQueue <> 0)		
		{
			To_Device = SendPIPMode(iPIPModeQueue);	   
		 	iCommand = ciPIPMode;
			iPIPModeSent = iPIPModeQueue;
		}
		else if(iPIPSourceQueue <> 0)		
		{
			To_Device = SendPIPSource(iPIPSourceQueue);	   
		 	iCommand = ciPIPSource;
			iPIPSourceSent = iPIPSourceQueue;
		}
		else if(iPIPSoundQueue <> 0)		
		{
			To_Device = SendPIPSound(iPIPSoundQueue);	   
		 	iCommand = ciPIPSound;
			iPIPSoundSent = iPIPSoundQueue;
		}
		else if(iPIPMainPosQueue <> 0)		
		{
			To_Device = SendPIPMainPos(iPIPMainPosQueue);	   
		 	iCommand = ciPIPMainPos;
			iPIPMainPosSent = iPIPMainPosQueue;
		}
		else if(iPBPSubPosQueue <> 0)		
		{
			To_Device = SendPBPSubPos(iPBPSubPosQueue);	   
		 	iCommand = ciPBPSubPos;
			iPBPSubPosSent = iPBPSubPosQueue;
		}
		else if(iDVISelectQueue <> 0)		
		{
			To_Device = SendDVISelect(iDVISelectQueue);	   
		 	iCommand = ciDVISelect;
			iDVISelectSent = iDVISelectQueue;
		}
		else if(iBNCSelectQueue <> 0)		
		{
			To_Device = SendBNCSelect(iBNCSelectQueue);	   
		 	iCommand = ciBNCSelect;
			iBNCSelectSent = iBNCSelectQueue;
		}
		else if(iHDMISelectQueue <> 0)		
		{
			To_Device = SendHDMISelect(iHDMISelectQueue);	   
		 	iCommand = ciHDMISelect;
			iHDMISelectSent = iHDMISelectQueue;
		}
	}
}
		
