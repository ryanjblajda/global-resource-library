  Event Handlers
  (Uncomment and declare additional event handlers as needed)
*******************************************************************************************/

PUSH Power
{
	iPowerQueue = getlastmodifiedarrayindex();
	
	if(iWaitingForResponse = 0)
	{
		To_Device = SendPower(iPowerQueue);
	 	iCommand = ciPower;
		iPowerSent = iPowerQueue;
		iWaitingForResponse = 1;
	}
}

