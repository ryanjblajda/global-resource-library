PUSH Auto
{
	iAutoQueue = 1;
	if(iWaitingForResponse = 0)
	{
		To_Device = "AGIN   1\x0D";
		iCommand = ciAuto;
		iWaitingForResponse = 1;
	}
}


CHANGE From_Device
{
	if(iSemaphore = 0)
	{
		iSemaphore = 1;
		while(find("\x0D\x0A", From_Device))
		{
			sFromDeviceTemp = remove("\x0D\x0A", From_Device);



			if(find("OK", sFromDeviceTemp))
			{
				if(iCommand = ciPower)
				{
					Current_Power = iPowerSent;
					if(Current_Power = iPowerQueue)
						iPowerQueue = 0;
				}
				else if(iCommand = ciInput)
				{
					Current_Input = iInputSent;
					if(Current_Input = iInputQueue)
						iInputQueue = 0;
				}
				else if(iCommand = ciAVMode)
				{
					Current_AVMode = iAVModeSent;
					if(Current_AVMode = iAVModeQueue)
						iAVModeQueue = 0;
				}
				else if(iCommand = ciAspect)
				{
					Current_Aspect = iAspectSent;
					if(Current_Aspect = iAspectQueue)
						iAspectQueue = 0;
				}
				else if(iCommand = ciVolumeMute)
				{
					Current_VolumeMute = iVolumeMuteSent;
					if(Current_VolumeMute = iVolumeMuteQueue)
						iVolumeMuteQueue = 0;
				}
				else if(iCommand = ciPIPMode)
				{
					Current_PIPMode = iPIPModeSent;
					if(Current_PIPMode = iPIPModeQueue)
						iPIPModeQueue = 0;
				}
				else if(iCommand = ciPIPSource)
				{
					Current_PIPSource = iPIPSourceSent;
					if(Current_PIPSource = iPIPSourceQueue)
						iPIPSourceQueue = 0;
				}
				else if(iCommand = ciPIPSound)
				{
					Current_PIPSound = iPIPSoundSent;
					if(Current_PIPSound = iPIPSoundQueue)
						iPIPSoundQueue = 0;
				}
				else if(iCommand = ciPIPMainPos)
				{
					Current_PIPMainPos = iPIPMainPosSent;
					if(Current_PIPMainPos = iPIPMainPosQueue)
						iPIPMainPosQueue = 0;
				}
				else if(iCommand = ciPBPSubPos)
				{
					Current_PBPSubPos = iPBPSubPosSent;
					if(Current_PBPSubPos = iPBPSubPosQueue)
						iPBPSubPosQueue = 0;
				}
				else if(iCommand = ciDVISelect)
				{
					Current_DVISelect = iDVISelectSent;
					if(Current_DVISelect = iDVISelectQueue)
						iDVISelectQueue = 0;
				}
				else if(iCommand = ciBNCSelect)
				{
					Current_BNCSelect = iBNCSelectSent;
					if(Current_BNCSelect = iBNCSelectQueue)
						iBNCSelectQueue = 0;
				}
				else if(iCommand = ciHDMISelect)
				{
					Current_HDMISelect = iHDMISelectSent;
					if(Current_HDMISelect = iHDMISelectQueue)
						iHDMISelectQueue = 0;
				}
				else if(iCommand = ciAuto)
						iAutoQueue = 0;
			}					
			else if(find("ERR\x0D\x0A", sFromDeviceTemp) || find("\xFF\xFF\xFF", sFromDeviceTemp))
			{
				if(iCommand = ciPower)
						iPowerQueue = 0;	
				else if(iCommand = ciInput)
						iInputQueue = 0;
				else if(iCommand = ciAVMode)
						iAVModeQueue = 0;
				else if(iCommand = ciAspect)
						iAspectQueue = 0;
				else if(iCommand = ciVolumeMute)
						iVolumeMuteQueue = 0;
				else if(iCommand = ciPIPMode)
						iPIPModeQueue = 0;
				else if(iCommand = ciPIPSource)
						iPIPSourceQueue = 0;
				else if(iCommand = ciPIPSound)
						iPIPSoundQueue = 0;
				else if(iCommand = ciPIPMainPos)
						iPIPMainPosQueue = 0;
				else if(iCommand = ciPBPSubPos)
						iPBPSubPosQueue = 0;
				else if(iCommand = ciDVISelect)
						iDVISelectQueue = 0;
				else if(iCommand = ciBNCSelect)
						iBNCSelectQueue = 0;
				else if(iCommand = ciHDMISelect)
						iHDMISelectQueue = 0;
				else if(iCommand = ciAuto)
						iAutoQueue = 0;
				else if(iCommand = ciPoll)
						iPollQueue = 0;
			}
			else
			{
				iValueIn = atoi(sFromDeviceTemp);
				if(iPollSent = ciPower)
				{
					switch(iValueIn)
					{
						case(1):
							Current_Power = 1;
						case(0):
							Current_Power = 2;
					}
				}
				if(iPollSent = ciInput)
				{
					switch(iValueIn)
					{
						case(1):
							Current_Input = 1;
						case(2):
							Current_Input = 2;
						case(3):
							Current_Input = 3;
						case(4):
							Current_Input = 4;
						case(6):
							Current_Input = 5;
						case(7):
							Current_Input = 6;
						case(8):
							Current_Input = 7;
						case(9):
							Current_Input = 8;
						case(10):
							Current_Input = 9;
					}
				}
				if(iPollSent = ciAVMode)
				{
					switch(iValueIn)
					{
						case(0):
							Current_AVMode = 1;
						case(2):
							Current_AVMode = 2;
						case(3):
							Current_AVMode = 3;
					}	
				}
				if(iPollSent = ciAspect)
				{
					switch(iValueIn)
					{
						case(1):
							Current_Aspect = 1;
						case(2):
							Current_Aspect = 2;
						case(3):
							Current_Aspect = 3;
						case(4):
							Current_Aspect = 4;
						case(5):
							Current_Aspect = 5;
					}
				}
				if(iPollSent = ciVolumeMute)
				{
					switch(iValueIn)
					{
						case(1):
							Current_VolumeMute = 1;
						case(0):
							Current_VolumeMute = 2;
					}	
				}
				if(iPollSent = ciPIPMode)
				{
					switch(iValueIn)
					{
						case(0):
							Current_PIPMode = 1;
						case(1):
							Current_PIPMode = 2;
						case(2):
							Current_PIPMode = 3;
						case(3):
							Current_PIPMode = 4;
					}
				}
				if(iPollSent = ciPIPSource)
				{
					switch(iValueIn)
					{
						case(1):
							Current_PIPSource = 1;
						case(2):
							Current_PIPSource = 2;
						case(3):
							Current_PIPSource = 3;
						case(4):
							Current_PIPSource = 4;
						case(6):
							Current_PIPSource = 5;
						case(7):
							Current_PIPSource = 6;
						case(8):
							Current_PIPSource = 7;
						case(9):
							Current_PIPSource = 8;
						case(10):
							Current_PIPSource = 9;
					}
				}
				if(iPollSent = ciPIPSound)
				{
					switch(iValueIn)
					{
						case(1):
							Current_PIPSound = 1;
						case(2):
							Current_PIPSound = 2;
					}
				}
				if(iPollSent = ciPIPMainPos)
				{
					switch(iValueIn)
					{
						case(0):
							Current_PIPMainPos = 1;
						case(1):
							Current_PIPMainPos = 2;
					}
				}
				if(iPollSent = ciPBPSubPos)
				{
					switch(iValueIn)
					{
						case(1):
							Current_PBPSubPos = 1;
						case(2):
							Current_PBPSubPos = 2;
					}
				}
				if(iPollSent = ciDVISelect)
				{
					switch(iValueIn)
					{
						case(0):
							Current_DVISelect = 1;
						case(1):
							Current_DVISelect = 2;
					}
				}
				if(iPollSent = ciBNCSelect)
				{
					switch(iValueIn)
					{
						case(0):
							Current_BNCSelect = 1;
						case(1):
							Current_BNCSelect = 2;
					}
				}
				if(iPollSent = ciHDMISelect)
				{
					switch(iValueIn)
					{
						case(0):
							Current_HDMISelect = 1;
						case(1):
							Current_HDMISelect = 2;
					}
				}
				if(iPollSent = ciVolume)
				{
					Current_Volume = iValueIn;
				}
				if(iPollSent = ciPIPSize)
				{
					Current_PIPSize = iValueIn;
				}
				if(iPollSent = ciPIPPosH)
				{
					Current_PIPPosH = iValueIn;
				}
				if(iPollSent = ciPIPPosV)
				{
					Current_PIPPosV = iValueIn;
				}
				if(iPollSent = ciPIPBlend)
				{
					Current_PIPBlend = iValueIn;
				}
			}
			if(iWaitingForResponse = 1 && find("WAIT", sFromDeviceTemp) = 0 && (iPowerQueue <> 0 || iInputQueue <> 0 || iAVModeQueue <> 0 || iAspectQueue <> 0 || iVolumeMuteQueue <> 0
										|| iPIPModeQueue <> 0 || iPIPSourceQueue <> 0 || iPIPSoundQueue <> 0 || iPIPMainPosQueue <> 0 || iPBPSubPosQueue <> 0 || iDVISelectQueue <> 0
										|| iBNCSelectQueue <> 0 || iHDMISelectQueue <> 0 || iAutoQueue <> 0 ))
		
			{
				if(iPowerQueue <> 0)
				{
					To_Device = SendPower(iPowerQueue);
				 	iCommand = ciPower;
					iPowerSent = iPowerQueue;
				}
				else if(iInputQueue <> 0)		
				{
					To_Device = SendInput(iInputQueue);
				 	iCommand = ciInput;
					iInputSent = iInputQueue;
				}
				else if(iAVModeQueue <> 0)		
				{
					To_Device = SendAVMode(iAVModeQueue);	   
				 	iCommand = ciAVMode;
					iAVModeSent = iAVModeQueue;
				}
				else if(iAspectQueue <> 0)		
				{
					To_Device = SendAspect(iAspectQueue);	   
				 	iCommand = ciAspect;
					iAspectSent = iAspectQueue;
				}
				else if(iVolumeMuteQueue <> 0)		
				{
					To_Device = SendVolumeMute(iVolumeMuteQueue);	   
				 	iCommand = ciVolumeMute;
					iVolumeMuteSent = iVolumeMuteQueue;
				}
				else if(iPIPModeQueue <> 0)		
				{
					To_Device = SendPIPMode(iPIPModeQueue);	   
				 	iCommand = ciPIPMode;
					iPIPModeSent = iPIPModeQueue;
				}
				else if(iPIPSourceQueue <> 0)		
				{
					To_Device = SendPIPSource(iPIPSourceQueue);	   
				 	iCommand = ciPIPSource;
					iPIPSourceSent = iPIPSourceQueue;
				}
				else if(iPIPSoundQueue <> 0)		
				{
					To_Device = SendPIPSound(iPIPSoundQueue);	   
				 	iCommand = ciPIPSound;
					iPIPSoundSent = iPIPSoundQueue;
				}
				else if(iPIPMainPosQueue <> 0)		
				{
					To_Device = SendPIPMainPos(iPIPMainPosQueue);	   
				 	iCommand = ciPIPMainPos;
					iPIPMainPosSent = iPIPMainPosQueue;
				}	
				else if(iPBPSubPosQueue <> 0)		
				{
					To_Device = SendPBPSubPos(iPBPSubPosQueue);	   
				 	iCommand = ciPBPSubPos;
					iPBPSubPosSent = iPBPSubPosQueue;
				}
				else if(iDVISelectQueue <> 0)		
				{
					To_Device = SendDVISelect(iDVISelectQueue);	   
				 	iCommand = ciDVISelect;
					iDVISelectSent = iDVISelectQueue;
				}
				else if(iBNCSelectQueue <> 0)		
				{
					To_Device = SendBNCSelect(iBNCSelectQueue);	   
				 	iCommand = ciBNCSelect;
					iBNCSelectSent = iBNCSelectQueue;
				}
				else if(iHDMISelectQueue <> 0)		
				{
					To_Device = SendHDMISelect(iHDMISelectQueue);	   
				 	iCommand = ciHDMISelect;
					iHDMISelectSent = iHDMISelectQueue;
				}
				else if(iAutoQueue <> 0)		
				{
					To_Device = "ACHA   1\x0D";
			 	 	iCommand = ciAuto;
				}	
			}
			else
				iWaitingForResponse = 0;
			iPollSent = ciClear;
		}
		iSemaphore = 0;
 	}
}

PUSH Response_Timeout
{
	if(iWaitingForResponse = 1 && (iPowerQueue <> 0 || iInputQueue <> 0 || iAVModeQueue <> 0 || iAspectQueue <> 0 || iVolumeMuteQueue <> 0
								|| iPIPModeQueue <> 0 || iPIPSourceQueue <> 0 || iPIPSoundQueue <> 0 || iPIPMainPosQueue <> 0 || iPBPSubPosQueue <> 0 
								|| iDVISelectQueue <> 0 || iBNCSelectQueue <> 0 || iHDMISelectQueue <> 0 || iAutoQueue <> 0 ))
                                                                                                                                                      
	{
		if(iPowerQueue <> 0)
		{
			To_Device = SendPower(iPowerQueue);
		 	iCommand = ciPower;
			iPowerSent = iPowerQueue;
		}
		else if(iInputQueue <> 0)		
		{
			To_Device = SendInput(iInputQueue);
		 	iCommand = ciInput;
			iInputSent = iInputQueue;
		}
		else if(iAVModeQueue <> 0)		
		{
			To_Device = SendAVMode(iAVModeQueue);	   
		 	iCommand = ciAVMode;
			iAVModeSent = iAVModeQueue;
		}
		else if(iAspectQueue <> 0)		
		{
			To_Device = SendAspect(iAspectQueue);	   
		 	iCommand = ciAspect;
			iAspectSent = iAspectQueue;
		}
		else if(iVolumeMuteQueue <> 0)		
		{
			To_Device = SendVolumeMute(iVolumeMuteQueue);	   
		 	iCommand = ciVolumeMute;
			iVolumeMuteSent = iVolumeMuteQueue;
		}
		else if(iPIPModeQueue <> 0)		
		{
			To_Device = SendPIPMode(iPIPModeQueue);	   
		 	iCommand = ciPIPMode;
			iPIPModeSent = iPIPModeQueue;
		}
		else if(iPIPSourceQueue <> 0)		
		{
			To_Device = SendPIPSource(iPIPSourceQueue);	   
		 	iCommand = ciPIPSource;
			iPIPSourceSent = iPIPSourceQueue;
		}
		else if(iPIPSoundQueue <> 0)		
		{
			To_Device = SendPIPSound(iPIPSoundQueue);	   
		 	iCommand = ciPIPSound;
			iPIPSoundSent = iPIPSoundQueue;
		}
		else if(iPIPMainPosQueue <> 0)		
		{
			To_Device = SendPIPMainPos(iPIPMainPosQueue);	   
		 	iCommand = ciPIPMainPos;
			iPIPMainPosSent = iPIPMainPosQueue;
		}
		else if(iPBPSubPosQueue <> 0)		
		{
			To_Device = SendPBPSubPos(iPBPSubPosQueue);	   
		 	iCommand = ciPBPSubPos;
			iPBPSubPosSent = iPBPSubPosQueue;
		}
		else if(iDVISelectQueue <> 0)		
		{
			To_Device = SendDVISelect(iDVISelectQueue);	   
		 	iCommand = ciDVISelect;
			iDVISelectSent = iDVISelectQueue;
		}
		else if(iBNCSelectQueue <> 0)		
		{
			To_Device = SendBNCSelect(iBNCSelectQueue);	   
		 	iCommand = ciBNCSelect;
			iBNCSelectSent = iBNCSelectQueue;
		}
		else if(iHDMISelectQueue <> 0)		
		{
			To_Device = SendHDMISelect(iHDMISelectQueue);	   
		 	iCommand = ciHDMISelect;
			iHDMISelectSent = iHDMISelectQueue;
		}
		else if(iAutoQueue <> 0)		
		{
			To_Device = "ACHA1   \x0D";
	 	 	iCommand = ciAuto;
		}
	}
	else
		iWaitingForResponse = 0;
	iPollSent = ciClear;
}

/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/

Function Main()
{
	iWaitingForResponse = 0;
	iPowerQueue = 0;
    iInputQueue = 0;
    iAVModeQueue = 0;
    iAspectQueue = 0;
    iVolumeMuteQueue = 0;
    iPIPModeQueue = 0;
    iPIPSourceQueue = 0;
	iPIPSoundQueue = 0;
	iPIPMainPosQueue = 0;
	iPBPSubPosQueue = 0;
	iDVISelectQueue = 0;
	iBNCSelectQueue = 0;
	iHDMISelectQueue = 0;
}



