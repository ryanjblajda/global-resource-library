String_Function SendPower(INTEGER iValue)
{
	switch(iValue)
	{
		case(1):
			sToDeviceTemp = "POWR   1\x0D";	
		case(2):
			sToDeviceTemp = "POWR   0\x0D";
	}
	Return (sToDeviceTemp);
}


