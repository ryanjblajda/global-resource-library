/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
DIGITAL_INPUT _skip_,Enable_Debug,Get_Eth_Status;
DIGITAL_INPUT _skip_, Dhcp_Input;
STRING_INPUT _skip_,Cookie[256];

ANALOG_OUTPUT _skip_, Status;
DIGITAL_OUTPUT _skip_, Use_Dhcp_Output;
STRING_OUTPUT _skip_, Device_Name_Output, State_Output, Mac_Addr_Output, Ip_Addr_Output, Ip_Mask_Output, Gateway_Addr_Output, Dns_Addr_Output, Tx_Speed_Kbps_Output, Rx_Speed_Kbps_Output;

MainProg magewell;

STRING_PARAMETER HostIp[16];

#BEGIN_PARAMETER_PROPERTIES HostIp   
	propValidUnits = unitString;
   	propDefaultUnit = unitString;
   	propDefaultValue = "58.213.29.2:50080";
#END_PARAMETER_PROPERTIES

// INTEGER
// LONG_INTEGER
// SIGNED_INTEGER
// SIGNED_LONG_INTEGER
// STRING

Callback Function EthernetStatusFunc(EthernetStatusArg arg)
{   
    Use_Dhcp_Output = arg.useDhcp;
    Device_Name_Output = arg.deviceName;
    State_Output = arg.state;
    Mac_Addr_Output = arg.macAddr;
    Ip_Addr_Output = arg.ipAddr;
    Ip_Mask_Output = arg.ipMask;
    Gateway_Addr_Output = arg.gatewayAddr;
    Dns_Addr_Output = arg.dnsAddr;
    Tx_Speed_Kbps_Output = arg.txSpeedKbps;
    Rx_Speed_Kbps_Output = arg.rxSpeedKbps;
}

PUSH Dhcp_Input
{
    Use_Dhcp_Output = !Use_Dhcp_Output;
}

PUSH Enable_Debug
{
	magewell.pDebugging = Enable_Debug;
}
PUSH Get_Eth_Status
{
    Status = magewell.sGetEthStatus();
}
CHANGE Cookie
{
    magewell.sSetApiCookie(Cookie);
}

Function Main()
{	
    Delay ( 100 );
	
	magewell.pDebugging = 1;
		
	magewell.pHostIp = HostIp; 

    RegisterDelegate ( magewell,  EthernetStatusCallBack, EthernetStatusFunc );
}

