/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
DIGITAL_INPUT _skip_,Enable_Debug,Get_Video_Format;
STRING_INPUT _skip_,Cookie[256];

ANALOG_OUTPUT _skip_, Status;
STRING_OUTPUT _skip_, Color_Format_Output, Quant_Range_Output; 

MainProg magewell;

STRING_PARAMETER HostIp[16];

#BEGIN_PARAMETER_PROPERTIES HostIp   
	propValidUnits = unitString;
   	propDefaultUnit = unitString;
   	propDefaultValue = "58.213.29.2:50080";
#END_PARAMETER_PROPERTIES

// INTEGER
// LONG_INTEGER
// SIGNED_INTEGER
// SIGNED_LONG_INTEGER
// STRING

Callback Function VideoFormatFunc(VideoFormatArg arg)
{   
    Color_Format_Output = arg.colorFormat;
    Quant_Range_Output = arg.quantRange;
}

PUSH Enable_Debug
{
	magewell.pDebugging = Enable_Debug;
}
PUSH Get_Video_Format
{
    Status = magewell.sGetVideoFormat();
}
CHANGE Cookie
{
    magewell.sSetApiCookie(Cookie);
}

Function Main()
{	
    Delay ( 100 );
	
	magewell.pDebugging = 1;
		
	magewell.pHostIp = HostIp; 

    RegisterDelegate ( magewell,  VideoFormatCallBack, VideoFormatFunc );
}

