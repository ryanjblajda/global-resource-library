/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
DIGITAL_INPUT _skip_,Enable_Debug,Set_Audio_Config;
STRING_INPUT _skip_, Gain_Input[64], SampleRate_Input[64];
ANALOG_INPUT _skip_, Channels_Input, Ch0_Input, Ch1_Input, Ch2_Input, Ch3_Input, Ch4_Input, Ch5_Input, Ch6_Input, Ch7_Input, Ch8_Input, Ch9_Input, Ch10_Input, Ch11_Input, Ch12_Input, Ch13_Input, Ch14_Input, Ch15_Input;
DIGITAL_INPUT _skip_, Check_Pts_Input;
STRING_INPUT _skip_,Cookie[256];

ANALOG_OUTPUT _skip_, Status;

MainProg magewell;

STRING_PARAMETER HostIp[16];

#BEGIN_PARAMETER_PROPERTIES HostIp   
	propValidUnits = unitString;
   	propDefaultUnit = unitString;
   	propDefaultValue = "58.213.29.2:50080";
#END_PARAMETER_PROPERTIES

// INTEGER
// LONG_INTEGER
// SIGNED_INTEGER
// SIGNED_LONG_INTEGER
// STRING

PUSH Enable_Debug
{
	magewell.pDebugging = Enable_Debug;
}
PUSH Set_Audio_Config
{
    Status = magewell.sSetAudioConfig(Gain_Input, SampleRate_Input, Channels_Input, Ch0_Input, Ch1_Input, Ch2_Input, Ch3_Input, Ch4_Input, Ch5_Input, Ch6_Input, Ch7_Input, Ch8_Input, Ch9_Input, Ch10_Input, Ch11_Input, Ch12_Input, Ch13_Input, Ch14_Input, Ch15_Input, Check_Pts_Input);
}
CHANGE Cookie
{
    magewell.sSetApiCookie(Cookie);
}

Function Main()
{	
    Delay ( 100 );
	
	magewell.pDebugging = 1;
		
	magewell.pHostIp = HostIp; 
}

