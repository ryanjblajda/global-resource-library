/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
DIGITAL_INPUT _skip_,Enable_Debug,Get_NDI_Sources;
DIGITAL_INPUT _skip_,Set_NDI_Source_By_Index[150,150];
// ANALOG_INPUT 
STRING_INPUT _skip_,Cookie[256];
STRING_INPUT _skip_,Set_NDI_Source[256];
// BUFFER_INPUT 

// DIGITAL_OUTPUT 
// ANALOG_OUTPUT 
DIGITAL_OUTPUT _skip_,NDI_Source_Selected[150], _skip_, NDI_Source_Visible[150,150];
ANALOG_OUTPUT _skip_,Status;
ANALOG_OUTPUT NDI_SourceList_Count;
STRING_OUTPUT _skip_,NDI_Source_Name[150],_skip_,NDI_Source_IP[150,150];

MainProg magewell;

STRING_PARAMETER HostIp[16];

#BEGIN_PARAMETER_PROPERTIES HostIp   
	propValidUnits = unitString;
   	propDefaultUnit = unitString;
   	propDefaultValue = "58.213.29.2:50080";
#END_PARAMETER_PROPERTIES

// INTEGER
// LONG_INTEGER
// SIGNED_INTEGER
// SIGNED_LONG_INTEGER
// STRING

Callback Function NdiListFunction(NdiSourcesArg arg)
{
	integer i, sourceCount; 
    sourceCount = arg.GetSourceCount(); 
    NDI_SourceList_Count = arg.GetSourceCount();
	for(i=1 to 150)
   	{
        if(i-1<sourceCount)
        {
    		NDI_Source_Name[i] = arg.GetNdiName(i-1);
    		NDI_Source_IP[i] = arg.GetNdiIpAddr(i-1);
        }
        else
        {
		    NDI_Source_Name[i] = "";
	    	NDI_Source_IP[i] = "";
        }
	}
}
                
PUSH Enable_Debug
{
	magewell.pDebugging = Enable_Debug;
}
         
PUSH Get_NDI_Sources
{
    integer i;
	Status = magewell.sGetNdiSources();
    Status = magewell.sGetChannel();
    if(Status=0)
	{
        for(i=1 to 150)
	    {
            if(i-1<NDI_SourceList_Count)
            {
                NDI_Source_Visible[i] = 1;
            }
            else
            {
                NDI_Source_Visible[i] = 0;
            }
            if(i-1<NDI_SourceList_Count && magewell.sIsNdiSourceSelected(i-1)>0)
            {
                NDI_Source_Selected[i] = 1;
            }
            else
            {
        	    NDI_Source_Selected[i] = 0;
            }
        }
   	}
    else
    {
        for(i=1 to 150)
	    { 
            NDI_Source_Visible[i] = 0;
      	    NDI_Source_Selected[i] = 0;
        }
    }
}
                        
PUSH Set_NDI_Source_By_Index
{
    integer i;
    Status = magewell.sSetChannelByIndex(GetLastModifiedArrayIndex()-1, 1);
    if(Status=0)
    {
        Status = magewell.sGetChannel();
	    if(Status=0)
	    {
            for(i=1 to 150)
	        {
                if(i-1<NDI_SourceList_Count && magewell.sIsNdiSourceSelected(i-1)>0)
                {
                    NDI_Source_Selected[i] = 1;
                }
                else
                {
            	    NDI_Source_Selected[i] = 0;
                }
            }
   	    }
        else
        { 
   	        for(i=1 to 150)
	        { 
                NDI_Source_Visible[i] = 0;
      	        NDI_Source_Selected[i] = 0;
            }
        }
    }
}

CHANGE Cookie
{
    magewell.sSetApiCookie(Cookie);
}
 
CHANGE Set_NDI_Source
{
    integer i;
	Status = magewell.sSetChannel(Set_NDI_Source, 1);
    if(Status=0)
    {
        Status = magewell.sGetChannel();
	    if(Status=0)
	    {
            for(i=1 to 150)
	        {
                if(i-1<NDI_SourceList_Count && magewell.sIsNdiSourceSelected(i-1)>0)
                {
                    NDI_Source_Selected[i] = 1;
                }
                else
                {
            	    NDI_Source_Selected[i] = 0;
                }
            }
  	    }
        else
        {
   	        for(i=1 to 150)
   	        { 
                NDI_Source_Visible[i] = 0;
      	        NDI_Source_Selected[i] = 0;
            }
        }
    }
}

Function Main()
{
    integer i, ret;
    integer pageStartIndex;
	Delay ( 100 );
	
	magewell.pDebugging = 1;
		
	magewell.pHostIp = HostIp;	

	RegisterDelegate ( magewell , NdiListCallBack , NdiListFunction ); 

    while(1)
    {
    	ret = magewell.sGetNdiSources();
        ret = magewell.sGetChannel();
	    if(ret=0)
	    {	
            for(i=1 to 150)
	        {
                if(i-1<NDI_SourceList_Count)
                {
                    NDI_Source_Visible[i] = 1;
                }
                else
                {
                    NDI_Source_Visible[i] = 0;
                }
                if(i-1<NDI_SourceList_Count && magewell.sIsNdiSourceSelected(i-1)>0)
                {
                    NDI_Source_Selected[i] = 1;
                }
                else
                {
            	    NDI_Source_Selected[i] = 0;
                }
            }
 	    }
        else
        { 
   	        for(i=1 to 150)
	        { 
                NDI_Source_Visible[i] = 0;
      	        NDI_Source_Selected[i] = 0;
            }
        }
    	Delay ( 100 );
    }
}
