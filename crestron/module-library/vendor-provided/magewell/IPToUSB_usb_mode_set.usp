#SYMBOL_NAME "IPToUSB_usb_mode_set"

#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

#USER_SIMPLSHARP_LIBRARY "IPToUSB"
//INPUT
DIGITAL_INPUT usb_mode_set_Push;
STRING_INPUT HostIp[16],Cookie[256];

//OUTPUT
STRING_OUTPUT usb_mode_set_message_output,usb_mode_set_code_output;
ANALOG_OUTPUT usb_mode_set_status_output;
STRING_INPUT usb_mode_input[32];


//MainProg is C# class name
MainProg magewell;

PUSH usb_mode_set_Push
{                      
	usb_mode_set_status_output = magewell.usb_mode_set(usb_mode_input);
	usb_mode_set_code_output = magewell.GetCode();
    usb_mode_set_message_output = magewell.GetMessage();
}
CHANGE Cookie
{
    magewell.sSetApiCookie(Cookie);
}
CHANGE HostIp
{
    magewell.SetHostIp(HostIp);
}

Function Main()
{	
    Delay ( 100 );//ms 100
}

