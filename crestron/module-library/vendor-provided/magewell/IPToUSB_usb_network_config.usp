#SYMBOL_NAME "IPToUSB_usb_network_config"

#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

#USER_SIMPLSHARP_LIBRARY "IPToUSB"
//INPUT
DIGITAL_INPUT usb_network_config_Push;
STRING_INPUT HostIp[16],Cookie[256];

//OUTPUT
STRING_OUTPUT usb_network_config_message_output,usb_network_config_code_output;
ANALOG_OUTPUT usb_network_config_status_output;

STRING_INPUT iface[32], ipaddr[32];

//MainProg is C# class name
MainProg magewell;

PUSH usb_network_config_Push
{                      
	usb_network_config_status_output = magewell.usb_network_config( iface , ipaddr);
	usb_network_config_code_output = magewell.GetCode();
    usb_network_config_message_output = magewell.GetMessage();
}
CHANGE Cookie
{
    magewell.sSetApiCookie(Cookie);
}
CHANGE HostIp
{
    magewell.SetHostIp(HostIp);
}

Function Main()
{	
    Delay ( 100 );//ms 100
}

