/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
DIGITAL_INPUT _skip_,Enable_Debug,Set_Video_Config_OSD, Set_Video_Config_Process, Set_Video_Config_Source, Set_Video_Config_Follow_Input;
DIGITAL_INPUT _skip_,Show_Title_Input, Show_Tally_Input, Show_Vu_Meter_Input, Show_Center_Cross_Input, H_Flip_Input, V_Flip_Input, In_Auto_Color_Fmt_Input, Follow_Input_Mode_Input;
STRING_INPUT Vu_Meter_Mode_Input[256], Safe_Area_Mode_Input[256], Ident_Mode_Input[256], Ident_Text_Input[256], Deinterlace_Mode_Input[256], Ar_Convert_Mode_Input[256], Alpha_Disp_Mode_Input[256], In_Color_Fmt_Input[256], Switch_Mode_Input[256];

STRING_INPUT _skip_,Cookie[256];

ANALOG_OUTPUT _skip_,Status;

MainProg magewell;

STRING_PARAMETER HostIp[16];

#BEGIN_PARAMETER_PROPERTIES HostIp   
	propValidUnits = unitString;
   	propDefaultUnit = unitString;
   	propDefaultValue = "58.213.29.2:50080";
#END_PARAMETER_PROPERTIES

// INTEGER
// LONG_INTEGER
// SIGNED_INTEGER
// SIGNED_LONG_INTEGER
// STRING

PUSH Enable_Debug
{
	magewell.pDebugging = Enable_Debug;
}
PUSH Set_Video_Config_OSD
{
    Status = magewell.sSetVideoConfigOSD(Show_Title_Input, Show_Tally_Input, Show_Vu_Meter_Input, Vu_Meter_Mode_Input, Show_Center_Cross_Input, Safe_Area_Mode_Input, Ident_Mode_Input, Ident_Text_Input);
}
 
PUSH Set_Video_Config_Process
{
	Status = magewell.sSetVideoConfigProcess(H_Flip_Input, V_Flip_Input, Deinterlace_Mode_Input, Ar_Convert_Mode_Input, Alpha_Disp_Mode_Input);
}

PUSH Set_Video_Config_Source
{
	Status = magewell.sSetVideoConfigSource(In_Auto_Color_Fmt_Input, In_Color_Fmt_Input, Switch_Mode_Input);
}

PUSH Set_Video_Config_Follow_Input
{
    Status = magewell.sSetVideoConfigFollowInput(Follow_Input_Mode_Input);
}

CHANGE Cookie
{
    magewell.sSetApiCookie(Cookie);
}

Function Main()
{	
    Delay ( 100 );
	
	magewell.pDebugging = 1;
		
	magewell.pHostIp = HostIp;
}

