CHANGE Cookie
{
    magewell.sSetApiCookie(Cookie);
}
 
CHANGE Set_Channel
{
    integer i;
	Status = magewell.sSetChannel(Set_Channel, 0);
    if(Status=0)
    {
        Status = magewell.sGetChannel();
	    if(Status=0)
	    {
            for(i=1 to 150)
            {
                if(i-1<SourceList_Count && magewell.sIsChannelSelected(i-1)>0)
                {
        	        Channel_Selected[i] = 1;
                }
                else
                {
        	        Channel_Selected[i] = 0;
                }
            }
 	    }
        else
        { 
   	        for(i=1 to 150)
    	    { 
                Channel_Visible[i] = 0;
          	    Channel_Selected[i] = 0;
            }
        }
    }
}

Function Main()
{
    integer i, ret;
    integer pageStartIndex;
	Delay ( 100 );
	
	magewell.pDebugging = 1;
		
	magewell.pHostIp = HostIp;	

	RegisterDelegate ( magewell , SourcePresetCallBack , SourcePresetFunction ); 

    while(1)
    {    
        //Reset the channel list.
	    ret = magewell.sListChannels();
        ret = magewell.sGetChannel();
        if(ret=0)
    	{
   	        for(i=1 to 150)
   	        {
                if(i-1<SourceList_Count)
                {
                    Channel_Visible[i] = 1;
                }
                else
                {
                    Channel_Visible[i] = 0;
                }
                if(i-1<SourceList_Count && magewell.sIsChannelSelected(i-1)>0)
                {
        	        Channel_Selected[i] = 1;
                }
                else
                {
        	        Channel_Selected[i] = 0;
                }
            }
      	}
        else
        {
   	        for(i=1 to 150)
   	        { 
                Channel_Visible[i] = 0;
      	        Channel_Selected[i] = 0;
            }
        }
       	Delay ( 100 );
    }
}
