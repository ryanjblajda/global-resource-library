/*******************************************************************************************
  Include Libraries
  (Uncomment and include additional libraries as needed)
*******************************************************************************************/
// #CRESTRON_LIBRARY ""
// #USER_LIBRARY ""
#User_SimplSharp_Library "SecureTCPLibrary"
/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
DIGITAL_INPUT Connect; 
ANALOG_INPUT TcpPort; 
STRING_INPUT IpAddress[30],_skip_,_skip_,TX$[1000];
// BUFFER_INPUT 

DIGITAL_OUTPUT Connected_Fb; 
ANALOG_OUTPUT TcpStatus_Fb;
STRING_OUTPUT _skip_,_skip_,_skip_,RX$; 
                    
Connection myClient;
/*******************************************************************************************
  Global Variables
  (Uncomment and declare global variables as needed)
  Note:  Be sure to initialize all declared STRING variables as needed
         For example, in Function Main: myString = "";
*******************************************************************************************/
INTEGER giTcpPort,RetryCount,giTCPConnectedFB,giStatus;
// LONG_INTEGER
// SIGNED_INTEGER
// SIGNED_LONG_INTEGER
STRING gsIpAddress[30];

/*******************************************************************************************
  Functions
  (Add any additional functions here)
  Note:  Functions must be physically placed before the location in
         the code that calls them.
*******************************************************************************************/
Function TryToReconnect()
{
	Do
	{
		wait(1000,RetryWait)
		{
			myClient.StartConnection(gsIpAddress,giTcpPort);
			RetryCount = RetryCount + 1;			
		}
	}
	Until(RetryCount = 3 || giStatus = 2);
}

CallBack Function TcpRxDelegate(String data)
{	
	RX$ = data;                                           
} 

Callback Function TcpStatusDelegate(integer status)
{
	giStatus = status;  
	TcpStatus_Fb = giStatus;
	
	If(status != 2)
	{            
	    giTCPConnectedFB = 0;
		Connected_Fb = giTCPConnectedFB;
		
		Wait(500,TryToReconnectWait)
		{      
			RetryCount = 0;
			TryToReconnect();
		}
	}
	Else
	{   
		giTCPConnectedFB = 1;   
		Connected_Fb = giTCPConnectedFB; 
		CancelWait(TryToReconnectWait);
		CancelWait(RetryWait);
	}                                                     
}

/*******************************************************************************************
  Event Handlers
  (Uncomment and declare additional event handlers as needed)
*******************************************************************************************/
Push Connect
{     
	myClient.StartConnection(gsIpAddress,giTcpPort);        
}                              

Release Connect
{
	MyClient.CloseConnection();
}

Threadsafe Change TcpPort
{
	giTcpPort = TcpPort;	
}                       

Threadsafe Change IpAddress
{
	gsIpAddress = IpAddress;
}   

Threadsafe Change TX$
{
	String temp[1000];
	
	temp = TX$;
	
	MyClient.SendDataToClient(temp);	
}

/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/

Function Main()
{   
	WaitForInitializationComplete();
    
    RegisterDelegate(MyClient,ReceivedData,TcpRxDelegate);
    RegisterDelegate(MyClient,TCPStatus,TcpStatusDelegate);
}


