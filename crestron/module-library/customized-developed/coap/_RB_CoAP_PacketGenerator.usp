/*** Compiler Directives ****/

// #ENABLE_DYNAMIC
#SYMBOL_NAME "CoAP Packet Generator"
#HINT ""
// #DEFINE_CONSTANT
#CATEGORY "46" "RBLAJDA" // Custom
// #PRINT_TO_TRACE
// #DIGITAL_EXPAND 
// #ANALOG_SERIAL_EXPAND 
// #OUTPUT_SHIFT 
// #HELP_PDF_FILE ""
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE
#DEFINE_CONSTANT MAXITEMS 255
#ANALOG_SERIAL_EXPAND InputsWithOutputs
// #ENCODING_ASCII
// #ENCODING_UTF16
// #ENCODING_INHERIT_FROM_PARENT
// #ENCODING_INHERIT_FROM_PROGRAM


#HELP_BEGIN
#HELP_END

//INPUTS
DIGITAL_INPUT _SKIP_, _SKIP_, Send;
ANALOG_INPUT _SKIP_, Packet_ID_High_Byte, Packet_ID_Low_Byte, Payload;

//PARAMETERS
STRING_PARAMETER Packet_Header[50];
STRING_PARAMETER Packet_Options[50];

//OUTPUTS
#OUTPUT_SHIFT 2
STRING_OUTPUT Generated_Packet;

/* GLOBAL VARIABLES */

/*** Event Handlers ***/
PUSH Send
{
	makestring(Generated_Packet, "%s%s%s%s%x", Packet_Header, chr(Packet_ID_High_Byte), chr(Packet_ID_Low_Byte), Packet_Options, Payload);
}

/*** Main() ***/