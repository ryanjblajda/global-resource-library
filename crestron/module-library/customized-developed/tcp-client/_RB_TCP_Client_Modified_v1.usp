/*******************************************************************************************
  Global Variables
  (Uncomment and declare global variables as needed)
  Note:  Be sure to initialize all declared STRING variables as needed
         For example, in Function Main: myString = "";
*******************************************************************************************/
INTEGER connected;
// LONG_INTEGER
// SIGNED_INTEGER
// SIGNED_LONG_INTEGER
// STRING
           
Function DoConnect()
{
	Signed_Integer ret;

	If ((Len(IP_Address$) = 0) || (Port_Number = 0))
		Return;

	if (tcpClient.SocketStatus = 2)
	{
		// let's disconnect
		ret = SocketDisconnectClient(tcpClient);
		if (ret < 0)
			Print("Error disconnecting socket to address %s on port %d", IP_Address$, Port_Number);
	}
	// now try to connect to the new address
    ret = SocketConnectClient(tcpClient, IP_Address$, Port_Number, 1);

    if (ret < 0)
        Print("Error connecting socket to address %s on port  %d", IP_Address$, Port_Number);
	status = tcpClient.SocketStatus;
}

/*******************************************************************************************
  Event Handlers
  (Uncomment and declare additional event handlers as needed)
*******************************************************************************************/

PUSH Connect
{
	DoConnect();
}

RELEASE Connect
{
    SIGNED_INTEGER ret;

	ret = SocketDisconnectClient(tcpClient);
	if (ret < 0)
		Print("Error disconnecting socket to address %s on port %d", IP_Address$, Port_Number);
	status = tcpClient.SocketStatus;
}
      
CHANGE IP_Address$
{
	If (Connect)
		DoConnect();
}

CHANGE Port_NUmber
{
	If (Connect)
		DoConnect();
}

THREADSAFE CHANGE TX$
{
    signed_integer ret;
	integer length;
   	string buf[256];
         
	If (!connected || (tcpClient.SocketStatus <> 2))
	{
		ClearBuffer(TX$);
		TerminateEvent;
    }

	WHILE (LEN(TX$) > 0)
	{
		try
		{
			length = LEN(TX$);
			if (length > 256)
				length = 256;
			buf = RemoveByLength(length, TX$);			
		    ret = SocketSend(tcpClient, buf);
		    if (ret < 0)
        		Print("Error Sending to MyClient: %d\n", ret);  
		}
		catch
		{
		}
	}
}

SOCKETCONNECT tcpClient
{
	SIGNED_LONG_INTEGER PortNumber;
    SIGNED_INTEGER LocalStatus;
    STRING RemoteIPAddress[20];
    STRING RequestedAddress[256];
    
    ConnectF = 1;
	connected = 1;
    LocalStatus = SocketGetAddressAsRequested(tcpClient, RequestedAddress);
    if (LocalStatus < 0)
        Print("Error getting remote ip address. %d\n", LocalStatus);
    PortNumber = SocketGetPortNumber(tcpClient);
    if (PortNumber < 0)
        Print("Error getting client port number. %ld\n", PortNumber);        
    LocalStatus = SocketGetRemoteIPAddress(tcpClient, RemoteIPAddress);
    if (LocalStatus < 0)
        Print("Error getting remote ip address. %d\n", LocalStatus);
	if (verbose)
	    Print("OnConnect: Connected to port %ld on address %s\n", PortNumber, RemoteIPAddress);
}

SOCKETDISCONNECT tcpClient
{
	ConnectF = 0;
	connected = 0;
	if (verbose)
	{
    	if (Connect)
        	Print("Socket disconnected remotely");
	    Else
    	    Print("Local disconnect complete.");
	}
}

SOCKETRECEIVE tcpClient
{
	integer length;
	String str[1536];

	RX$ = tcpClient.SocketRxBuf;
	ClearBuffer(tcpClient.SocketRxBuf);               
}

SOCKETSTATUS tcpClient
{
    SIGNED_INTEGER ret;

    ret = SocketGetStatus();
/*	if (ret = 6 || ret = 7)
	{
		if (connected)
			status = 2;
		else
			status = ret;
	}
	else
*/
	    status = ret;
}

