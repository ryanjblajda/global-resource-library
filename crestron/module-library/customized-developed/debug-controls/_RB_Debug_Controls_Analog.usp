/*** COMPILER DIRECTIVES ****/
#SYMBOL_NAME "Debug Signal [ANALOG] Module v1"
#HINT "creates debug values and allows production values"
#CATEGORY "46" "RBLAJDA" // Custom
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE
#DEFINE_CONSTANT MAX_ITEMS 48
#DEFINE_CONSTANT MAX_STRING_LENGTH 255

#HELP_BEGIN
#HELP_END

/*** INPUTS ***/
DIGITAL_INPUT ENABLE_DEBUG_MODE, _SKIP_;
//DIGITAL_INPUT PRODUCTION_STATE[MAX_ITEMS, MAX_ITEMS];
ANALOG_INPUT  PRODUCTION_VALUE[MAX_ITEMS];
//STRING_INPUT  PRODUCTION_STRING[MAX_ITEMS][MAX_STRING_LENGTH];

/*** OUTPUTS ***/
//DIGITAL_OUTPUT _SKIP_, _SKIP_, LIVE_STATE[MAX_ITEMS, MAX_ITEMS];
ANALOG_OUTPUT _SKIP_, _SKIP_, LIVE_VALUE[MAX_ITEMS];
//STRING_OUTPUT LIVE_STRING[MAX_ITEMS];

/*** PARAMETERS ***/
//INTEGER_PARAMETER _SKIP_, _SKIP_, DEBUG_STATE[MAX_ITEMS];
INTEGER_PARAMETER _SKIP_, _SKIP_, DEBUG_VALUE[MAX_ITEMS];
//STRING_PARAMETER  DEBUG_STRING[MAX_ITEMS][MAX_STRING_LENGTH];
/*
#BEGIN_PARAMETER_PROPERTIES DEBUG_STATE
	propValidUnits=unitDecimal;
	propDefaultUnit=unitDecimal;
	propDefaultValue=1d;
	propList= {1d, "True"}, {0d, "False"};
	propShortDescription= "the debug value for this digital signal";                       
#END_PARAMETER_PROPERTIES
*/
#BEGIN_PARAMETER_PROPERTIES DEBUG_VALUE
	propValidUnits=unitDecimal;
	propDefaultUnit=unitDecimal;
	propShortDescription= "the debug value for this analog signal";   
#END_PARAMETER_PROPERTIES
/*
#BEGIN_PARAMETER_PROPERTIES DEBUG_STRING
	propValidUnits=unitString;
	propDefaultUnit=unitString;
	propShortDescription= "the debug value for this serial signal";   
#END_PARAMETER_PROPERTIES
*/
/*** GLOBAL VARIABLES ***/
STRING PRODUCTION_STRINGS[MAX_ITEMS][MAX_STRING_LENGTH];

/*** FUNCTIONS ***/
FUNCTION ON_PRODUCTION_MODE() {
	INTEGER I;
	FOR (I = 1 TO MAX_ITEMS) {
//		LIVE_STRING[I] = PRODUCTION_STRINGS[I];
		LIVE_VALUE[I]  = PRODUCTION_VALUE[I];
//		LIVE_STATE[I]  = PRODUCTION_STATE[I];
	}
}

FUNCTION ON_DEBUG_MODE() {
	INTEGER I; 	
	FOR (I = 1 TO MAX_ITEMS) {
//    	LIVE_STRING[I] = DEBUG_STRING[I];
		LIVE_VALUE[I]  = DEBUG_VALUE[I];
//		LIVE_STATE[I]  = DEBUG_STATE[I];
	}
}

/*** EVENT HANDLERS ***/
CHANGE ENABLE_DEBUG_MODE {
	IF (ENABLE_DEBUG_MODE = ON) { ON_DEBUG_MODE(); }
	ELSE { ON_PRODUCTION_MODE(); }
}
/*
CHANGE PRODUCTION_STRING {
	INTEGER INDEX;
	INDEX = GETLASTMODIFIEDARRAYINDEX();
	
	PRODUCTION_STRINGS[INDEX] = PRODUCTION_STRING[INDEX];
	
	IF (ENABLE_DEBUG_MODE = OFF) {
		LIVE_STRING[INDEX] = PRODUCTION_STRINGS[INDEX];
	}
}
*/
CHANGE PRODUCTION_VALUE {
	INTEGER INDEX;
	INDEX = GETLASTMODIFIEDARRAYINDEX();
    
	IF (ENABLE_DEBUG_MODE = OFF) {
		LIVE_VALUE[INDEX] = PRODUCTION_VALUE[INDEX];
	}
}
/*
CHANGE PRODUCTION_STATE {
	INTEGER INDEX;
	INDEX = GETLASTMODIFIEDARRAYINDEX();

	IF (ENABLE_DEBUG_MODE = OFF) {
		LIVE_STATE[INDEX] = PRODUCTION_STATE[INDEX];
	}
}
*/