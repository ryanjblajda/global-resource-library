/* Compiler Directives */

//#ENABLE_DYNAMIC
#SYMBOL_NAME "Dynamic Progress"
#HINT "generates a dynamic progress bar based on a digital high/low time"
#CATEGORY "46" "RBLAJDA" // Custom
#PRINT_TO_TRACE
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE
#DEFINE_CONSTANT ciPulseLength 10
#DEFINE_CONSTANT ciDebug ON

#HELP_BEGIN
PARAMETERS:
Feedback_Type: Use Percent or Use Time (see progress meter description below)

INPUTS

In_Progress: determines the time that will be used by the ramp

OUTPUTS

Progress_Meter: a value to denote progress, either 0-100% for either cooling or warming progress, or it will denote the seconds left until the action (either warming or cooling) is complete.

	NOTE: this value is calculated by the actual time it takes the device to warm up or cool down. the time for warming will be equal to warming time + the source correction wait time.  

Is_Busy: this signal will be high while Progress_Meter is ramping
#HELP_END

//INPUTS
DIGITAL_INPUT In_Progress;
//OUTPUTS
DIGITAL_OUTPUT Is_Busy;
ANALOG_OUTPUT  Progress_Meter;

//PARAMETERS

INTEGER_PARAMETER Feedback_Type;

//INTEGER_PARAMETER Endpoint_Type;

#BEGIN_PARAMETER_PROPERTIES Feedback_Type
	propDefaultValue = 1d;
	propList = {1d, "Use Percent"}, {2d, "Use Time"};
	propValidUnits = UnitDecimal;
#END_PARAMETER_PROPERTIES

//VARIABLES

INTEGER Progress_Time;
STRING  _start[10], _end[10];

//FUNCTIONS
INTEGER_FUNCTION ElapsedTime(string _startTime, string _endTime)
{
	integer _endTimeHour, _startTimeHour;
	integer _endTimeMin,  _startTimeMin;
	integer _endTimeSec,  _startTimeSec; 
	integer _hourRemainder, _minRemainder, _secRemainder;
	integer _result;

	/*----------------------------------------*/
	_endTimeHour   = atoi(LEFT(_endTime, 	2));
	_startTimeHour = atoi(LEFT(_startTime,	2));
	_hourRemainder = _endTimeHour - _startTimeHour; //get the elapsed amount of hours
	_hourRemainder = _hourRemainder * 3600; 		//convert to seconds

	/*----------------------------------------*/	
	_endTimeMin    = atoi(MID(_endTime,   4, 2));	
	_startTimeMin  = atoi(MID(_startTime, 4, 2));	
	_minRemainder  = _endTimeMin - _startTimeMin;   //get elapsed amount of minutes
	_minRemainder  = _minRemainder * 60;            //convert to seconds

	/*----------------------------------------*/	
	_endTimeSec    = atoi(RIGHT(_endTime,	2));	
	_startTimeSec  = atoi(RIGHT(_startTime,	2));	                                                    
	_secRemainder  = _endTimeSec - _startTimeSec;	//get elapsed amount of seconds	
	_result = _hourRemainder + _minRemainder + _secRemainder;
                    
	//print("Total Seconds, %u", _result);
	return(_result);
}

//EVENT HANDLERS
PUSH In_Progress
{
	RAMP_INFO progress;

	//for ui stuffs
	Is_Busy = ON;

	//store the current time
	_start = time();

	//begin ramping process based on previous warming time, on startup, this will be instant.
	progress.rampTransitionTime = Progress_Time * 100;
    progress.rampIsAbsolute = 1;

	if(Feedback_Type = 1)
	{	
		progress.rampBaseValue   = 0;
		progress.rampTargetValue = 65535;
	}
	else if(Feedback_Type = 2)
	{
		progress.rampBaseValue   = Progress_Time;
		progress.rampTargetValue = 0;		
	} 
	//stop any ramping operations in progress
	if(isRamping(Progress_Meter)) stopRamp(Progress_Meter);
    //create a new ramp for the warming progress.
	createRamp(Progress_Meter, progress);
}

RELEASE In_Progress
{
	integer _time;
	//for ui stuffs
	Is_Busy = OFF;
	//store the current time
	_end = time();
	//calculate the time it took for the projector to warm.
	_time = elapsedTime(_start, _end);

	Progress_Time = _time;
}
