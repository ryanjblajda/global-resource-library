// #ENABLE_DYNAMIC
#SYMBOL_NAME "nLight Checksum v1"
#HINT "Takes Analog Inputs and Creates an Analog Value of the Checksum"
#CATEGORY "46" "RBLAJDA_PROCESSOR" // Custom
#PRINT_TO_TRACE
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE
#DEFINE_CONSTANT MAXITEMS 255

ANALOG_INPUT Input_[MAXITEMS];

DIGITAL_OUTPUT SendCommand;
ANALOG_OUTPUT Checksum_Byte_1, Checksum_Byte_2;

INTEGER definedInputs;

CHANGE Input_ {
	integer checkSum;
	integer checkSumInverted;
	integer i;

	checkSum = 0;

	for(i = 1 to MAXITEMS) {
		if(isSignalDefined(Input_[i])) {
			checkSum = checkSum ^ Input_[i];
		}
		processLogic();
	}
    
    checkSumInverted = not(checksum);
    trace("Checksum: %d | %x", checkSumInverted, checkSumInverted); 
	Checksum_Byte_1 = checkSumInverted >> 8;
	Checksum_Byte_2 = checkSumInverted && 0x00FF;

	wait(10) 
	{
		pulse(10, SendCommand);
	}
}

Function Main()
{
	integer i;
	waitForInitializationComplete();
    for(i = 1 to MAXITEMS) {
		if(isSignalDefined(Input_[i])) {
			definedInputs = i;
		}
		processLogic();
	}

	//print("defined inputs: %D", definedInputs);
}
