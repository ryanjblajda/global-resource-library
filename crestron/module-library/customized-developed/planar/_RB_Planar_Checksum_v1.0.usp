// #ENABLE_DYNAMIC
#SYMBOL_NAME "Exclusive OR Analog Checksum v1"
#HINT "Takes Analog Inputs and Creates an Analog Value of the Checksum"
#CATEGORY "46" "RBLAJDA_PROCESSOR" // Custom
// #DEFINE_CONSTANT
// #CATEGORY "" 
#PRINT_TO_TRACE
// #DIGITAL_EXPAND 
// #ANALOG_SERIAL_EXPAND 
// #OUTPUT_SHIFT 
// #HELP_PDF_FILE ""
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE
#DEFINE_CONSTANT MAXITEMS 255

ANALOG_INPUT Input_[MAXITEMS];

DIGITAL_OUTPUT SendCommand;
ANALOG_OUTPUT checkSumValue;

INTEGER definedInputs;

CHANGE Input_ {
	integer checkSum;
	integer i;
	integer activeInput;

	checkSum = 0;

	for(i = 1 to MAXITEMS) {
		if(isSignalDefined(Input_[i])) {
			activeInput = Input_[i];
			checkSum = checkSum ^ activeInput;
		}
		processLogic();
	}

	checkSumValue = checkSum;
	wait(10) 
	{
		pulse(10, SendCommand);
	}
}

Function Main()
{
	integer i;
	waitForInitializationComplete();
    for(i = 1 to MAXITEMS) {
		if(isSignalDefined(Input_[i])) {
			definedInputs = i;
		}
		processLogic();
	}

	//print("defined inputs: %D", definedInputs);
}
