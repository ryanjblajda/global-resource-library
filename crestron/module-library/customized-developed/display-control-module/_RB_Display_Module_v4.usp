/* Compiler Directives */

//#ENABLE_DYNAMIC
#SYMBOL_NAME "Display/Projector Power & Screen Control v4"
#HINT "handles all things display related"
#CATEGORY "46" "RBLAJDA" // Custom
#PRINT_TO_TRACE
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE
#DEFINE_CONSTANT ciPulseLength 10
#DEFINE_CONSTANT ciScreenPulse 50
#DEFINE_CONSTANT ciDebug OFF
#DEFINE_CONSTANT ciPowerOnRequest  1
#DEFINE_CONSTANT ciPowerOffRequest 2
#DEFINE_CONSTANT csPowerOn  "On"
#DEFINE_CONSTANT csPowerOff "Off"
#DEFINE_CONSTANT csWarming  "Warming"
#DEFINE_CONSTANT csCooling  "Cooling"

#HELP_BEGIN
PARAMETERS:
Feedback_Type: Use Percent or Use Time (see progress meter description below)
Source_Correction_Wait_Time: The time to wait after the display has finished warming to send an input command to try and correct the input if it is incorrect. 

INPUTS
Correct_Input_Fb: tie this to the correct feedback for the source you want the display to be on.
Warming_Fb: tie this into a warming fb from a projector
Cooling_Fb: tie this into a cooling fb from a projector 

Power_On/Off_Press: tie this into a dedicated PowerOn/Off button from a touchpanel (eliminates the need for an OR symbol and makes things cleaner)

Power_On/Off_Fb: tie this to the feedback from whatever display/projector module you are using.

Display_Source: tie this to the source selection from the touchpanel, not FB from a video switcher (this wont always change on source selection so the display/projector wont fire on)

OUTPUTS

Progress_Meter: a value to denote progress, either 0-100% for either cooling or warming progress, or it will denote the seconds left until the action (either warming or cooling) is complete.

	NOTE: this value is calculated by the actual time it takes the device to warm up or cool down. the time for warming will be equal to warming time + the source correction wait time.  

Is_Busy: this signal will be high while Progress_Meter is ramping

Correct_Input: tie this to the input you wish to set.
	NOTE: if Warming_Fb is defined, this will fire 5s after Warming_Fb goes low. If Warming_Fb is not defined, it will fire 5s after Power_On_Fb goes high.

Screen_Up/Down: these will fire when warming starts, and when cooling is finished to raise the screen.

Power_On/Off: these should be connected to the inputs on the display/projector module.

#HELP_END

//INPUTS

DIGITAL_INPUT _SKIP_, _SKIP_, _SKIP_, _SKIP_, Room_Power_Off;
DIGITAL_INPUT _SKIP_, Correct_Input_Fb, _SKIP_, Screen_Up_Press, Screen_Down_Press, Screen_Stop_Press, Screen_Toggle_Press, _SKIP_, Power_On_Press, Power_Off_Press, Power_Toggle_Press, _SKIP_, Power_On_Fb, Power_Off_Fb, _SKIP_, Warming_Fb, Cooling_Fb;
ANALOG_INPUT  _SKIP_, Display_Source;
STRING_INPUT  _SKIP_,  Display_Name[255];

//OUTPUTS
#OUTPUT_SHIFT  6
DIGITAL_OUTPUT Correct_Input, _SKIP_, Screen_Up, Screen_Down, _SKIP_, _SKIP_, _SKIP_, Power_On, Power_Off;
DIGITAL_OUTPUT _SKIP_, _SKIP_, Power_On_Fb_OS, Power_Off_Fb_OS, _SKIP_;
DIGITAL_OUTPUT In_Use, _SKIP_, Is_Busy;
ANALOG_OUTPUT  Progress_Meter;
STRING_OUTPUT  Progress_Feedback;

//PARAMETERS

INTEGER_PARAMETER Feedback_Type, Source_Correction_Wait_Time, Use_Warming_Cooling_Fb, Power_Off_Using_Zero_Source;

//INTEGER_PARAMETER Endpoint_Type;

#BEGIN_PARAMETER_PROPERTIES Feedback_Type
	propDefaultValue = 1d;
	propList = {1d, "Use Percent"}, {2d, "Use Time"};
	propValidUnits = UnitDecimal;
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Source_Correction_Wait_Time
	propBounds = 1s, 20s;
	propDefaultValue = 5s;
	propValidUnits = UnitTime;
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Use_Warming_Cooling_Fb
	propDefaultValue = 0d;
	propList = {1d, "Yes"}, {0d, "No"};
	propValidUnits = UnitDecimal;
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Power_Off_Using_Zero_Source
	propDefaultValue = 0d;
	propList = {1d, "Yes"}, {0d, "No"};
	propValidUnits = UnitDecimal;
#END_PARAMETER_PROPERTIES

//VARIABLES

INTEGER Warming_Time, Cooling_Time, PowerActionRequest, gi_ScreenDown;
STRING  _warmStart[10], _warmEnd[10], _coolStart[10], _coolEnd[10], gs_DisplayName[255];

//FUNCTIONS
FUNCTION CheckUsage() 
{
	if (Power_On_Fb = ON) {
		if (Display_Source = OFF) { In_Use = OFF; }
		else { In_Use = On; }
	}
	else { In_Use = OFF; }
}

INTEGER_FUNCTION ElapsedTime(string _startTime, string _endTime)
{
	integer _endTimeHour, _startTimeHour;
	integer _endTimeMin,  _startTimeMin;
	integer _endTimeSec,  _startTimeSec; 
	integer _hourRemainder, _minRemainder, _secRemainder;
	integer _result;

	/*----------------------------------------*/
	_endTimeHour   = atoi(LEFT(_endTime, 	2));
	_startTimeHour = atoi(LEFT(_startTime,	2));
	_hourRemainder = _endTimeHour - _startTimeHour; //get the elapsed amount of hours
	_hourRemainder = _hourRemainder * 3600; 		//convert to seconds

	/*----------------------------------------*/	
	_endTimeMin    = atoi(MID(_endTime,   4, 2));	
	_startTimeMin  = atoi(MID(_startTime, 4, 2));	
	_minRemainder  = _endTimeMin - _startTimeMin;   //get elapsed amount of minutes
	_minRemainder  = _minRemainder * 60;            //convert to seconds

	/*----------------------------------------*/	
	_endTimeSec    = atoi(RIGHT(_endTime,	2));	
	_startTimeSec  = atoi(RIGHT(_startTime,	2));	                                                    
	_secRemainder  = _endTimeSec - _startTimeSec;	//get elapsed amount of seconds	
	_result = _hourRemainder + _minRemainder + _secRemainder;
                    
	//print("Total Seconds, %u", _result);
	return(_result);
}

FUNCTION DeviceProgressUpdate(string state)
{
	makestring(Progress_Feedback, "%s is %s", gs_DisplayName, state);
}

FUNCTION PowerRequestCheck()
{
	switch(PowerActionRequest)
	{
		case(ciPowerOnRequest):
		{
			print("Power On via Request");
			pulse(ciPulseLength, Power_On);
		}
		case(ciPowerOffRequest):
		{
			print("Power Off via Request");
			pulse(ciPulseLength, Power_Off);
		}
	}

	PowerActionRequest = OFF;
}

FUNCTION ScreenStop()
{
	pulse(ciScreenPulse, Screen_Up);
	pulse(ciScreenPulse, Screen_Down);
	gi_ScreenDown = OFF;
}

FUNCTION CheckCorrectSource()
{
	wait(Source_Correction_Wait_Time) {
		if(Correct_Input_Fb = OFF && Power_On_Fb = ON) pulse(ciPulseLength, Correct_Input);		
	}
}

FUNCTION ScreenUp()
{
	pulse(ciScreenPulse, Screen_Up);
	gi_ScreenDown = OFF;
}

FUNCTION ScreenDown()
{
	pulse(ciScreenPulse, Screen_Down);
	gi_ScreenDown = ON;
}

FUNCTION ScreenToggle()
{
	if(gi_ScreenDown = ON) ScreenUp();
	else ScreenDown();
}


FUNCTION PowerOff()
{
	pulse(ciPulseLength, Power_Off);
	ScreenUp();
}

FUNCTION PowerOn()
{
	pulse(ciPulseLength, Power_On);
	ScreenDown();
}

FUNCTION CheckPowerOff()
{
	if(Warming_Fb = ON) {
		print("Power Off Requested While Warming");
		PowerActionRequest = ciPowerOffRequest;
	}
	else PowerOff();
}

FUNCTION CheckPowerOn()
{
	if(Cooling_Fb = ON)
	{	
		print("Power On Requested While Cooling");
		PowerActionRequest = ciPowerOnRequest;
	}
	else PowerOn();
}

FUNCTION PowerToggle()
{
	if(Power_On_Fb = ON) PowerOff();
	else PowerOn();
}

FUNCTION Main()
{
	if(ciDebug = ON)
	{
		print("%u", Source_Correction_Wait_Time);
	}

	gi_ScreenDown = OFF;
}

//EVENT HANDLERS
PUSH Room_Power_Off
{
	if(Use_Warming_Cooling_Fb = ON) 
	{
		CheckPowerOff();		
	}
	else PowerOff();
}

CHANGE Display_Name
{
	gs_DisplayName = Display_Name;

	if(Warming_Fb = ON || Cooling_Fb = ON) 
	{
		if(Warming_Fb = ON) DeviceProgressUpdate(csWarming);
		else if(Cooling_Fb = ON) DeviceProgressUpdate(csCooling);
	}
	else if(Power_On_Fb = ON) DeviceProgressUpdate(csPowerOn);
	else if(Power_Off_Fb = ON) DeviceProgressUpdate(csPowerOff);
}

CHANGE Display_Source
{
	CheckUsage();

	if(Display_Source <> OFF) 
	{
		//if we are using warming/cooling fb check if the device is warming or cooling before taking action
		if(Use_Warming_Cooling_Fb = ON) CheckPowerOn();
		//if not, try and power on the display
		else PowerOn();
	}
	else
	{
		if(Power_Off_Using_Zero_Source = ON)
		{
			//if we are using warming/cooling fb check if the device is warming or cooling before taking action
			if(Use_Warming_Cooling_Fb = ON) CheckPowerOff();
			//if not check the fb state as we dont need to turn off a display thats already off
			else 
			{
				if(Power_On_Fb = ON) PowerOff();
			}
		}
	}
}

PUSH Power_Off_Press
{
	if(Use_Warming_Cooling_Fb = ON) CheckPowerOff();
	else PowerOff();
}

PUSH Power_On_Press
{
	if(Use_Warming_Cooling_Fb = ON) CheckPowerOn();
	else PowerOn();
}

PUSH Power_Toggle_Press
{
	PowerToggle();
}

PUSH Screen_Toggle_Press
{
	ScreenToggle();	
}

PUSH Screen_Up_Press
{
	ScreenUp();
}

PUSH Screen_Down_Press
{
	ScreenDown();	
}

PUSH Screen_Stop_Press
{
	ScreenStop();
}

PUSH Warming_Fb
{
	RAMP_INFO progress;

	//for ui stuffs
	Is_Busy = ON;
	DeviceProgressUpdate(csWarming);

	//store the current time
	_warmStart = time();

	//begin ramping process based on previous warming time, on startup, this will be instant.
	progress.rampTransitionTime = Warming_Time * 100;
    progress.rampIsAbsolute = 1;

	if(Feedback_Type = 1)
	{	
		progress.rampBaseValue   = 0;
		progress.rampTargetValue = 65535;
	}
	else if(Feedback_Type = 2)
	{
		progress.rampBaseValue   = Warming_Time;
		progress.rampTargetValue = 0;		
	}
 	
	//stop any ramping operations in progress
	if(isRamping(Progress_Meter)) stopRamp(Progress_Meter);
    //create a new ramp for the warming progress.
	createRamp(Progress_Meter, progress);
}

RELEASE Warming_Fb {
	integer _warmingTime;
	//for ui stuffs
	Is_Busy = OFF;
	//store the current time
	_warmEnd = time();
	//calculate the time it took for the projector to warm.
	_warmingTime = elapsedTime(_warmStart, _warmEnd);

	Warming_Time = (Source_Correction_Wait_Time / 100) + _warmingTime;

	if(ciDebug = ON) {
		print("%d = %d + %d", Warming_Time, (Source_Correction_Wait_Time / 100), _warmingTime);
	}

	if(Power_On_Fb = ON) DeviceProgressUpdate(csPowerOn);
	else if(Power_Off_Fb = ON) DeviceProgressUpdate(csPowerOff);
    
	CheckCorrectSource();
	PowerRequestCheck();
}

PUSH Cooling_Fb
{
	RAMP_INFO progress;
	//for ui stuffs
    Is_Busy = ON;

	DeviceProgressUpdate(csCooling);

	//store the current time
	_coolStart = time();
	//begin ramping process based on previous cooling time, on startup, this will be instant.
	progress.rampTransitionTime = Cooling_Time * 100;
	progress.rampIsAbsolute = 1;

	if(Feedback_Type = 1)
	{	
		progress.rampBaseValue   = 0;
		progress.rampTargetValue = 65535;
	}
	else if(Feedback_Type = 2)
	{
		progress.rampBaseValue   = Cooling_Time;
		progress.rampTargetValue = 0;		
	}
		
	if(isRamping(Progress_Meter)) stopRamp(Progress_Meter);
	createRamp(Progress_Meter, progress);
}

RELEASE Cooling_Fb
{
	//for ui stuffs
	Is_Busy = OFF;
    
	//store the current time
	_coolEnd = time();
	//calculate the time it took for the projector to cool.
	Cooling_Time = elapsedTime(_coolStart, _coolEnd);
    
	if(Power_On_Fb = ON) DeviceProgressUpdate(csPowerOn);
	else if(Power_Off_Fb = ON) DeviceProgressUpdate(csPowerOff);
	PowerRequestCheck();
}

PUSH Power_On_Fb
{
	CheckUsage();
	DeviceProgressUpdate(csPowerOn);
	CheckCorrectSource();
	pulse(ciScreenPulse, Power_On_Fb_OS);	
}

PUSH Power_Off_Fb
{
	CheckUsage();
	DeviceProgressUpdate(csPowerOff);
	pulse(ciScreenPulse, Power_Off_Fb_OS);
}

RELEASE Correct_Input_Fb
{
	CheckCorrectSource();
}
