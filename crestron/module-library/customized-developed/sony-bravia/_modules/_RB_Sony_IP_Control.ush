[BEGIN]
  ObjTp=Hd
  Cmn1=general notes\\	you must enable SIMPL IP control, and control with||1
  Cmn2=the preshared key on the display, and match said preshared key to||1
  Cmn3=what is used in the program. \\	to open a specific app, install||1
  Cmn4=it on the display, then go to the app store and get the path shown||1
  Cmn5=i.e. appspace.app.com.appspace.app.MainActivity, 	\\	you must add||1
  Cmn6=this < com.sony.dtv.com. > as a prefix to the path, and then send||1
  Cmn7=that into the app_url_to_open\\\\parameters\\	Poll_Time: time in||1
  Cmn8=seconds that you want to poll the display for status\\\\inputs\\
  Cmn9=	debug - prints out debug info\\	poll_enable - enables polling every||1
  Cmn10=Poll_Time seconds [drive this from something useful...not a 1]\\
  Cmn11=\\	power_on: pulse to power on display\\	power_off: pulse to power||1
  Cmn12=off display\\	power_toggle: pulse to toggle power based on current||1
  Cmn13=feedback status\\\\	volume_up: pulse to raise volume level\\	volume_down:
  Cmn14=||1pulse to lower volume level\\	volume_mute_toggle: pulse to toggle||1
  Cmn15=mute based on current feedback status\\	volume_mute_on: pulse to||1
  Cmn16=turn on volume mute\\	volume_mute_off: pulse to turn off volume||1
  Cmn17=mute\\\\	picture_mute_toggle: pulse to toggle mute based on current||1
  Cmn18=feedback status\\	picture_mute_on: pulse to turn on picture mute\\
  Cmn19=	picture_mute_off: pulse to turn off picture mute\\\\	volume_level:
  Cmn20=||1set volume level from 0-65535\\	\\	input_select: set to the input||1
  Cmn21=you desire\\		1 = hdmi 1, 2 = hdmi 2, 3 = hdmi 4, 4 = hdmi 4\\		
  Cmn22=5 = component 1, 6 = component 2, 7 = component 3, 8 = component||1
  Cmn23=4\\		9 = scart 1, 10 = scart 2, 11 = scart 3, 12 = scart 4\\		note:
  Cmn24=||1not all input are available on all tvs\\\\    transport_action:
  Cmn25=||1this emulates the remote\\		1 = up, 2 = down, 3 = left, 4 = right,||1
  Cmn26=5 = select, 6 = home, 7 = options, 8 = back, 9 = play, 10 = pause\\
  Cmn27=	\\	app_url_to_open: see the general notes above, but this is the||1
  Cmn28=url of an app installed on the display you want to open\\\\	ip_address:
  Cmn29=||1the ip address of the display you want to control, pull it from||1
  Cmn30=a config file or hardcode it, its up to you\\\\	preshared_key: this||1
  Cmn31=must match the pre-shared key set on the display for certain features||1
  Cmn32=to work, just like the ip_address, pull it from a config file, or||1
  Cmn33=hard-code it....up to you.\\\\outputs\\	power_on_fb: display power||1
  Cmn34=is on when high\\	volume_mute_fb: volume is muted when high\\	picture_mute_fb:
  Cmn35=||1picture is muted when high\\	volume_level_fb: the volume level||1
  Cmn36=of the device from 0-65535, yes i scaled it for you because im not||1
  Cmn37=a heathen.\\	input_selected_fb: the live status, values match input||1
  Cmn38=select \\		[no feedback for whether an app is open..unfortunately||1
  Cmn39=API doesnt give you that]\\
[END]
