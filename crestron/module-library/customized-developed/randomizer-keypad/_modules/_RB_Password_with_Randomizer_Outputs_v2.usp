/**COMPILER DIRECTIVES**/

#SYMBOL_NAME "Random Keypad Passcode Handler"
#HINT "randomizes keypad entry"
#CATEGORY "46" "RBLAJDA-C#" 
#PRINT_TO_TRACE
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

#HELP_BEGIN
#HELP_END

/**LIBRARIES**/
#USER_SIMPLSHARP_LIBRARY "RandomizerKeypad"           

/**INPUTS**/
DIGITAL_INPUT Digit_Key_Delete;
DIGITAL_INPUT Digit_Key_Clear;
DIGITAL_INPUT Digit_Key_Submit, _SKIP_, _SKIP_;
DIGITAL_INPUT Digit_Key_Press[10];
STRING_INPUT  User_Passcode[256];

/**OUTPUTS**/
DIGITAL_OUTPUT Passcode_Submit_Success;
DIGITAL_OUTPUT Passcode_Submit_Failure;
STRING_OUTPUT  Passcode_Masked;
STRING_OUTPUT  Passcode_Real;
STRING_OUTPUT  _SKIP_;
STRING_OUTPUT  Digit_Key_Text[10];

/**GLOBAL VARIABLES**/
Keypad thisKeypad;

/**FUNCTIONS**/
FUNCTION Main()
{
	WaitForInitializationComplete();
	RegisterEvent(thisKeypad, PasscodeRealChanged,  OnPasscodeRealChanged);
	RegisterEvent(thisKeypad, PasscodeMaskChanged,  OnPasscodeMaskChanged);
	RegisterEvent(thisKeypad, PasscodeEntryFailure, OnPasscodeEntryFailure);
	RegisterEvent(thisKeypad, PasscodeEntrySuccess, OnPasscodeEntrySuccess);
	RegisterEvent(thisKeypad, RandomizeComplete,    OnRandomizeComplete);
    
	thisKeypad.Initialize();
}

/** EVENT HANDLERS **/
EVENTHANDLER OnPasscodeRealChanged(Keypad sender, StringEventArgs args)
{
	Passcode_Real = args.Payload;
}

EVENTHANDLER OnPasscodeMaskChanged(Keypad sender, StringEventArgs args)
{
	Passcode_Masked = args.Payload;
}
        
EVENTHANDLER OnPasscodeEntryFailure(Keypad sender, DigitalEventArgs args)
{
	Passcode_Submit_Failure = args.Payload;
}

EVENTHANDLER OnPasscodeEntrySuccess(Keypad sender, DigitalEventArgs args)
{
	Passcode_Submit_Success = args.Payload;
}

EVENTHANDLER OnRandomizeComplete(Keypad sender, StringArrayEventArgs args)
{
	integer i;

	for (i = 0 to args.PayloadLength - 1)
	{
		Digit_Key_Text[i + 1] = args.Payload[i];
	} 
}

CHANGE User_Passcode
{
	thisKeypad.Passcode = User_Passcode;
}

PUSH Digit_Key_Press
{
	integer iChanged;
	iChanged = GetLastModifiedArrayIndex();
	thisKeypad.KeyPress(iChanged);
}

PUSH Digit_Key_Delete
{
	thisKeypad.Delete();
}

PUSH Digit_Key_Clear
{
	thisKeypad.Clear();
}

PUSH Digit_Key_Submit
{
	thisKeypad.SubmitPasscode();
}
