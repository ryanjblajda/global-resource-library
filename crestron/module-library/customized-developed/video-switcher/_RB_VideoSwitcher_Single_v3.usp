/* Compiler Directives */

//#ENABLE_DYNAMIC
#SYMBOL_NAME "Video Switcher Single v3"
#HINT "a single output for smaller systems"

#CATEGORY "46" "RBLAJDA" // Custom
#PRINT_TO_TRACE
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE
//#DEFINE_CONSTANT DEBUG  0
#DEFINE_CONSTANT c_MaxChar 65534
#DEFINE_CONSTANT c_Max 8
//INPUTS
STRING_INPUT No_Source_Message[c_MaxChar];
ANALOG_INPUT _SKIP_, Selected_Source, _SKIP_, Output_Fb, _SKIP_, _SKIP_, _SKIP_, _SKIP_, _SKIP_, _SKIP_;

ANALOG_INPUT Source_Is_Input[c_Max], _SKIP_; 
STRING_INPUT Source_Name$[c_Max][c_MaxChar], _SKIP_, Source_Help_Text$[c_Max][c_MaxChar];

//OUTPUTS
#OUTPUT_SHIFT 2
ANALOG_OUTPUT Selected_Source_Fb, _SKIP_, Output_To_Input, _SKIP_;
STRING_OUTPUT Output_Active_Source$, Output_Active_Source_Help_Text$, _SKIP_;
ANALOG_OUTPUT Available_Sources;

//PARAMETERS
//INTEGER_PARAMETER Source_Is_Input[c_Max];

//VARIABLES

integer feedbackArray[c_Max];
string  gsSourceNames[c_Max][c_MaxChar], gsNoSource[c_MaxChar], gsSourceHelpText[c_Max][c_MaxChar];
signed_integer giAvailableSources;
integer giDefinedSources;  
//FUNCTIONS


integer_function checkString(string _string) {
	integer functionResult;
	functionResult = 0;
	if(_string <> "") {
		functionResult = 1;
	}
	return(functionResult);
}
    
integer_function countSources()
{
	integer i;
	integer count;
	integer result;

	for(i = 1 to giDefinedSources)//count all non-empty strings to build source list.
	{
		if(isSignalDefined(Source_Name$[i])) {

			result = checkString(gsSourceNames[i]);

			if(result = 1) {

				count = count + result;
                #IF_DEFINED ciDebug
					print("%s Not Empty, Count is %d", gsSourceNames[i], count);
				#ENDIF
			}
		}
		processLogic();
	}

	return(count);
}

//EVENT HANDLERS
CHANGE No_Source_Message
{
	gsNoSource = No_Source_Message;
}

CHANGE Source_Is_Input 
{
	integer iChanged;
	iChanged = getLastModifiedArrayIndex();

	if(Source_Is_Input[iChanged] <> 0)
	{
		feedbackArray[Source_Is_Input[iChanged]] = iChanged;
	}

	Available_Sources = CountSources();
}

CHANGE Selected_Source 
{
	//if the selected source is not zero, pass the change to value
	if(Selected_Source <> 0){
		Output_To_Input      = Source_Is_Input[Selected_Source];
		Output_Active_Source$ = gsSourceNames[Selected_Source];
		Output_Active_Source_Help_Text$ = gsSourceHelpText[Selected_Source];
	}
	else
	{
		Selected_Source_Fb  = Selected_Source;
		Output_Active_Source$ = gsNoSource; 
		Output_Active_Source_Help_Text$ = "Select a source to begin";
	}
}

CHANGE Output_Fb
{
	//if value is not zero, pass the change to value to correct the feedback
	if(Output_Fb <> 0)
	{
		Output_Active_Source$ = gsSourceNames[feedbackArray[Output_Fb]];
		Selected_Source_Fb   = feedbackArray[Output_Fb];		
	}
	else if(Output_Fb = 0)
	{
		Selected_Source_Fb   = 0;
		Output_Active_Source$ = gsNoSource;
		Output_Active_Source_Help_Text$ =  "Select A Source To Begin...";
	}
}

CHANGE Source_Name$
{
	integer iChanged, iTempResult;
	iChanged = getLastModifiedArrayIndex();
	gsSourceNames[iChanged] = Source_Name$[iChanged];
	
	Available_Sources = CountSources();
}

CHANGE Source_Help_Text$
{
	integer iChanged, iTempResult;
	iChanged = getLastModifiedArrayIndex();
	gsSourceHelpText[iChanged] = Source_Help_Text$[iChanged];
}

FUNCTION Main()
{
	integer i;
	waitForInitializationComplete();

	for(i = c_Max to 1 step - 1)
	{
		if(isSignalDefined(Source_Name$[i]))
		{	
			giDefinedSources = i;
			break;
		}
	}
	
	for(i = 1 to c_Max)//build feedback array
	{
		if(Source_Is_Input[i] <> 0)
		{
			feedbackArray[Source_Is_Input[i]] = i;
		}
	}
}
