FUNCTION HandleSingularResponse(string response) {
	string responseType;
	print("Evertz | Response: %s", response);
	
	responseType = mid(response, 0, 2, 1);
	CheckReplyType(
}

CALLBACK GatherEventHandler OnGatherResponse(GatherEventArgs args) {
	if (args.RESULTS = 0) {	
		Print("Evertz | Valid Response");
		//re-arm the event handler
		RearmGatherAsync(args.INPUT);

		HandleSingularResponse(args.RxString);
	}
	else {
		Print("Evertz | Gather Timeout");
	}
}

/*** EVENT HANDLERS ***/
CHANGE device_rx {
	integer result;
	string resultString[50];

	if(find(gsCarriageReturn, device_rx) <> 0) {
		#IF_DEFINED DEBUG
			print("Evertz | Found End Of Message");
		#ENDIF

		result = GatherAsync("\x0D", device_rx, OnGatherResponse);

		#IF_DEFINED DEBUG
			if (result = 0) { resultString = "Success"; }
			else if (result = -1) { resultString = "Issue with Parameter"; }
			else if (result = 1) { resultString = "Success"; }
			else { resultString = "Error"; }
			print("Evertz | GatherAsync Result: %s", resultString);
		#ENDIF

	}
	else {
		#IF_DEFINED DEBUG
			print("Evertz | No End Of Message Found");
		#ENDIF
	}
}
