[BEGIN]
  ObjTp=Hd
  Cmn1=INPUTS\\\\Filter_Number: a number that will be compared against||1
  Cmn2=the Filter_List parameter for each input\\\\Item_IsDefined: a digital||1
  Cmn3=signal representing whether the item has been "defined" \\\\OUTPUTS\\
  Cmn4=Item_IsVisible: when the Filter_Number value exists in the Filter_List||1
  Cmn5=for this item, AND Item_IsDefined is HIGH for the associated input,||1
  Cmn6=it will be high.\\\\PARAMETERS\\\\Filter_List: a list of Filter_Number||1
  Cmn7=values in which an Item_IsDefined input should be allowed to propogate||1
  Cmn8=to its associated Item_IsVisible output.
[END]
