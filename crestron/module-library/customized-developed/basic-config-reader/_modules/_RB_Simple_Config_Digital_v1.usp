/**COMPILER DIRECTIVES**/

#SYMBOL_NAME "JSON Config File [Digital Data]"
#HINT "reads string data in from a json config file"
#CATEGORY "46" "RBLAJDA-C#" 
#PRINT_TO_TRACE
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE
#ENABLE_DYNAMIC
#DEFINE_CONSTANT ciMaxStringLength 100
#DEFINE_CONSTANT ciMaxItems 64

#HELP_BEGIN
#HELP_END

/**LIBRARIES**/
#USER_SIMPLSHARP_LIBRARY "BasicConfigReader"

/**INPUTS**/
DIGITAL_INPUT _SKIP_, Refresh, Enable_Auto_Refresh;
ANALOG_INPUT Auto_Refresh_Time_Seconds;

/**OUTPUTS**/
#OUTPUT_SHIFT 1
DIGITAL_OUTPUT File_Load_Success_Fb, _SKIP_, _SKIP_;
DIGITAL_OUTPUT  Value_For_Digital_Item[ciMaxItems]; 

/**PARAMETERS**/
STRING_PARAMETER ConfigFile[ciMaxStringLength], _SKIP_, _SKIP_, _SKIP_;
//STRING_PARAMETER Digital_Items[ciMaxItems];
//STRING_PARAMETER Analog_Items[ciMaxItems];
STRING_PARAMETER Digital_Item[ciMaxItems][ciMaxStringLength];

/**GLOBAL VARIABLES**/
ConfigReader thisReader;

/**FUNCTIONS**/
FUNCTION Main()
{
	integer i;

	WaitForInitializationComplete();
	
	thisReader.FilePath = ConfigFile;

	RegisterDelegate(thisReader, Complete, OnComplete);
	//RegisterDelegate(thisReader, UpdateStringItem, OnUpdateStringItem);
	//RegisterDelegate(thisReader, UpdateAnalogItem, OnUpdateAnalogItem);
	RegisterDelegate(thisReader, UpdateDigitalItem, OnUpdateDigitalItem);

	for(i = 1 to ciMaxItems)
	{
		if(Digital_Item[i] <> "") { thisReader.AddItem(i, Digital_Item[i], 1); } 
	}
}

CALLBACK FUNCTION OnComplete(integer result)
{
	File_Load_Success_Fb = result;
}

CALLBACK FUNCTION OnUpdateDigitalItem(integer output, signed_integer value)
{
	Value_For_Digital_Item[output] = value;
}

/**EVENT HANDLERS**/

PUSH Refresh
{
	SetArray(Value_For_Digital_Item, 0);
	thisReader.Refresh(ConfigFile);
}

CHANGE Enable_Auto_Refresh
{
	thisReader.EnablePeriodicRefresh(Enable_Auto_Refresh, Auto_Refresh_Time_Seconds);
}
