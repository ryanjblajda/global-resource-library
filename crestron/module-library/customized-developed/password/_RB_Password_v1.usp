/**COMPILER DIRECTIVES**/

#SYMBOL_NAME "Password Module v1"
#HINT "simple hardcoded password module"
#CATEGORY "46" "RBLAJDA" 
#PRINT_TO_TRACE
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE
#DEFINE_CONSTANT ciBufferSize 1024
#DEFINE_CONSTANT csAsterisk   "*"

#HELP_BEGIN
#HELP_END

/**LIBRARIES**/

/**INPUTS**/

DIGITAL_INPUT _SKIP_, _SKIP_, Submit_Password, Key_Delete, Key_Clear;
DIGITAL_INPUT Key_0;
DIGITAL_INPUT Key_[9];
STRING_INPUT  Password_String[ciBufferSize];

STRING_PARAMETER  User_Password[ciBufferSize], Backdoor_Password[ciBufferSize];
INTEGER_PARAMETER Notify_Time;

#BEGIN_PARAMETER_PROPERTIES Notify_Time
propValidUnits = unitTime;
propDefaultUnit = unitTime;
propBounds=1s, 5s;
propDefaultValue = 1s;
propShortDescription = "the time the Password Incorrect notice will be displayed for";
#END_PARAMETER_PROPERTIES

/**OUTPUTS**/
#OUTPUT_SHIFT  2
DIGITAL_OUTPUT Password_Correct, Password_Wrong;
STRING_OUTPUT  Masked_Password, Raw_Password;

/**GLOBAL VARIABLES**/
STRING gsPassword[ciBufferSize];

/**FUNCTIONS**/
function generateMask(string password)
{
	integer i;
    string temp[ciBufferSize];

	for(i = 1 to len(password))
	{
		temp = temp + csAsterisk;
	}

	Masked_Password = temp;
}

/**EVENT HANDLERS**/
PUSH Key_Clear
{
	gsPassword = "";
	Raw_Password = gsPassword;
	Masked_Password = gsPassword;
}

PUSH Key_Delete
{
	gsPassword = left(gsPassword, (len(gsPassword) - 1));
	Raw_Password = gsPassword;
	generateMask(gsPassword);
}

PUSH Key_0
{
	gsPassword = gsPassword + itoa(0);
	Raw_Password = gsPassword;
	generateMask(gsPassword);
}

PUSH Key_
{
	INTEGER iChanged;
	iChanged = getLastModifiedArrayIndex();
	gsPassword = gsPassword + itoa(iChanged);
	Raw_Password = gsPassword;
	generateMask(gsPassword);
}

CHANGE Password_String
{
	gsPassword = Password_String;
	Raw_Password = gsPassword;
	generateMask(gsPassword);
}

PUSH Submit_Password
{
	if(gsPassword = User_Password || gsPassword = Backdoor_Password)
	{
		pulse(Notify_Time, Password_Correct);
	}
	else
	{
		pulse(Notify_Time, Password_Wrong);
	}
	
	gsPassword = "";
	Masked_Password = gsPassword;
	Raw_Password = gsPassword;
}
