/**COMPILER DIRECTIVES**/
#SYMBOL_NAME "Selected Source Router"
#HINT "simple point source handler"
#CATEGORY "46" "RBLAJDA" 
#PRINT_TO_TRACE
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE
#DEFINE_CONSTANT ciMaxSources 24
#DEFINE_CONSTANT ciBufferSize 1024
#DIGITAL_EXPAND InputsWithOutputs

#HELP_BEGIN
#HELP_END

/**LIBRARIES**/

/**INPUTS**/
ANALOG_INPUT Selected_Source;
DIGITAL_INPUT Selected_Output_[64];

/**OUTPUTS**/
ANALOG_OUTPUT Selected_Source_For_Output_[64];

PUSH Selected_Output_
{
	INTEGER iChanged;
	iChanged = getLastModifiedArrayIndex();

	Selected_Source_For_Output_[iChanged] = Selected_Source; //route selected source to touched
}

CHANGE Selected_Source 
{
	INTEGER i;
	
	for(i = 1 to 64)
	{
		if(Selected_Output_[i] = ON)
		{
			Selected_Source_For_Output_[i] = Selected_Source;
		}
	}
}
